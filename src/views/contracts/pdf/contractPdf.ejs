<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <title>Rengøringskontrakt</title>
    <style>
        * { box-sizing: border-box; }

        body {
            font-family: Calibri, Arial, sans-serif;
            font-size: 11pt;
            line-height: 1.5;
            color: #1a1a1a;
            margin: 0;
        }

        h1 {
            font-size: 16pt;
            text-align: center;
            margin: 0 0 16pt;
        }

        h2 {
            font-size: 13pt;
            margin: 0 0 6pt;
        }

        p { margin: 0 0 10pt; }

        .section { margin-bottom: 18pt; }

        hr {
            border: none;
            border-top: 1px solid #ccc;
            margin: 14pt 0;
        }

        ul {
            margin: 4pt 0 10pt;
            padding-left: 16pt;
        }

        li { margin-bottom: 4pt; }

        .parties {
            display: flex;
            flex-direction: column;
            gap: 10pt;
            margin-bottom: 4pt;
        }

        .parties div div { margin-bottom: 1pt; }

        .price-figure { font-weight: bold; }

        .signature-block {
            display: flex;
            justify-content: space-between;
            gap: 20pt;
            margin: 24pt 0;
            break-inside: avoid;
        }

        .signature-block > div { flex: 1 1 50%; }

        .signature-date {
            margin-bottom: 24pt;
            color: #555;
        }

        .signature-line {
            margin-top: 24pt;
            border-top: 1px solid #000;
            padding-top: 5pt;
        }

        .signoff { break-inside: avoid; }

        .signoff strong { display: block; }
    </style>
</head>
<body>

<h1>Rengøringskontrakt</h1>

<!-- PARTER -->
<div class="section">
    <h2>Kontraktens parter</h2>

    <div class="parties">
        <div>
            <strong>Leverandør:</strong>
            <div>Service Division Sjælland</div>
            <div><%= senderAddress.street %></div>
            <div><%= senderAddress.zip %> <%= senderAddress.city %></div>
            <div>Tlf. <%= snapshot.sender?.phoneNumber || "72 41 10 01" %></div>
        </div>

        <div>
            <strong>Kunde:</strong>
            <div><%= snapshot.customer.name %></div>
            <div><%= snapshot.customer.street %></div>
            <div><%= snapshot.customer.zip %> <%= snapshot.customer.city %></div>
            <% if (snapshot.customer.contactPerson?.name) { %>
                <div>Att. <%= snapshot.customer.contactPerson.name %></div>
            <% } %>
            <div><%= snapshot.customer.email %></div>
        </div>
    </div>
</div>

<!-- RENGØRINGSADRESSE -->
<div class="section">
    <h2>Rengøringsadresse</h2>
    <p>
        <% if (snapshot.location?.name) { %><%= snapshot.location.name %><br><% } %>
        <%= snapshot.location?.street %><br>
        <%= snapshot.location?.zip %> <%= snapshot.location?.city %>
        <% if (snapshot.location?.contactPerson?.name) { %>
            <br>Att. <%= snapshot.location.contactPerson.name %>
        <% } %>
    </p>
</div>

<!-- RENGØRINGEN -->
<div class="section">
    <h2>Rengøringen</h2>
    <p>Rengøring udføres jf. rengøringsvejledning.</p>

    <p>
        <span class="price-figure">Pris pr. måned: <%= snapshot.plan.totalMonthlyPrice.toFixed(2) %> kr.</span>
        ekskl. moms.
    </p>

    <% if (snapshot.plan.environmentalFeePercent > 0) { %>
        <p>
            Heri er indregnet et drifts- og miljøtillæg på <%= snapshot.plan.environmentalFeePercent %>%,
            svarende til <%= snapshot.plan.environmentalFeeAmount.toFixed(2) %> kr.
        </p>
    <% } %>
</div>

<!-- FORBRUGSVARER -->
<% if (snapshot.consumables && snapshot.consumables.length > 0) { %>
    <div class="section">
        <h2>Forbrugsvarer</h2>
        <ul>
            <% snapshot.consumables.forEach(c => { %>
                <li>
                    <%= c.name %> &ndash; <%= c.amount %> <%= c.unitLabel %>
                    &ndash; pris <%= Number(c.pricePerUnit || 0).toFixed(2) %> kr ekskl. moms
                </li>
            <% }) %>
        </ul>
    </div>
<% } %>

<!-- FORPLIGTELSER -->
<div class="section">
    <h2>Service Division Sjælland forpligter sig til følgende</h2>
    <ul>
        <li>Rengøring af aftalte områder på aftalte dage.</li>
        <li>Rengøringspersonale har tavshedspligt vedrørende fortrolige oplysninger, de vil kunne få kendskab til.</li>
    </ul>
</div>

<div class="section">
    <h2>Kunden forpligter sig til</h2>
    <ul>
        <li>At Service Division Sjællands personale har adgang til alle nødvendige rum.</li>
        <li>At stille rengøringsrum til rådighed.</li>
    </ul>
</div>

<!-- SÆRLIGE BESTEMMELSER -->
<div class="section">
    <h2>Særlige bestemmelser</h2>
    <ul>
        <li>Alle ovennævnte priser tillægges den til enhver tid gældende momssats, der pt. udgør 25%.</li>
        <li>Betalingsbetingelser: <%= snapshot.plan.paymentTermsLabel %>.</li>
        <li>
            Der udføres ikke rengøring på danske helligdage. Ønsker kunden en erstatningsrengøring for en
            planlagt rengøring, der bortfalder som følge af en helligdag, skal kunden selv kontakte
            leverandøren med henblik på at aftale en alternativ dato.
        </li>
        <li>Ad hoc-opgaver faktureres pr. time <%= Number(snapshot.plan.hourlyRate || 0).toFixed(2) %> kr. ekskl. moms.</li>
        <li>
            Prisen reguleres én gang årligt efter nettoprisindekset, første gang
            <%= new Date(snapshot.acceptedAt || contract.generatedAt).getFullYear() + 1 %>.
        </li>
        <li>Kontrakten kan opsiges af begge parter med <%= snapshot.plan.terminationNoticeLabel %> varsel.</li>
        <li>
            Denne aftale træder i kraft
            <% if (snapshot.acceptedAt) { %>
                den <%= snapshot.acceptedAt.toLocaleDateString("da-DK", { day: "numeric", month: "long", year: "numeric" }) %>.
            <% } else { %>
                ved kundens accept af tilbuddet.
            <% } %>
        </li>
    </ul>
</div>

<!-- UNDERSKRIFT -->
<div class="signature-block">
    <div>
        <div class="signature-date">......................... den ....................</div>
        <div class="signature-line"></div>
        Kunden (underskrift)
    </div>

    <div>
        <div class="signature-date">......................... den ....................</div>
        <div class="signature-line"></div>
        Leverandør (underskrift)
    </div>
</div>

<!-- MED VENLIG HILSEN -->
<div class="signoff">
    <p>Med venlig hilsen</p>

    <p>
        <strong><%= snapshot.sender?.fullName || "SDS Rengøring" %></strong>
        <% if (snapshot.sender?.position) { %><%= snapshot.sender.position %><br><% } %>
        SDS Rengøring<br>
        <%= senderAddress.street %><br>
        <%= senderAddress.zip %> <%= senderAddress.city %><br>
        Tlf. <%= snapshot.sender?.phoneNumber || "72 41 10 01" %>
        <% if (snapshot.sender?.email) { %><br><%= snapshot.sender.email %><% } %>
    </p>
</div>

</body>
</html>
