<article class="standard roomTemplate-edit-page">
    <h1>Rediger loakleskabelon</h1>

    <% if (error) { %>
        <div class="error-box"><%= error %></div>
    <% } %>

    <form
            hx-post="/roomTemplates/edit/<%= template._id %>"
            hx-target="#content"
            hx-swap="innerHTML">

        <label>Navn</label>
        <input type="text" name="name" value="<%= template.name %>" required>

        <label>Standard størrelse (m²)</label>
        <input type="number" name="defaultSize" value="<%= template.defaultSize %>" required>

        <input type="hidden" name="bundleType" value="daily">

        <h2>SDS-opgaver</h2>

        <label>Soigneringsskabelon</label>
        <select name="daily" required>
            <option value="">Vælg...</option>
            <% soigneringTemplates.forEach(t => { %>
                <option value="<%= t._id %>"
                        <%= template.taskTemplateId.daily?.toString() === t._id.toString() ? 'selected' : '' %>>
                    <%= t.name %>
                </option>
            <% }) %>
        </select>

        <label>Gulvskabelon</label>
        <select name="floor" required>
            <option value="">Vælg...</option>
            <% gulvTemplates.forEach(t => { %>
                <option value="<%= t._id %>"
                        <%= template.taskTemplateId.floor?.toString() === t._id.toString() ? 'selected' : '' %>>
                    <%= t.name %>
                </option>
            <% }) %>
        </select>

        <label>Inventarskabelon</label>
        <select name="inventory" required>
            <option value="">Vælg...</option>
            <% inventarTemplates.forEach(t => { %>
                <option value="<%= t._id %>"
                        <%= template.taskTemplateId.inventory?.toString() === t._id.toString() ? 'selected' : '' %>>
                    <%= t.name %>
                </option>
            <% }) %>
        </select>

        <button type="submit">Gem ændringer</button>
    </form>

    <hr>

    <form
            hx-post="/roomTemplates/delete/<%= template._id %>"
            hx-target="#content"
            hx-swap="innerHTML"
            onsubmit="return confirm('Er du sikker på at du vil slette dette rum-template?');">

        <button type="submit" class="danger">Slet</button>
    </form>

    <button hx-get="/roomTemplates/page" hx-target="#content">Tilbage</button>
</article>
