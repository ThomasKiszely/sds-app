<article class="standard roomTemplate-edit-page">
    <h1>Rediger rum-template</h1>

    <% if (error) { %>
        <div class="error-box"><%= error %></div>
    <% } %>

    <form
            hx-post="/roomTemplates/edit/<%= template._id %>"
            hx-target="#content"
            hx-swap="innerHTML">

        <label>Navn</label>
        <input type="text" name="name" value="<%= template.name %>" required>

        <label>Standard størrelse (m²)</label>
        <input type="number" name="defaultSize" value="<%= template.defaultSize %>" required>

        <label>Bundle type</label>
        <select name="bundleType" required>
            <option value="daily" <%= template.bundleType === 'daily' ? 'selected' : '' %>>
                Daily
            </option>
        </select>

        <h2>SDS-opgaver</h2>

        <label>Soignering skabelon</label>
        <select name="soignering" required>
            <option value="">Vælg...</option>
            <% cleaningTaskTemplates.forEach(t => { %>
                <option
                        value="<%= t._id %>"
                        <%= template.taskTemplateId?.soignering?.toString() === t._id.toString() ? 'selected' : '' %>>
                    <%= t.name %>
                </option>
            <% }) %>
        </select>

        <label>Gulv skabelon</label>
        <select name="gulv" required>
            <option value="">Vælg...</option>
            <% cleaningTaskTemplates.forEach(t => { %>
                <option
                        value="<%= t._id %>"
                        <%= template.taskTemplateId?.gulv?.toString() === t._id.toString() ? 'selected' : '' %>>
                    <%= t.name %>
                </option>
            <% }) %>
        </select>

        <label>Inventar skabelon</label>
        <select name="inventar" required>
            <option value="">Vælg...</option>
            <% cleaningTaskTemplates.forEach(t => { %>
                <option
                        value="<%= t._id %>"
                        <%= template.taskTemplateId?.inventar?.toString() === t._id.toString() ? 'selected' : '' %>>
                    <%= t.name %>
                </option>
            <% }) %>
        </select>

        <button type="submit">Gem ændringer</button>
    </form>

    <hr>

    <form
            hx-post="/roomTemplates/delete/<%= template._id %>"
            hx-target="#content"
            hx-swap="innerHTML"
            onsubmit="return confirm('Er du sikker på at du vil slette dette rum-template?');">

        <button type="submit" class="danger">Slet</button>
    </form>

    <button hx-get="/roomTemplates/page" hx-target="#content">Tilbage</button>
</article>
