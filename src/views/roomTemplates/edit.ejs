<article class="standard roomTemplate-edit-page">
    <h1>Rediger lokaleskabelon</h1>

    <% if (error) { %>
        <div class="error-box"><%= error %></div>
    <% } %>

    <form
            hx-post="/roomTemplates/edit/<%= template._id %>"
            hx-target="#content"
            hx-swap="innerHTML">

        <label for="templateName">Navn</label>
        <input type="text" id="templateName" name="name" value="<%= template.name %>" required>

        <label for="defaultSize">Standard størrelse (m²)</label>
        <input type="number" id="defaultSize" name="defaultSize" value="<%= template.defaultSize %>" required>

        <input type="hidden" name="bundleType" value="daily">

        <h2>SDS-opgaver</h2>

        <label for="dailyTemplate">Soigneringsskabelon</label>
        <select id="dailyTemplate" name="daily" required>
            <option value="">Vælg...</option>
            <% soigneringTemplates.forEach(t => { %>
                <option value="<%= t._id %>"
                        <%= template.taskTemplateId.daily?.toString() === t._id.toString() ? 'selected' : '' %>>
                    <%= t.name %>
                </option>
            <% }) %>
        </select>

        <label for="floorTemplate">Gulvskabelon</label>
        <select id="floorTemplate" name="floor" required>
            <option value="">Vælg...</option>
            <% gulvTemplates.forEach(t => { %>
                <option value="<%= t._id %>"
                        <%= template.taskTemplateId.floor?.toString() === t._id.toString() ? 'selected' : '' %>>
                    <%= t.name %>
                </option>
            <% }) %>
        </select>

        <label for="inventoryTemplate">Inventarskabelon</label>
        <select id="inventoryTemplate" name="inventory" required>
            <option value="">Vælg...</option>
            <% inventarTemplates.forEach(t => { %>
                <option value="<%= t._id %>"
                        <%= template.taskTemplateId.inventory?.toString() === t._id.toString() ? 'selected' : '' %>>
                    <%= t.name %>
                </option>
            <% }) %>
        </select>

        <button type="submit">Gem ændringer</button>
    </form>

    <hr>

    <form
            hx-post="/roomTemplates/delete/<%= template._id %>"
            hx-target="#content"
            hx-swap="innerHTML"
            onsubmit="return confirm('Er du sikker på at du vil slette dette rum-template?');">

        <button type="submit" class="danger">Slet</button>
    </form>

    <button type="button" class="button-secondary" hx-get="/roomTemplates/page" hx-target="#content">Tilbage</button>
</article>
