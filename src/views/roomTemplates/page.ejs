<article class="standard roomTemplates-page">
    <h1>Lokaleskabelon</h1>

    <% if (toast) { %>
        <div class="toast"><%= toast %></div>
    <% } %>

    <button hx-get="/roomTemplates/new" hx-target="#content">Opret ny lokaleskabelon</button>

    <table class="standard responsive-table">
        <thead>
        <tr>
            <th>Navn</th>
            <th>Størrelse</th>
            <th>Handlinger</th>
        </tr>
        </thead>

        <tbody>
        <% roomTemplates.forEach(t => { %>
            <tr>
                <td data-label="Navn"><%= t.name %></td>
                <td data-label="Størrelse"><%= t.defaultSize %> m²</td>

                <td class="actions" data-label="Handlinger">
                    <button class="btn btn-fixed"
                            hx-get="/roomTemplates/edit/<%= t._id %>"
                            hx-target="#content"
                            hx-swap="innerHTML">
                        Rediger
                    </button>
                </td>
            </tr>
        <% }) %>
        </tbody>
    </table>

    <button hx-get="/indexContent" hx-target="#content">Tilbage</button>
</article>
