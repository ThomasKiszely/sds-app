<article class="standard roomTemplate-create-page">
    <h1>Opret lokaleskabelon</h1>

    <% if (error) { %>
        <div class="error-box"><%= error %></div>
    <% } %>

    <form hx-post="/roomTemplates" hx-target="#content">

        <label>Navn</label>
        <input
                type="text"
                name="name"
                value="<%= formData?.name || '' %>"
                required
        >

        <label>Standard størrelse (m²)</label>
        <input
                type="number"
                name="defaultSize"
                value="<%= formData?.defaultSize || '' %>"
                required
        >

        <input type="hidden" name="bundleType" value="daily">


        <h2>Rengøringsopgaver</h2>

        <label>Soigneringsskabelon</label>
        <select name="daily" required>
            <option value="">Vælg...</option>
            <% soigneringTemplates.forEach(t => { %>
                <option value="<%= t._id %>" <%= formData?.daily === t._id.toString() ? 'selected' : '' %>>
                    <%= t.name %>
                </option>
            <% }) %>
        </select>

        <label>Gulvskabelon</label>
        <select name="floor" required>
            <option value="">Vælg...</option>
            <% gulvTemplates.forEach(t => { %>
                <option value="<%= t._id %>" <%= formData?.floor === t._id.toString() ? 'selected' : '' %>>
                    <%= t.name %>
                </option>
            <% }) %>
        </select>

        <label>Inventarskabelon</label>
        <select name="inventory" required>
            <option value="">Vælg...</option>
            <% inventarTemplates.forEach(t => { %>
                <option value="<%= t._id %>" <%= formData?.inventory === t._id.toString() ? 'selected' : '' %>>
                    <%= t.name %>
                </option>
            <% }) %>
        </select>


        <button>Opret</button>
    </form>

    <button hx-get="/roomTemplates/page" hx-target="#content">Tilbage</button>
</article>
