<article class="standard roomTemplate-create-page">
    <h1>Opret rum-template</h1>

    <% if (error) { %>
        <div class="error-box"><%= error %></div>
    <% } %>

    <form hx-post="/roomTemplates" hx-target="#content">

        <label>Navn</label>
        <input
                type="text"
                name="name"
                value="<%= formData?.name || '' %>"
                required
        >

        <label>Standard størrelse (m²)</label>
        <input
                type="number"
                name="defaultSize"
                value="<%= formData?.defaultSize || '' %>"
                required
        >

        <label>Bundle type</label>
        <select name="bundleType" required>
            <option value="">Vælg...</option>
            <option value="daily" <%= formData?.bundleType === 'daily' ? 'selected' : '' %>>
                Daily
            </option>
        </select>


        <h2>SDS-opgaver</h2>

        <label>Soignering skabelon</label>
        <select name="soignering" required>
            <option value="">Vælg...</option>
            <% cleaningTaskTemplates.forEach(t => { %>
                <option
                        value="<%= t._id %>"
                        <%= formData?.soignering === t._id.toString() ? 'selected' : '' %>>
                    <%= t.name %>
                </option>
            <% }) %>
        </select>

        <label>Gulv skabelon</label>
        <select name="gulv" required>
            <option value="">Vælg...</option>
            <% cleaningTaskTemplates.forEach(t => { %>
                <option
                        value="<%= t._id %>"
                        <%= formData?.gulv === t._id.toString() ? 'selected' : '' %>>
                    <%= t.name %>
                </option>
            <% }) %>
        </select>

        <label>Inventar skabelon</label>
        <select name="inventar" required>
            <option value="">Vælg...</option>
            <% cleaningTaskTemplates.forEach(t => { %>
                <option
                        value="<%= t._id %>"
                        <%= formData?.inventar === t._id.toString() ? 'selected' : '' %>>
                    <%= t.name %>
                </option>
            <% }) %>
        </select>

        <button>Opret</button>
    </form>

    <button hx-get="/roomTemplates/page" hx-target="#content">Tilbage</button>
</article>
