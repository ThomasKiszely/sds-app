<% if (templates.length === 0) { %>
    <div class="empty-state">Arkivet er tomt.</div>
<% } else { %>
<table class="data-table responsive-table" style="margin-top: 0">
    <thead>
    <tr>
        <th>Navn</th>
        <th>Kategori</th>
        <th>Tid pr. enhed</th>
        <th>Frekvens</th>
        <th>Enhed</th>
        <th><span class="visually-hidden">Handlinger</span></th>
    </tr>
    </thead>

    <tbody>
    <% templates.forEach(t => { %>
        <tr>
            <td data-label="Navn">
                <strong><%= t.name %></strong>
                <% if (t.description) { %><div class="list-row-sub"><%= t.description %></div><% } %>
            </td>
            <td data-label="Kategori"><span class="tag"><%= categoryLabels[t.category] %></span></td>
            <td data-label="Tid pr. enhed"><%= String(t.durationPerUnit).replace('.', ',') + " min" %></td>
            <td data-label="Frekvens"><%= frequencyLabels[t.frequency] || "–" %></td>
            <td data-label="Enhed"><%= unitsLabels[t.unit] %></td>

            <td class="actions">
                <button class="btn-small"
                        hx-patch="/cleaningTaskTemplates/<%= t._id %>/reactivate"
                        hx-target="#content"
                        hx-confirm="Vil du genaktivere denne skabelon?">
                    Genaktivér
                </button>
            </td>
        </tr>
    <% }) %>
    </tbody>
</table>
<% } %>
