<table class="responsive-table">
    <thead>
    <tr>
        <th>Navn</th>
        <th>Kategori</th>
        <th>Beskrivelse</th>
        <th>Tid pr. enhed</th>
        <th>Frekvens</th>
        <th>Enhed</th>
        <th>Pris</th>
        <th>Handlinger</th>
    </tr>
    </thead>

    <tbody>
    <% templates.forEach(t => { %>
        <tr>
            <td data-label="Navn"><%= t.name %></td>
            <td data-label="Kategori"><%= categoryLabels[t.category] %></td>
            <td data-label="Beskrivelse"><%= t.description %></td>
            <td data-label="Tid pr. enhed"><%= t.isConsumable ? "–" : t.durationPerUnit + " min" %></td>
            <td data-label="Frekvens"><%= t.isConsumable ? "–" : frequencyLabels[t.frequency] %></td>
            <td data-label="Enhed"><%= unitsLabels[t.unit] %></td>
            <td data-label="Pris"><%= t.customPrice != null ? Number(t.customPrice).toLocaleString("da-DK", { minimumFractionDigits: 2 }) + " kr" : "–" %></td>

            <td>
                <button
                        hx-patch="/cleaningTaskTemplates/<%= t._id %>/reactivate"
                        hx-target="#content"
                        hx-confirm="Vil du genaktivere denne skabelon?">
                    Genaktiver
                </button>
            </td>
        </tr>
    <% }) %>
    </tbody>
</table>
