<article class="standard tasks-page">
    <button type="button" class="back-link" hx-get="/cleaningTaskTemplates/page" hx-target="#content"><%- icon('arrow-left') %> Tilbage til opgaver</button>
    <h1>Rediger opgave-skabelon</h1>

    <form hx-patch="/cleaningTaskTemplates/<%= template._id %>" hx-target="#content">

        <label>Navn</label>
        <input type="text" name="name" value="<%= template.name %>" required>

        <label>Beskrivelse</label>
        <textarea name="description"><%= template.description %></textarea>

        <!-- Kategori -->
        <label>Kategori</label>
        <select name="category">
            <% Object.keys(categoryTypes)
                .filter(key => categoryTypes[key] !== categoryTypes.consumables)
                .forEach(key => { %>
                <option value="<%= categoryTypes[key] %>"
                        <%= template.category === categoryTypes[key] ? "selected" : "" %>>
                    <%= categoryLabels[key] %>
                </option>
            <% }) %>
        </select>

        <%- include("./partials/roomTypePicker", { roomTypes, selected: template.roomTypes }) %>

        <!-- Dynamiske felter -->
        <div id="taskFields">
            <%- include("./partials/taskFields", {
            template,
            category: template.category,
            categoryTypes,
            categoryLabels,
            units,
            unitsLabels,
            frequencies,
            frequencyLabels
            }) %>
        </div>

        <button type="submit">Gem ændringer</button>
    </form>
</article>
