<article class="standard tasks-page">
    <h1>Rediger opgave-skabelon</h1>

    <form hx-patch="/cleaningTaskTemplates/<%= template._id %>" hx-target="#content">

        <label>Navn</label>
        <input type="text" name="name" value="<%= template.name %>" required>

        <label>Beskrivelse</label>
        <textarea name="description"><%= template.description %></textarea>

        <!-- Kategori -->
        <label>Kategori</label>
        <select name="category"
                hx-get="/cleaningTaskTemplates/<%= template._id %>/edit/taskFields"
                hx-target="#taskFields"
                hx-include="this">
            <% Object.keys(categoryTypes).forEach(key => { %>
                <option value="<%= categoryTypes[key] %>"
                        <%= template.category === categoryTypes[key] ? "selected" : "" %>>
                    <%= categoryLabels[key] %>
                </option>
            <% }) %>
        </select>

        <!-- Dynamiske felter -->
        <div id="taskFields">
            <%- include("./partials/taskFields") %>
        </div>

        <button type="submit">Gem ændringer</button>
    </form>
</article>
