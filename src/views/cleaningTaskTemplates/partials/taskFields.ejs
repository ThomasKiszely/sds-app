<% if (category === categoryTypes.consumables) { %>

    <!-- Pris -->
    <label>Pris</label>
    <input type="number" step="0.01" name="pricePerUnit"
           value="<%= template.pricePerUnit %>" required>

    <!-- Hidden defaults -->
    <input type="hidden" name="durationPerUnit" value="0">
    <input type="hidden" name="unit" value="<%= units.stk %>">
    <input type="hidden" name="frequency" value="<%= frequencies.none %>">

<% } else { %>

    <!-- Tid pr. enhed -->
    <label>Tid pr. enhed (minutter)</label>
    <input type="number" step="0.01" name="durationPerUnit"
           value="<%= template.durationPerUnit %>" required>

    <!-- Enhed -->
    <label>Enhed</label>
    <select name="unit">
        <% Object.keys(units).forEach(key => { %>
            <option value="<%= units[key] %>"
                    <%= units[key] === template.unit ? "selected" : "" %>>
                <%= unitsLabels[key] %>
            </option>
        <% }) %>
    </select>

    <!-- Frekvens -->
    <label>Frekvens</label>
    <select name="frequency">
        <% Object.keys(frequencies).forEach(key => { %>
            <option value="<%= frequencies[key] %>"
                    <%= frequencies[key] === template.frequency ? "selected" : "" %>>
                <%= frequencyLabels[key] %>
            </option>
        <% }) %>
    </select>

<% } %>
