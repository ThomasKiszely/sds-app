<article class="standard tasks-page">
    <h1>Opret opgave-skabelon</h1>

    <form hx-post="/cleaningTaskTemplates" hx-target="#content" hx-swap="innerHTML">

        <label>Navn</label>
        <input type="text" name="name" required>

        <label>Beskrivelse</label>
        <textarea name="description"></textarea>

        <!-- Kategori -->
        <label>Kategori</label>
        <select name="category"
                hx-get="/cleaningTaskTemplates/create/taskFields"
                hx-target="#taskFields"
                hx-include="this">
            <% Object.keys(categoryTypes).forEach(key => { %>
                <option value="<%= categoryTypes[key] %>"
                        <%= category === categoryTypes[key] ? "selected" : "" %>>
                    <%= categoryLabels[key] %>
                </option>
            <% }) %>
        </select>

        <!-- Dynamiske felter -->
        <div id="taskFields">
            <%- include("./partials/taskFields", {
            template,
            category,
            categoryTypes,
            units,
            unitsLabels,
            frequencies,
            frequencyLabels
            }) %>
        </div>

        <button type="submit">Gem</button>
    </form>
</article>
