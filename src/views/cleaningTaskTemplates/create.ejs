<article class="standard tasks-page">
    <button type="button" class="back-link" hx-get="/cleaningTaskTemplates/page" hx-target="#content"><%- icon('arrow-left') %> Tilbage til opgaver</button>
    <h1>Opret opgave-skabelon</h1>

    <form hx-post="/cleaningTaskTemplates" hx-target="#content" hx-swap="innerHTML">

        <label>Navn</label>
        <input type="text" name="name" required>

        <label>Beskrivelse</label>
        <textarea name="description"></textarea>

        <!-- Kategori -->
        <label>Kategori</label>
        <select name="category">
            <% Object.keys(categoryTypes)
                .filter(key => categoryTypes[key] !== categoryTypes.consumables)
                .forEach(key => { %>
                <option value="<%= categoryTypes[key] %>"
                        <%= category === categoryTypes[key] ? "selected" : "" %>>
                    <%= categoryLabels[key] %>
                </option>
            <% }) %>
        </select>

        <%- include("./partials/roomTypePicker", { roomTypes, selected: [] }) %>

        <!-- Dynamiske felter -->
        <div id="taskFields">
            <%- include("./partials/taskFields", {
            template,
            category,
            categoryTypes,
            units,
            unitsLabels,
            frequencies,
            frequencyLabels
            }) %>
        </div>

        <button type="submit">Gem</button>
    </form>
</article>
