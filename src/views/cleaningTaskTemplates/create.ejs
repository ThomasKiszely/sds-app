<article class="standard tasks-page">
    <h1>Opret opgave-skabelon</h1>

    <form hx-post="/cleaningTaskTemplates" hx-target="#content" hx-swap="innerHTML">

        <label>Navn</label>
        <input type="text" name="name" required>

        <label>Beskrivelse</label>
        <textarea name="description"></textarea>

        <label>Kategori</label>
        <select name="category">
            <% Object.keys(categoryTypes).forEach(key => { %>
                <option value="<%= categoryTypes[key] %>">
                    <%= categoryLabels[key] %>
                </option>
            <% }) %>
        </select>

        <label>Tid pr. enhed (minutter)</label>
        <input type="number" step="0.01" name="durationPerUnit" required>

        <label>Enhed</label>
        <select name="unit">
            <% Object.keys(units).forEach(key => { %>
                <option value="<%= units[key] %>">
                    <%= unitsLabels[key] %>
                </option>
            <% }) %>
        </select>

        <label>Frekvens</label>
        <select name="frequency">
            <% Object.keys(frequencies).forEach(key => { %>
                <option value="<%= frequencies[key] %>">
                    <%= frequencyLabels[key] %>
                </option>
            <% }) %>
        </select>

        <button type="submit">Gem</button>
    </form>
</article>
