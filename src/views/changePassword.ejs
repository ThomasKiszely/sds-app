<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Skift adgangskode – SDS Drift</title>
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/components.css">
</head>

<body>
<main id="content" class="login-wrap">
    <article class="login-page">
        <div class="login-brand">
            <img src="/images/sds-logo-red.png" alt="">
            <span>SDS Drift</span>
        </div>

        <h1>Skift adgangskode</h1>
        <p class="page-sub" style="margin-bottom: 16px">Du skal vælge en ny adgangskode, før du kan fortsætte.</p>

        <% if (typeof error !== 'undefined') { %>
            <div class="error" role="alert"><%= error %></div>
        <% } %>

        <form action="/users/me/password" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <label for="password">Ny adgangskode</label>
            <input type="password" id="password" name="password" autocomplete="new-password" required minlength="8">

            <label for="repeated">Gentag adgangskode</label>
            <input type="password" id="repeated" name="repeated" autocomplete="new-password" required minlength="8">

            <div class="password-rules">
                <p><strong>Krav til adgangskode:</strong></p>
                <ul>
                    <li>Mindst 8 tegn</li>
                    <li>Mindst ét stort bogstav (A‑Z)</li>
                    <li>Mindst ét lille bogstav (a‑z)</li>
                    <li>Mindst ét tal (0‑9)</li>
                    <li>Mindst ét specialtegn (!@#$%^&* osv.)</li>
                    <li>Må ikke indeholde brugernavnet</li>
                </ul>
            </div>

            <button type="submit">Gem adgangskode</button>
        </form>
    </article>
</main>
</body>
</html>
