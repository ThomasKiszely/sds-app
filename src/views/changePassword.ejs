<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <title>Skift adgangskode</title>
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/components.css">
</head>

<body>
<main id="content">
    <article class="standard login-page">
        <h1>Skift adgangskode</h1>
        <p>Du skal vælge en ny adgangskode før du kan fortsætte.</p>

        <% if (typeof error !== 'undefined') { %>
            <div class="error"><%= error %></div>
        <% } %>

        <form action="/users/me/password" method="POST">
            <label for="password">Ny adgangskode</label>
            <input type="password" id="password" name="password" required minlength="8">

            <label for="repeated">Gentag adgangskode</label>
            <input type="password" id="repeated" name="repeated" required minlength="8">

            <div class="password-rules">
                <p><strong>Krav til adgangskode:</strong></p>
                <ul>
                    <li>Mindst 8 tegn</li>
                    <li>Mindst ét stort bogstav (A‑Z)</li>
                    <li>Mindst ét lille bogstav (a‑z)</li>
                    <li>Mindst ét tal (0‑9)</li>
                    <li>Mindst ét specialtegn (!@#$%^&* osv.)</li>
                    <li>Må ikke indeholde brugernavnet</li>
                </ul>
            </div>

            <button type="submit">Gem adgangskode</button>
        </form>
    </article>
</main>
</body>
</html>
