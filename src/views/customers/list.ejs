<%
    const totalPages = Math.max(1, Math.ceil(total / pageSize));
    const filterTabs = [['active', 'Aktive'], ['inactive', 'Inaktive'], ['all', 'Alle']];
    // filter kommer fra query-strengen og ender i hx-vals (JSON), så kun kendte værdier
    filter = filterTabs.some(([value]) => value === filter) ? filter : 'active';
    const include = "[name='search'], [name='sort']";
%>
<article class="standard customers-page">
    <header class="page-header">
        <div class="page-title-row">
            <h1>Kunder</h1>
            <span class="page-count"><%= total %> <%= filter === 'inactive' ? 'inaktive' : filter === 'all' ? 'i alt' : 'aktive' %></span>
        </div>
        <div class="page-actions">
            <div class="search-field">
                <%- icon('search') %>
                <input type="search"
                       name="search"
                       placeholder="Søg navn, kundenr. eller adresse"
                       aria-label="Søg kunder"
                       value="<%= search %>"
                       hx-get="/customers"
                       hx-target="#content"
                       hx-trigger="keyup changed delay:300ms, search"
                       hx-vals='{"filter": "<%= filter %>"}'
                       hx-include="<%= include %>">
            </div>
            <button type="button" class="btn-primary" hx-get="/customers/create" hx-target="#content">
                <%- icon('plus') %> Opret kunde
            </button>
        </div>
    </header>

    <div class="tabs-row">
        <div class="tabs">
            <% filterTabs.forEach(([value, label]) => { %>
                <button type="button"
                        class="tab <%= filter === value ? 'is-active' : '' %>"
                        hx-get="/customers"
                        hx-target="#content"
                        hx-vals='{"filter": "<%= value %>"}'
                        hx-include="<%= include %>">
                    <%= label %>
                </button>
            <% }) %>
            <button type="button" class="tab" hx-get="/preview/customer-group" hx-target="#content">
                Grupper <span class="preview-badge">Preview</span>
            </button>
        </div>

        <select name="sort"
                aria-label="Sortér efter"
                hx-get="/customers"
                hx-target="#content"
                hx-trigger="change"
                hx-vals='{"filter": "<%= filter %>"}'
                hx-include="[name='search']">
            <option value="name" <%= sort === "name" ? "selected" : "" %>>Sortér: Navn</option>
            <option value="number" <%= sort === "number" ? "selected" : "" %>>Sortér: Kundenummer</option>
            <option value="address" <%= sort === "address" ? "selected" : "" %>>Sortér: Adresse</option>
            <option value="phone" <%= sort === "phone" ? "selected" : "" %>>Sortér: Telefon</option>
        </select>
    </div>

    <% if (customers.length === 0) { %>
        <div class="empty-state">
            <% if (search) { %>
                Ingen kunder matcher "<%= search %>".
            <% } else { %>
                Der er ingen kunder her endnu.
            <% } %>
        </div>
    <% } else { %>
        <table class="data-table customers-table responsive-table">
            <thead>
            <tr>
                <th>Kundenr.</th>
                <th>Navn</th>
                <th>Telefon</th>
                <th>Email</th>
                <th>Status</th>
                <th><span class="visually-hidden">Handlinger</span></th>
            </tr>
            </thead>

            <tbody>
            <% customers.forEach(customer => { %>
                <tr>
                    <td data-label="Kundenr." class="muted"><%= customer.customerNumber %></td>
                    <td data-label="Navn">
                        <a href="#" class="row-link" hx-get="/customers/<%= customer._id %>/details" hx-target="#content"><%= customer.customerName %></a>
                    </td>
                    <td data-label="Telefon" class="hide-mobile"><%= customer.phoneNumber %></td>
                    <td data-label="Email" class="cell-truncate hide-mobile"><%= customer.customerEmail %></td>
                    <td data-label="Status">
                        <% if (!customer.isDeleted) { %>
                            <span class="badge badge-active">Aktiv</span>
                        <% } else { %>
                            <span class="badge badge-inactive">Inaktiv</span>
                        <% } %>
                    </td>

                    <td class="actions">
                        <button class="btn-small" hx-get="/customers/<%= customer._id %>/plans" hx-target="#content">Planer</button>

                        <% if (user.role === 'admin') { %>
                            <% if (!customer.isDeleted) { %>
                                <button class="btn-small" hx-get="/customers/<%= customer._id %>/edit" hx-target="#content">Rediger</button>
                                <button class="btn-small btn-ghost btn-danger"
                                        hx-delete="/customers/<%= customer._id %>"
                                        hx-target="#content"
                                        hx-confirm="Vil du slette kunden?">
                                    Slet
                                </button>
                            <% } else { %>
                                <button class="btn-small"
                                        hx-put="/customers/<%= customer._id %>/reactivate"
                                        hx-target="#content">
                                    Aktivér
                                </button>
                            <% } %>
                        <% } %>
                    </td>
                </tr>
            <% }) %>
            </tbody>
        </table>
    <% } %>

    <% if (totalPages > 1) { %>
        <div class="pagination">
            <% if (page > 1) { %>
                <button class="btn-small"
                        hx-get="/customers"
                        hx-target="#content"
                        hx-vals='{"filter": "<%= filter %>", "page": "<%= page - 1 %>"}'
                        hx-include="<%= include %>">
                    <%- icon('chevron-left') %> Forrige
                </button>
            <% } %>

            <span>Side <%= page %> af <%= totalPages %></span>

            <% if (page < totalPages) { %>
                <button class="btn-small"
                        hx-get="/customers"
                        hx-target="#content"
                        hx-vals='{"filter": "<%= filter %>", "page": "<%= page + 1 %>"}'
                        hx-include="<%= include %>">
                    Næste <%- icon('chevron-right') %>
                </button>
            <% } %>
        </div>
    <% } %>
</article>
