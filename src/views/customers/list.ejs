<article class="standard customers-page">
    <h1>Kunder</h1>

    <nav>
        <button hx-get="/customers/create" hx-target="#content">
            Opret kunde
        </button>
    </nav>

    <!-- Søgning + Filtre + Sortering -->
    <div class="customer-controls-wrapper">
    <div class="customer-controls card">

        <div class="search-box">
            <input type="text"
                   name="search"
                   placeholder="Søg kunder..."
                   value="<%= search %>"
                   hx-get="/customers"
                   hx-target="#content"
                   hx-trigger="keyup changed delay:300ms"
                   hx-include="[name='search'], [name='filter'], [name='sort'], [name='page']">
        </div>

        <div class="filter-row">
            <select name="filter"
                    hx-get="/customers"
                    hx-target="#content"
                    hx-trigger="change"
                    hx-include="[name='search'], [name='filter'], [name='sort'], [name='page']">
                <option value="active" <%= filter === "active" ? "selected" : "" %>>Aktive</option>
                <option value="inactive" <%= filter === "inactive" ? "selected" : "" %>>Inaktive</option>
                <option value="all" <%= filter === "all" ? "selected" : "" %>>Alle</option>
            </select>

            <select name="sort"
                    hx-get="/customers"
                    hx-target="#content"
                    hx-trigger="change"
                    hx-include="[name='search'], [name='filter'], [name='sort'], [name='page']">
                <option value="name" <%= sort === "name" ? "selected" : "" %>>Navn</option>
                <option value="number" <%= sort === "number" ? "selected" : "" %>>Kundenummer</option>
                <option value="address" <%= sort === "address" ? "selected" : "" %>>Adresse</option>
                <option value="phone" <%= sort === "phone" ? "selected" : "" %>>Telefon</option>
            </select>
        </div>

    </div>
    </div>

    <section>
        <table class="customers-table responsive-table">
            <thead>
            <tr>
                <th>Kundenr.</th>
                <th>Navn</th>
                <th>Telefon</th>
                <th>Email</th>
                <th>Status</th>
                <th>Handlinger</th>
            </tr>
            </thead>

            <tbody>
            <% customers.forEach(customer => { %>
                <tr>
                    <td data-label="Kundenr"><%= customer.customerNumber %></td>
                    <td data-label="Navn"><%= customer.customerName %></td>
                    <td data-label="Telefon"><%= customer.phoneNumber %></td>
                    <td data-label="Email"><%= customer.customerEmail %></td>
                    <td data-label="Status">
                        <% if (!customer.isDeleted) { %>
                            <span class="badge badge-active">Aktiv</span>
                        <% } else { %>
                            <span class="badge badge-inactive">Inaktiv</span>
                        <% } %>
                    </td>

                    <td>
                        <button hx-get="/customers/<%= customer._id %>/plans" hx-target="#content">
                            Vis planer
                        </button>

                        <button hx-get="/customers/<%= customer._id %>/details" hx-target="#content">
                            Detaljer
                        </button>

                        <% if (user.role === 'admin') { %>

                            <% if (!customer.isDeleted) { %>
                                <button hx-get="/customers/<%= customer._id %>/edit" hx-target="#content">
                                    Rediger
                                </button>

                                <button
                                        hx-delete="/customers/<%= customer._id %>"
                                        hx-target="#content"
                                        hx-confirm="Vil du slette kunden?">
                                    Slet
                                </button>
                            <% } else { %>
                                <button
                                        hx-put="/customers/<%= customer._id %>/reactivate"
                                        hx-target="#content">
                                    Aktivér
                                </button>
                            <% } %>

                        <% } %>
                    </td>
                </tr>
            <% }) %>
            </tbody>
        </table>
    </section>

    <div class="pagination">
        <% const totalPages = Math.ceil(total / pageSize); %>

        <% if (page > 1) { %>
            <button
                    hx-get="/customers?page=<%= page - 1 %>&filter=<%= filter %>&search=<%= search %>&sort=<%= sort %>"
                    hx-target="#content">
                Forrige
            </button>
        <% } %>

        <span>Side <%= page %> af <%= totalPages %></span>

        <% if (page < totalPages) { %>
            <button
                    hx-get="/customers?page=<%= page + 1 %>&filter=<%= filter %>&search=<%= search %>&sort=<%= sort %>"
                    hx-target="#content">
                Næste
            </button>
        <% } %>
    </div>


    <div id="content"></div>
</article>
