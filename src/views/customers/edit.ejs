<article class="standard customer-edit-page">
    <h1>Rediger kunde</h1>

    <form hx-patch="/customers/<%= customer._id %>" hx-target="#content">

        <label for="customerNumber">Kundenummer (8 cifre)</label>
        <input type="text"
               id="customerNumber"
               name="customerNumber"
               pattern="\d{8}"
               value="<%= customer.customerNumber %>"
               required>

        <label for="customerName">Navn</label>
        <input type="text" id="customerName" name="customerName" value="<%= customer.customerName %>" required>

        <label for="phoneNumber">Telefon</label>
        <input type="text" id="phoneNumber" name="phoneNumber" value="<%= customer.phoneNumber %>" required>

        <label for="customerEmail">Email</label>
        <input type="email" id="customerEmail" name="customerEmail" value="<%= customer.customerEmail %>" required>

        <label for="cvr">CVR</label>
        <input type="number" id="cvr" name="cvr" value="<%= customer.cvr %>">

        <h2>Kontaktperson</h2>
        <label for="contactPersonName">Navn</label>
        <input type="text" id="contactPersonName" name="contactPerson.name" value="<%= customer.contactPerson.name %>" required>

        <label for="contactPersonPhone">Telefon</label>
        <input type="text" id="contactPersonPhone" name="contactPerson.phone" value="<%= customer.contactPerson.phone %>" required>

        <label for="contactPersonEmail">Email</label>
        <input type="email" id="contactPersonEmail" name="contactPerson.email" value="<%= customer.contactPerson.email %>" required>

        <h2>Adresser</h2>
        <label for="customerAddress">Kundeadresse</label>
        <input type="text" id="customerAddress" name="customerAddress" value="<%= customer.customerAddress %>" required>

        <label for="billingAddress">Faktureringsadresse</label>
        <input type="text" id="billingAddress" name="billingAddress" value="<%= customer.billingAddress %>" required>

        <button type="submit">Gem</button>
    </form>

    <button type="button" class="button-secondary" hx-get="/customers" hx-target="#content">Tilbage</button>
</article>
