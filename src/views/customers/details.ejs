<article class="standard customer-details-page">
    <h1>Kundedetaljer</h1>

    <p><strong>Kundenummer:</strong> <%= customer.customerNumber %></p>
    <p><strong>Navn:</strong> <%= customer.customerName %></p>
    <p><strong>Telefon:</strong> <%= customer.phoneNumber %></p>
    <p><strong>Email:</strong> <%= customer.customerEmail %></p>
    <p><strong>CVR:</strong> <%= customer.cvr %></p>

    <h2>Kontaktperson</h2>
    <p><strong>Navn:</strong> <%= customer.contactPerson.name %></p>
    <p><strong>Telefon:</strong> <%= customer.contactPerson.phone %></p>
    <p><strong>Email:</strong> <%= customer.contactPerson.email %></p>

    <h2>Adresser</h2>
    <p><strong>Kundeadresse:</strong> <%= customer.customerAddress %></p>
    <p><strong>Faktureringsadresse:</strong> <%= customer.billingAddress %></p>

    <!-- NY SEKTION: Lokationer -->
    <h2>Lokationer</h2>

    <button hx-get="/customers/<%= customer._id %>/locations/create"
            hx-target="#content">
        Tilføj lokation
    </button>

    <% const locs = locations || []; %>

    <ul class="location-list">
        <% locs.forEach(loc => { %>
            <li class="card">
                <strong><%= loc.name %></strong><br>
                <%= loc.address %><br>

                <button hx-get="/locations/<%= loc._id %>" hx-target="#content">
                    Detaljer
                </button>

                <button hx-get="/locations/<%= loc._id %>/edit" hx-target="#content">
                    Rediger
                </button>

                <button hx-delete="/locations/<%= loc._id %>"
                        hx-target="#content"
                        hx-confirm="Vil du slette lokationen?">
                    Slet
                </button>
            </li>
        <% }) %>
    </ul>


    <button hx-get="/customers" hx-target="#content">Tilbage</button>
</article>
