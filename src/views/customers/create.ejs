<article class="standard customer-create-page">
    <h1>Opret kunde</h1>

    <form hx-post="/customers"
          hx-target="#content"
          hx-on:error="alert(event.detail.response)">

        <h2>Grundoplysninger</h2>
        
        <label for="customerNumber">Kundenummer (8 cifre)</label>
        <input type="text" id="customerNumber" name="customerNumber" pattern="\d{8}" required>

        <label for="customerName">Kundenavn</label>
        <input type="text" id="customerName" name="customerName" required>

        <label for="phoneNumber">Telefon</label>
        <input type="text" id="phoneNumber" name="phoneNumber" required>

        <label for="customerEmail">Email</label>
        <input type="email" id="customerEmail" name="customerEmail" required>

        <label for="cvr">CVR</label>
        <input type="number" id="cvr" name="cvr">

        <h2>Kontaktperson</h2>

        <label for="contactName">Navn</label>
        <input type="text" id="contactName" name="contactPerson[name]" required>

        <label for="contactPhone">Telefon</label>
        <input type="text" id="contactPhone" name="contactPerson[phone]" required>

        <label for="contactEmail">Email</label>
        <input type="email" id="contactEmail" name="contactPerson[email]" required>

        <h2>Adresser</h2>

        <label for="customerAddress">Kundeadresse</label>
        <input type="text" id="customerAddress" name="customerAddress" required>

        <label for="billingAddress">Faktureringsadresse</label>
        <input type="text" id="billingAddress" name="billingAddress" required>

        <button type="submit">Opret kunde</button>
    </form>

    <button class="button-secondary" hx-get="/customers" hx-target="#content">Tilbage</button>
</article>
