<article class="standard">

    <h1>Rengøringsplaner for kunde</h1>

    <nav class="nav-group">
        <button
                hx-get="/newPlan/plan?customerId=<%= customerId %>"
                hx-target="#content">
            Opret ny rengøringsplan
        </button>
    </nav>

    <% if (plans.length === 0) { %>

        <p>Der er endnu ingen rengøringsplaner for denne kunde.</p>

        <button
                hx-get="/newPlan/plan?customerId=<%= customerId %>"
                hx-target="#content">
            Opret ny rengøringsplan
        </button>

    <% } else { %>

        <table class="responsive-table customer-plans-table">
            <thead>
            <tr>
                <th>Navn</th>
                <th>Pris</th>
                <th>Status</th>
                <th>Handlinger</th>
            </tr>
            </thead>

            <tbody>
            <% plans.forEach(plan => { %>
                <tr>
                    <td data-label="Navn">
                        <strong><%= plan.location.name %></strong><br>
                        <%= plan.name %><br>
                        <small><%= plan.location.address %></small>
                    </td>

                    <td data-label="Pris">
                        <%= plan.totalMonthlyPrice.toLocaleString("da-DK", {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        }) %> kr
                    </td>

                    <td data-label="Status">
                        <% if (plan.isActive) { %>
                            <span class="badge badge-active">Aktiv</span>
                        <% } else { %>
                            <span class="badge badge-inactive">Inaktiv</span>
                        <% } %>
                    </td>

                    <td data-label="Handlinger">

                        <!-- SE PLAN -->
                        <button
                                hx-get="/cleaningPlans/<%= plan._id %>/view"
                                hx-target="#content">
                            Se plan
                        </button>

                        <!-- TILBUD -->
                        <% if (plan.offerId) { %>
                            <button
                                    hx-get="/offers/<%= plan.offerId %>/view"
                                    hx-target="#content">
                                Se tilbud
                            </button>
                        <% } else { %>
                            <button
                                    hx-get="/offers/new?planId=<%= plan._id %>"
                                    hx-target="#content">
                                Opret tilbud
                            </button>
                        <% } %>


                        <!-- KONTRAKT -->
                        <% if (plan.contract) { %>
                            <button
                                    hx-get="/contracts/<%= plan._id %>/list"
                                    hx-target="#content">
                                Se kontrakt
                            </button>
                        <% } else { %>
                            <button
                                    hx-post="/contracts/<%= plan._id %>/generate"
                                    hx-target="#content">
                                Opret kontrakt
                            </button>
                        <% } %>

                        <!-- DEAKTIVER / AKTIVÉR -->
                        <% if (plan.isActive) { %>
                            <button
                                    hx-delete="/cleaningPlans/<%= plan._id %>?context=customerPlans"
                                    hx-target="#content">
                                Deaktiver
                            </button>
                        <% } else { %>
                            <button
                                    hx-patch="/cleaningPlans/<%= plan._id %>?context=customerPlans/reactivate"
                                    hx-target="#content">
                                Aktivér
                            </button>
                        <% } %>

                    </td>
                </tr>
            <% }) %>
            </tbody>
        </table>

        <hr>

    <% } %>

    <nav class="nav-group">
        <button hx-get="/customers" hx-target="#content">
            Tilbage til kunder
        </button>
    </nav>

</article>
