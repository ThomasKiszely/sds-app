<% const sales = canSell(user); %>
<article class="standard customer-plans-page">
    <button type="button" class="back-link" hx-get="/customers/<%= customerId %>/details" hx-target="#content"><%- icon('arrow-left') %> Kunde</button>

    <header class="page-header">
        <div>
            <h1><%= sales ? 'Planer og tilbud' : 'Rengøringsplaner' %></h1>
            <p class="page-sub"><%= sales ? 'Rengøringsplaner for kundens bygninger, med tilbud og kontrakt.' : 'Rengøringsplaner for kundens bygninger.' %></p>
        </div>
        <% if (sales) { %>
            <div class="page-actions">
                <button type="button" class="btn-primary"
                        hx-get="/newPlanDraft/customer?customerId=<%= customerId %>"
                        hx-target="#content">
                    <%- icon('plus') %> Ny rengøringsplan
                </button>
            </div>
        <% } %>
    </header>

    <% if (plans.length === 0) { %>

        <div class="empty-state">
            Der er endnu ingen rengøringsplaner for denne kunde.
            <% if (sales) { %>
                <div style="margin-top: 10px">
                    <button type="button" class="btn-small"
                            hx-get="/newPlanDraft/customer?customerId=<%= customerId %>"
                            hx-target="#content">
                        <%- icon('plus') %> Opret rengøringsplan
                    </button>
                </div>
            <% } %>
        </div>

    <% } else { %>

        <table class="data-table responsive-table customer-plans-table">
            <thead>
            <tr>
                <th>Bygning og plan</th>
                <% if (sales) { %><th class="num">Pr. måned</th><% } %>
                <th>Status</th>
                <% if (sales) { %>
                    <th>Tilbud og kontrakt</th>
                    <th><span class="visually-hidden">Handlinger</span></th>
                <% } %>
            </tr>
            </thead>

            <tbody>
            <% plans.forEach(plan => { %>
                <tr>
                    <td data-label="Bygning">
                        <a href="#" class="row-link" hx-get="/cleaningPlans/<%= plan._id %>/view" hx-target="#content"><%= plan.location.name %></a>
                        <div class="list-row-sub"><%= plan.name %> · <%= plan.location.address %></div>
                    </td>

                    <% if (sales) { %>
                        <td data-label="Pr. måned" class="num">
                            <strong><%= plan.totalMonthlyPrice.toLocaleString("da-DK", {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            }) %> kr.</strong>
                        </td>
                    <% } %>

                    <td data-label="Status">
                        <% if (plan.isActive) { %>
                            <span class="badge badge-active">Aktiv</span>
                        <% } else { %>
                            <span class="badge badge-inactive">Inaktiv</span>
                        <% } %>
                    </td>

                    <% if (sales) { %>
                    <td data-label="Tilbud">
                        <% if (plan.offerId) { %>
                            <button class="btn-small"
                                    hx-get="/offers/<%= plan.offerId %>/view"
                                    hx-target="#content">
                                Se tilbud
                            </button>
                            <% if (plan.contract) { %>
                                <button class="btn-small"
                                        hx-get="/contracts/<%= plan.contract._id %>/view"
                                        hx-target="#content">
                                    <%- icon('file-check') %> Se kontrakt
                                </button>
                            <% } else { %>
                                <span class="badge badge-warn">Ikke accepteret</span>
                            <% } %>
                        <% } else if (plan.contract) { %>
                            <button class="btn-small"
                                    hx-get="/contracts/<%= plan.contract._id %>/view"
                                    hx-target="#content">
                                <%- icon('file-check') %> Se kontrakt
                            </button>
                        <% } else { %>
                            <button class="btn-small"
                                    hx-post="/offers/plans/<%= plan._id %>"
                                    hx-target="#content">
                                Opret tilbud
                            </button>
                        <% } %>
                    </td>

                    <td data-label="Handlinger">
                        <button class="btn-small"
                                hx-get="/newPlan/<%= plan._id %>/editor"
                                hx-target="#content">
                            Rediger plan
                        </button>

                        <% if (plan.isActive) { %>
                            <button class="btn-small btn-ghost"
                                    hx-delete="/cleaningPlans/<%= plan._id %>?context=customerPlans"
                                    hx-target="#content">
                                Deaktiver
                            </button>
                        <% } else { %>
                            <button class="btn-small btn-ghost"
                                    hx-patch="/cleaningPlans/<%= plan._id %>/reactivate?context=customerPlans&customerId=<%= customerId %>"
                                    hx-target="#content">
                                Aktivér
                            </button>
                        <% } %>
                    </td>
                    <% } %>
                </tr>
            <% }) %>
            </tbody>
        </table>

    <% } %>
</article>
