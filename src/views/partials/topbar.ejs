<header class="topbar">
    <div class="topbar-left">
        <button class="hamburger"
                onclick="document.querySelector('.dropdown').classList.toggle('open')">
            ☰ Menu
        </button>
    </div>

    <div class="topbar-right">
        <span class="username"
              hx-get="/me"
              hx-target="#content"
              hx-swap="innerHTML"
              onclick="document.querySelector('.dropdown').classList.remove('open')">
            <%= user.userName %>
        </span>

        <button onclick="htmxBack()">Tilbage</button>
    </div>

    <nav class="dropdown">
        <button hx-get="/indexContent" hx-target="#content"
                onclick="document.querySelector('.dropdown').classList.remove('open')">
            Forside
        </button>

        <button hx-get="/customers" hx-target="#content"
                onclick="document.querySelector('.dropdown').classList.remove('open')">
            Kunder
        </button>

        <button hx-get="/cleaningTaskTemplates/page" hx-target="#content"
                onclick="document.querySelector('.dropdown').classList.remove('open')">
            Opgaver
        </button>

        <% if (user.role === 'admin') { %>
            <button hx-get="/admin" hx-target="#content"
                    onclick="document.querySelector('.dropdown').classList.remove('open')">
                Admin
            </button>
        <% } %>
        <button hx-get="/logout" hx-target="#content"
                onclick="document.querySelector('.dropdown').classList.remove('open')">
            Log ud
            </button>
    </nav>
</header>
