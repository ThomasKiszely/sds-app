<article class="standard location-create-page">
    <h1>Tilføj lokation til <%= customer.customerName %></h1>

    <form
            hx-post="/customers/<%= customerId %>/locations"
            hx-target="#content"
            hx-on:error="alert(event.detail.response)"
    >

        <h2>Lokation</h2>

        <label for="locName">Lokationsnavn</label>
        <input type="text" id="locName" name="name" required>

        <label for="locAddress">Adresse</label>
        <input type="text" id="locAddress" name="address" required>

        <h2>Kontaktperson</h2>

        <label for="contactName">Navn</label>
        <input type="text" id="contactName" name="contactPerson[name]" required>

        <label for="contactPhone">Telefon</label>
        <input type="text" id="contactPhone" name="contactPerson[phone]" required>

        <label for="contactEmail">Email</label>
        <input type="email" id="contactEmail" name="contactPerson[email]" required>

        <button type="submit">Tilføj lokation</button>
    </form>

    <button class="button-secondary"
            hx-get="/customers/<%= customerId %>/details"
            hx-target="#content">
        Tilbage
    </button>
</article>
