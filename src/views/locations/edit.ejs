<article class="standard location-edit-page">
    <h1>Rediger lokation</h1>

    <form
            hx-patch="/locations/<%= location._id %>"
            hx-target="#content"
            hx-on:error="alert(event.detail.response)"
    >

        <h2>Lokation</h2>

        <label for="locName">Lokationsnavn</label>
        <input type="text" id="locName" name="name" value="<%= location.name %>" required>

        <label for="locAddress">Adresse</label>
        <input type="text" id="locAddress" name="address" value="<%= location.address %>" required>

        <h2>Kontaktperson</h2>

        <label for="contactName">Navn</label>
        <input type="text" id="contactName" name="contactPerson[name]" value="<%= location.contactPerson.name %>" required>

        <label for="contactPhone">Telefon</label>
        <input type="text" id="contactPhone" name="contactPerson[phone]" value="<%= location.contactPerson.phone %>" required>

        <label for="contactEmail">Email</label>
        <input type="email" id="contactEmail" name="contactPerson[email]" value="<%= location.contactPerson.email %>" required>

        <button type="submit">Opdater lokation</button>
    </form>

    <button class="button-secondary"
            hx-get="/locations/<%= location._id %>"
            hx-target="#content">
        Tilbage
    </button>
</article>
