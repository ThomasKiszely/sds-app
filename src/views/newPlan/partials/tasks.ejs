<article class="standard wizard-step">
    <h1>Ny prisberegning – Tilføj opgaver</h1>

    <section class="task-nav">
        <button class="button"
                hx-get="/newPlan/tasks/daily?planId=<%= planId %>"
                hx-target="#taskArea">
            Daglig
        </button>

        <button class="button"
                hx-get="/newPlan/tasks/extra?planId=<%= planId %>"
                hx-target="#taskArea">
            Ekstra
        </button>

        <button class="button"
                hx-get="/newPlan/tasks/consumables?planId=<%= planId %>"
                hx-target="#taskArea">
            Forbrugsvare
        </button>

        <button class="button"
                hx-get="/newPlan/tasks/windows?planId=<%= planId %>"
                hx-target="#taskArea">
            Vinduespudsning
        </button>

        <button class="button"
                hx-get="/newPlan/tasks/list?planId=<%= planId %>"
                hx-target="#taskArea">
            Oversigt
        </button>
    </section>

    <section id="taskArea"
             hx-get="/newPlan/tasks/list?planId=<%= planId %>"
             hx-trigger="load"
             hx-target="#taskArea">
    </section>



    <hr>

    <section class="form-actions">
        <button class="button"
                hx-get="/newPlan/offer?planId=<%= planId %>"
                hx-target="#content">
            Næste
        </button>

        <button class="button-secondary"
                hx-get="/newPlan/tasks/list?planId=<%= planId %>"
                hx-target="#taskArea">
            Tilbage til oversigt
        </button>

    </section>
</article>


<script>
    window.currentPlanId = "<%= planId %>";
</script>


