<article class="task-category">
    <h2>Forbrugsvare</h2>

    <!-- Templates (varer man kan tilføje) -->
    <ul class="template-list">
        <% templates.forEach(t => { %>
            <li>
                <strong><%= t.name %></strong>
                <span><%= t.description %></span>

                <button class="button small"
                        hx-get="/newPlan/tasks/create"
                        hx-target="#taskArea"
                        hx-include="[name=planId]"
                        hx-vals='{"templateId": "<%= t._id %>"}'>
                    Tilføj
                </button>
            </li>
        <% }) %>
    </ul>

    <hr>

    <!-- Valgte forbrugsvarer -->
    <h3>Valgte forbrugsvarer (tilkøb)</h3>

    <ul class="task-list">
        <% tasks.forEach(task => { %>
            <li class="task-item">

                <strong><%= task.name %></strong>
                – <%= (task.customPrice ?? 0).toLocaleString("da-DK", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> kr pr stk
                – <%= task.quantity %> stk

                <% if (task.description && task.description.trim().length > 0) { %>
                    <div><em><%= task.description %></em></div>
                <% } %>

                <div class="task-actions">
                    <button class="button small"
                            hx-get="/newPlan/tasks/<%= task._id %>/edit"
                            hx-target="#taskArea">
                        Rediger
                    </button>

                    <button class="button small danger"
                            hx-delete="/newPlan/tasks/<%= task._id %>/delete"
                            hx-target="#taskArea">
                        Slet
                    </button>
                </div>

            </li>
        <% }) %>
    </ul>

    <p><em>Forbrugsvarer faktureres efter forbrug og indgår ikke i planens månedlige pris.</em></p>

</article>
