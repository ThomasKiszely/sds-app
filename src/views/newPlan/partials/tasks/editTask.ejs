<article class="standard wizard-step">

    <h1>Rediger opgave</h1>

    <form
            hx-patch="/newPlan/tasks/<%= task._id %>/update"
            hx-target="#taskArea"
            hx-swap="innerHTML"
            class="task-edit-form"
    >

        <input type="hidden" name="planId" value="<%= task.planId %>">

        <!-- ⭐ Navn -->
        <label for="name">Navn</label>
        <input type="text" id="name" name="name" value="<%= task.name %>" required>

        <!-- ⭐ Rum -->
        <label for="roomName">Rum (valgfrit)</label>
        <input type="text" id="roomName" name="roomName" value="<%= task.roomName %>">

        <!-- ⭐ Dage -->
        <h3>Dage</h3>
        <% Object.keys(days).forEach(key => { %>
            <label class="checkbox-row">
                <input type="checkbox"
                       name="days"
                       value="<%= days[key] %>"
                        <%= task.days.includes(days[key]) ? "checked" : "" %>>
                <span><%= daysLabels[key] %></span>
            </label>
        <% }) %>

        <!-- ⭐ Frekvens -->
        <label for="frequency">Frekvens</label>
        <select id="frequency" name="frequency">
            <% Object.keys(frequencies).forEach(key => { %>
                <option value="<%= frequencies[key] %>"
                        <%= task.frequency === frequencies[key] ? "selected" : "" %>>
                    <%= frequencyLabels[key] %>
                </option>
            <% }) %>
        </select>

        <!-- ⭐ Varighed -->
        <label for="durationPerUnit">Varighed pr enhed (minutter)</label>
        <input type="number"
               id="durationPerUnit"
               name="durationPerUnit"
               value="<%= task.durationPerUnit %>"
               step="0.01" min="0"
               hx-post="/newPlan/tasks/<%= task._id %>/preview"
               hx-trigger="change"
               hx-include="closest form"
               hx-target="#taskPrice">

        <!-- ⭐ Custom pris -->
        <label for="customPrice">Fast pris (valgfrit)</label>
        <input type="number"
               id="customPrice"
               name="customPrice"
               value="<%= task.customPrice ?? '' %>"
               min="0"
               hx-post="/newPlan/tasks/<%= task._id %>/preview"
               hx-trigger="change"
               hx-include="closest form"
               hx-target="#taskPrice">

        <!-- ⭐ Beskrivelse -->
        <label for="description">Beskrivelse</label>
        <textarea id="description" name="description" rows="3"><%= task.description %></textarea>

        <!-- ⭐ Pris -->
        <p>
            <strong>Aktuel pris:</strong>
            <span id="taskPrice">
                <% if (task.monthlyPrice > 0) { %>
                    <%= task.monthlyPrice.toFixed(2) %> kr./måned
                <% } else { %>
                    <%= task.customPrice %> kr pr gang
                <% } %>
            </span>
        </p>

        <button type="submit" class="button">Gem opgave</button>

        <button class="button-secondary"
                hx-get="/newPlan/tasks/list?planId=<%= task.planId %>"
                hx-target="#taskArea">
            Tilbage
        </button>

    </form>

</article>
