<article class="standard wizard-step">

    <h1><%= task._id ? "Rediger opgave" : "Tilføj opgave" %></h1>

    <form
    <% if (task._id) { %>
        hx-patch="/newPlan/tasks/<%= task._id %>/update"
    <% } else { %>
        hx-post="/newPlan/tasks/save"
            <% } %>
        hx-target="#taskArea"
        hx-swap="innerHTML"
        class="task-edit-form"
    >

        <!-- Skjulte felter -->
        <input type="hidden" name="planId" value="<%= task.planId %>">
        <input type="hidden" name="templateId" value="<%= task.templateId %>">
        <input type="hidden" name="category" value="<%= task.category %>">
        <input type="hidden" name="unit" value="<%= task.unit || 'stk' %>">

        <!-- Navn -->
        <label for="name">Navn</label>
        <input type="text" id="name" name="name" value="<%= task.name %>" autocomplete="off" required>

        <!-- Rum -->
        <label for="roomName">Rum (valgfrit)</label>
        <input type="text" id="roomName" name="roomName" value="<%= task.roomName %>" autocomplete="off">

        <!-- Dage -->
        <h3>Dage</h3>

        <button type="button" class="button" data-weekdays="days">
            Daglig (Man–Fre)
        </button>

        <% Object.keys(days).forEach(key => { %>
            <label class="checkbox-row">
                <input type="checkbox"
                       name="days"
                       value="<%= days[key] %>"
                        <%= (task.days || []).includes(days[key]) ? "checked" : "" %>
                       hx-post="<%= task._id ? '/newPlan/tasks/' + task._id + '/preview' : '/newPlan/tasks/previewNew' %>"
                       hx-trigger="change"
                       hx-include="closest form"
                       hx-target="#taskPrice">
                <span><%= daysLabels[key] %></span>
            </label>
        <% }) %>

        <!-- Frekvens -->
        <label for="frequency">Frekvens</label>
        <select id="frequency"
                name="frequency"
                hx-post="<%= task._id ? '/newPlan/tasks/' + task._id + '/preview' : '/newPlan/tasks/previewNew' %>"
                hx-trigger="change"
                hx-include="closest form"
                hx-target="#taskPrice">
            <% Object.keys(frequencies).forEach(key => { %>
                <option value="<%= frequencies[key] %>"
                        <%= task.frequency === frequencies[key] ? "selected" : "" %>>
                    <%= frequencyLabels[key] %>
                </option>
            <% }) %>
        </select>

        <!-- Mængde -->
        <label for="amount">Mængde (<%= task.unit || 'stk' %>)</label>
        <input type="number"
               id="amount"
               name="amount"
               value="<%= task.amount ?? 0 %>"
               step="0.1"
               min="0"
               autocomplete="off"
               hx-post="<%= task._id ? '/newPlan/tasks/' + task._id + '/preview' : '/newPlan/tasks/previewNew' %>"
               hx-trigger="change, keyup delay:300ms"
               hx-include="closest form"
               hx-target="#taskPrice">

        <!-- Varighed -->
        <label for="durationPerUnit">Varighed pr enhed (minutter)</label>
        <input type="number"
               id="durationPerUnit"
               name="durationPerUnit"
               value="<%= task.durationPerUnit %>"
               step="0.01"
               min="0"
               autocomplete="off"
               hx-post="<%= task._id ? '/newPlan/tasks/' + task._id + '/preview' : '/newPlan/tasks/previewNew' %>"
               hx-trigger="change, keyup delay:300ms"
               hx-include="closest form"
               hx-target="#taskPrice">

        <!-- Fast pris -->
        <label for="customPrice">Fast pris (valgfrit)</label>
        <input type="number"
               id="customPrice"
               name="customPrice"
               value="<%= task.customPrice ?? '' %>"
               min="0"
               autocomplete="off"
               hx-post="<%= task._id ? '/newPlan/tasks/' + task._id + '/preview' : '/newPlan/tasks/previewNew' %>"
               hx-trigger="change, keyup delay:300ms"
               hx-include="closest form"
               hx-target="#taskPrice">

        <!-- Antal (kun consumables) -->
        <% if (task.category === categoryTypes.consumables) { %>
            <label for="quantity">Antal (stk)</label>
            <input type="number"
                   id="quantity"
                   name="quantity"
                   value="<%= task.quantity ?? 1 %>"
                   min="1"
                   autocomplete="off"
                   hx-post="<%= task._id ? '/newPlan/tasks/' + task._id + '/preview' : '/newPlan/tasks/previewNew' %>"
                   hx-trigger="change, keyup delay:300ms"
                   hx-include="closest form"
                   hx-target="#taskPrice">
        <% } %>

        <!-- Beskrivelse -->
        <label for="description">Beskrivelse</label>
        <textarea id="description" name="description" rows="3" autocomplete="off"><%= task.description %></textarea>

        <!-- Pris -->
        <p>
            <strong>Aktuel pris:</strong>
            <span id="taskPrice">

                <% if (task.category === categoryTypes.consumables) { %>

                    <%= (task.customPrice ?? 0).toFixed(2) %> kr pr stk – <%= task.quantity ?? 1 %> stk

                <% } else if (task.monthlyPrice && task.monthlyPrice > 0) { %>

                    <%= task.monthlyPrice.toFixed(2) %> kr./måned

                <% } else if (task.pricePerTime && task.pricePerTime > 0) { %>

                    <%= task.pricePerTime.toFixed(2) %> kr pr gang

                <% } else { %>

                    <%= (task.customPrice ?? 0).toFixed(2) %> kr

                <% } %>

            </span>
        </p>

        <button type="submit" class="button">Gem opgave</button>

        <button type="button"
                class="button-secondary"
                hx-get="/newPlan/tasks/list?planId=<%= task.planId %>"
                hx-target="#taskArea">
            Tilbage
        </button>

    </form>

</article>
