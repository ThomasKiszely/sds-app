<article class="standard wizard-step">

    <h1>Rediger opgave</h1>

    <section>
        <h2><%= task.name %></h2>
        <p>Kategori: <strong><%= categoryLabels[task.category] %></strong></p>
    </section>

    <!-- Prisvisning -->
    <section>
        <h3>Pris</h3>
        <p id="taskPrice"><%= task.totalPrice %> kr.</p>
    </section>

    <form
            hx-patch="/newPlan/tasks/<%= task._id %>/update"
            hx-target="#taskArea"
            hx-swap="innerHTML"
            class="edit-task-form"
    >

        <!-- Dage (skjules for forbrugsvare) -->
        <% if (task.category !== categoryTypes.consumables) { %>
            <section>
                <h3>Dage</h3>

                <% Object.keys(days).forEach(key => { %>
                    <label>
                        <input
                                type="checkbox"
                                name="days"
                                value="<%= days[key] %>"
                                <%= task.days.includes(days[key]) ? "checked" : "" %>

                                hx-post="/newPlan/tasks/<%= task._id %>/preview"
                                hx-trigger="change"
                                hx-target="#taskPrice"
                                hx-swap="innerHTML"
                        >
                        <%= daysLabels[key] %>
                    </label><br>
                <% }) %>
            </section>
            <hr>
        <% } %>

        <!-- Dynamiske felter baseret på unit -->
        <% if (task.unit === units.m2 || task.unit === units.lbm) { %>

            <section>
                <h3><%= unitsLabels[task.unit] %></h3>
                <input
                        type="number"
                        name="amount"
                        value="<%= task.amount %>"
                        min="0"

                        hx-post="/newPlan/tasks/<%= task._id %>/preview"
                        hx-trigger="change"
                        hx-target="#taskPrice"
                        hx-swap="innerHTML"
                        oninput="updateDuration()"
                >
            </section>
            <hr>

        <% } else if (task.unit === units.stk) { %>

            <section>
                <h3><%= unitsLabels[task.unit] %></h3>
                <input
                        type="number"
                        name="quantity"
                        value="<%= task.quantity %>"
                        min="1"

                        hx-post="/newPlan/tasks/<%= task._id %>/preview"
                        hx-trigger="change"
                        hx-target="#taskPrice"
                        hx-swap="innerHTML"
                        oninput="updateDuration()"
                >
            </section>
            <hr>

        <% } %>

        <!-- Frekvens -->
        <% if (task.category !== categoryTypes.consumables) { %>
            <section>
                <h3>Frekvens</h3>
                <select
                        name="frequency"

                        hx-post="/newPlan/tasks/<%= task._id %>/preview"
                        hx-trigger="change"
                        hx-target="#taskPrice"
                        hx-swap="innerHTML"
                >
                    <% Object.keys(frequencies).forEach(key => { %>
                        <option
                                value="<%= frequencies[key] %>"
                                <%= task.frequency === frequencies[key] ? "selected" : "" %>
                        >
                            <%= frequencyLabels[key] %>
                        </option>
                    <% }) %>
                </select>
            </section>
            <hr>
        <% } %>

        <!-- Beskrivelse -->
        <section>
            <h3>Beskrivelse</h3>
            <textarea
                    name="description"
                    rows="3"
                    hx-post="/newPlan/tasks/<%= task._id %>/preview"
                    hx-trigger="change"
                    hx-target="#taskPrice"
                    hx-swap="innerHTML"
            ><%= task.description %></textarea>
        </section>

        <hr>

        <!-- Varighed pr enhed -->
        <section>
            <h3>Varighed (pr enhed i minutter)</h3>
            <input
                    type="number"
                    name="durationPerUnit"
                    value="<%= task.durationPerUnit %>"
                    step="0.01"
                    min="0"
                    oninput="updateDuration()"
            >
        </section>

        <hr>

        <!-- Samlet varighed -->
        <section>
            <h3>Varighed pr gang</h3>
            <p id="taskDuration">
                <%
                let totalDuration = task.durationPerUnit;

                if (task.unit === units.stk) {
                    totalDuration = task.durationPerUnit * task.quantity;
                } else if (task.unit === units.m2 || task.unit === units.lbm) {
                    totalDuration = task.durationPerUnit * task.amount;
                }
                %>

                <%= totalDuration %> min
            </p>
        </section>

        <hr>

        <!-- Actions -->
        <section class="form-actions">

            <button type="submit"
                    class="button"
                    hx-include="[name=planId]">
                Gem opgave
            </button>

            <%
            const categoryRoute = {
                daily: "daily",
                extra: "extra",
                consumables: "consumables",
                windows: "windows"
            }[task.category];
            %>

            <button
                    class="button-secondary"
                    hx-get="/newPlan/tasks/<%= categoryRoute %>?planId=<%= task.planId %>"
                    hx-target="#taskArea">
                Tilbage
            </button>

        </section>

    </form>

</article>

<script>
    function updateDuration() {
        const duration = Number(document.querySelector('[name="durationPerUnit"]').value) || 0;
        const amount = Number(document.querySelector('[name="amount"]')?.value) || 0;
        const quantity = Number(document.querySelector('[name="quantity"]')?.value) || 0;

        let total = duration;

        <% if (task.unit === units.stk) { %>
        total = duration * quantity;
        <% } else if (task.unit === units.m2 || task.unit === units.lbm) { %>
        total = duration * amount;
        <% } %>

        document.querySelector('#taskDuration').innerText = total + " min";
    }
</script>
