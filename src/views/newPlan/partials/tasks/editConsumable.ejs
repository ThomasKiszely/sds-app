<article class="task-edit">

    <h2><%= task._id ? "Rediger forbrugsvare" : "Tilføj forbrugsvare" %></h2>

    <form
    <% if (task._id) { %>
        hx-patch="/newPlan/tasks/<%= task._id %>/update"
    <% } else { %>
        hx-post="/newPlan/tasks/save"
            <% } %>
        hx-target="#taskArea"
        hx-swap="innerHTML"
        class="task-edit-form"
    >

        <input type="hidden" name="planId" value="<%= task.planId %>">
        <input type="hidden" name="templateId" value="<%= task.templateId %>">

        <div class="form-group">
            <label>Navn</label>
            <input type="text" name="name" value="<%= task.name %>" required>
        </div>

        <div class="form-group">
            <label>Beskrivelse</label>
            <textarea name="description"><%= task.description %></textarea>
        </div>

        <div class="form-group">
            <label>Pris pr stk</label>
            <input type="number" name="customPrice" value="<%= task.customPrice %>" step="0.01" required>
        </div>

        <div class="form-group">
            <label>Antal</label>
            <input type="number" name="quantity" value="<%= task.amount %>" min="1" required>
        </div>

        <!-- NYT: Frekvens for consumables -->
        <div class="form-group">
            <label>Frekvens</label>
            <select name="frequency" required>
                <% for (const key in frequencies) { %>
                    <% if (frequencyMultipliers[key] >= 0) { %>
                        <option value="<%= key %>" <%= task.frequency === key ? "selected" : "" %>>
                            <%= frequencyLabels[key] %>
                        </option>
                    <% } %>
                <% } %>
            </select>
        </div>
        <!-- SLUT NYT -->

        <hr>

        <button class="button">Gem</button>

        <button class="button-secondary"
                hx-get="/newPlan/tasks/consumables?planId=<%= task.planId %>"
                hx-target="#taskArea">
            Tilbage
        </button>

    </form>

</article>
