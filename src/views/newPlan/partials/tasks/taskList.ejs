<article class="task-list">

        <!-- ⭐ Samlet månedlig pris -->
        <h3>Samlet månedlig pris</h3>
        <p class="plan-total"><strong><%= monthlyTotal.toFixed(2) %> kr./måned</strong></p>

        <hr>

        <h3>Valgte opgaver</h3>

        <%
        // ⭐ Opdel tasks i sektioner

        // Faste opgaver i rum (monthlyPrice > 0)
        const roomTasks = tasks.filter(t =>
                t.roomName &&
                t.roomName.trim() !== "" &&
                t.monthlyPrice > 0
        );

        // Faste opgaver uden rum (monthlyPrice > 0)
        const noRoomTasks = tasks.filter(t =>
                (!t.roomName || t.roomName.trim() === "") &&
                t.monthlyPrice > 0
        );

        // Ad hoc / vinduer / efter aftale (monthlyPrice = 0, customPrice > 0)
        const adHocTasks = tasks.filter(t =>
                t.monthlyPrice === 0 &&
                t.customPrice != null &&
                t.category !== categoryTypes.consumables
        );

        // Forbrugsvarer
        const consumables = tasks.filter(t =>
                t.category === categoryTypes.consumables
        );
        %>

        <!-- ⭐ RUM -->
        <% if (roomTasks.length > 0) { %>
                <section>
                        <h3>Rum</h3>

                        <%
                                // Gruppér opgaver efter rum
                                const rooms = {};
                                roomTasks.forEach(t => {
                                        if (!rooms[t.roomName]) rooms[t.roomName] = [];
                                        rooms[t.roomName].push(t);
                                });
                        %>

                        <% Object.keys(rooms).forEach(room => {
                                const tasksInRoom = rooms[room];
                                const programCode = grouped[room]?.programCode || "";
                        %>

                        <h4><%= room %> (<%= programCode %>)</h4>

                        <ul class="task-list-room">
                                <% tasksInRoom.forEach(task => { %>
                                        <li class="task-item">

                                                <div class="task-info">
                                                        <strong><%= task.name %></strong>

                                                        <!-- Dage + frekvens -->
                                                        <div class="task-days">
                                                                <% (task.days || []).forEach(d => { %>
                                                                        <%= daysLabels[d] %>
                                                                <% }) %>
                                                                – <%= frequencyLabels[task.frequency] %>
                                                        </div>

                                                        <!-- ⭐ Pris pr måned -->
                                                        <div class="task-meta">
                                                                Pris pr måned:
                                                                <strong><%= task.monthlyPrice.toFixed(2) %> kr.</strong>
                                                        </div>

                                                        <% if (task.description && task.description.trim().length > 0) { %>
                                                                <div class="task-description"><em><%= task.description %></em></div>
                                                        <% } %>
                                                </div>

                                                <div class="task-actions">
                                                        <button class="button small"
                                                                hx-get="/newPlan/tasks/<%= task._id %>/edit"
                                                                hx-target="#taskArea">
                                                                Rediger
                                                        </button>

                                                        <button class="button small danger"
                                                                hx-delete="/newPlan/tasks/<%= task._id %>/delete"
                                                                hx-target="#taskArea">
                                                                Slet
                                                        </button>
                                                </div>

                                        </li>
                                <% }) %>
                        </ul>

                        <% }) %>
                </section>

                <hr>
        <% } %>

        <!-- ⭐ OPGAVER UDEN RUM (faste opgaver) -->
        <% if (noRoomTasks.length > 0) { %>
                <section>
                        <h3>Opgaver uden rum</h3>

                        <ul>
                                <% noRoomTasks.forEach(t => { %>
                                        <li class="task-item">

                                                <div class="task-info">
                                                        <strong><%= t.name %></strong>
                                                        – <%= frequencyLabels[t.frequency] %>

                                                        <!-- ⭐ Pris pr måned -->
                                                        – <%= t.monthlyPrice.toFixed(2) %> kr./måned

                                                        <% if (t.description && t.description.trim().length > 0) { %>
                                                                <div><em><%= t.description %></em></div>
                                                        <% } %>
                                                </div>

                                                <div class="task-actions">
                                                        <button class="button small"
                                                                hx-get="/newPlan/tasks/<%= t._id %>/edit"
                                                                hx-target="#taskArea">
                                                                Rediger
                                                        </button>

                                                        <button class="button small danger"
                                                                hx-delete="/newPlan/tasks/<%= t._id %>/delete"
                                                                hx-target="#taskArea">
                                                                Slet
                                                        </button>
                                                </div>

                                        </li>
                                <% }) %>
                        </ul>
                </section>

                <hr>
        <% } %>

        <!-- ⭐ AD HOC / VINDUER / EFTER AFTALE -->
        <% if (adHocTasks.length > 0) { %>
                <section>
                        <h3>Pris pr gang – Ad hoc / Vinduer / Efter aftale</h3>

                        <ul>
                                <% adHocTasks.forEach(t => { %>
                                        <li class="task-item">

                                                <div class="task-info">
                                                        <strong><%= t.name %></strong>
                                                        – <%= t.customPrice %> kr pr gang

                                                        <% if (t.description && t.description.trim().length > 0) { %>
                                                                <div><em><%= t.description %></em></div>
                                                        <% } %>
                                                </div>

                                                <div class="task-actions">
                                                        <button class="button small"
                                                                hx-get="/newPlan/tasks/<%= t._id %>/edit"
                                                                hx-target="#taskArea">
                                                                Rediger
                                                        </button>

                                                        <button class="button small danger"
                                                                hx-delete="/newPlan/tasks/<%= t._id %>/delete"
                                                                hx-target="#taskArea">
                                                                Slet
                                                        </button>
                                                </div>

                                        </li>
                                <% }) %>
                        </ul>
                </section>

                <hr>
        <% } %>

        <!-- ⭐ FORBRUGSVARER -->
        <% if (consumables.length > 0) { %>
                <section>
                        <h3>Tilkøb – Forbrugsvarer</h3>

                        <ul>
                                <% consumables.forEach(c => { %>
                                        <li class="task-item">

                                                <div class="task-info">
                                                        <strong><%= c.name %></strong>
                                                        – <%= c.customPrice %> kr pr stk
                                                        – <%= c.quantity %> stk

                                                        <% if (c.description && c.description.trim().length > 0) { %>
                                                                <div><em><%= c.description %></em></div>
                                                        <% } %>
                                                </div>

                                                <div class="task-actions">
                                                        <button class="button small"
                                                                hx-get="/newPlan/tasks/<%= c._id %>/edit"
                                                                hx-target="#taskArea">
                                                                Rediger
                                                        </button>

                                                        <button class="button small danger"
                                                                hx-delete="/newPlan/tasks/<%= c._id %>/delete"
                                                                hx-target="#taskArea">
                                                                Slet
                                                        </button>
                                                </div>

                                        </li>
                                <% }) %>
                        </ul>

                        <p><em>Faktureres efter forbrug</em></p>
                </section>
        <% } %>

</article>
