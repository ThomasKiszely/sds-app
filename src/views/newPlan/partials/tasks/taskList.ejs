<article class="task-list">

        <h3>Samlet månedlig pris</h3>
        <p class="plan-total"><strong><%= monthlyTotal %> kr./måned</strong></p>

        <hr>

        <h3>Valgte opgaver</h3>

        <% for (const roomName in grouped) { %>
                <section class="task-room-group">

                        <!-- ⭐ Rum-navn + programkode -->
                        <h4>
                                <strong><%= roomName %></strong>
                                <span class="program-code">(Kode: <%= grouped[roomName].programCode %>)</span>
                        </h4>

                        <!-- ⭐ Bundle-knapper -->
                        <div class="task-actions">
                                <button class="button small"
                                        hx-get="/newPlan/tasks/dailyBundle/edit?planId=<%= planId %>&roomName=<%= roomName %>"
                                        hx-target="#taskArea"
                                        hx-swap="innerHTML">
                                        Rediger bundle
                                </button>

                                <button class="button small danger"
                                        hx-delete="/newPlan/tasks/dailyBundle/delete?planId=<%= planId %>&roomName=<%= roomName %>"
                                        hx-target="#taskArea">
                                        Slet opgaver
                                </button>
                        </div>

                        <ul class="task-list-room">

                                <!-- ⭐ SDS-opgaver -->
                                <% grouped[roomName].sds.forEach(task => { %>
                                        <li class="task-item sds-task">

                                                <div class="task-info">
                                                        <strong><%= task.name %></strong>

                                                        <div class="task-days">
                                                                <% (task.days || []).forEach(d => { %>
                                                                        <%= daysLabels[d] %>
                                                                <% }) %>
                                                                – <%= frequencyLabels[task.frequency] %>
                                                        </div>

                                                        <div class="task-meta">
                                                                Pris pr måned:
                                                                <strong><%= task.monthlyPrice %> kr.</strong>
                                                        </div>

                                                        <% if (task.description && task.description.trim().length > 0) { %>
                                                                <div class="task-description"><em><%= task.description %></em></div>
                                                        <% } %>
                                                </div>

                                        </li>
                                <% }) %>

                                <!-- ⭐ Øvrige opgaver -->
                                <% grouped[roomName].other.forEach(task => { %>
                                        <li class="task-item other-task">

                                                <div class="task-info">
                                                        <strong><%= task.name %></strong>

                                                        <% if (task.category !== categoryTypes.consumables) { %>
                                                                <div class="task-days">
                                                                        <% (task.days || []).forEach(d => { %>
                                                                                <%= daysLabels[d] %>
                                                                        <% }) %>
                                                                        – <%= frequencyLabels[task.frequency] %>
                                                                </div>
                                                        <% } %>

                                                        <div class="task-meta">
                                                                Pris pr måned:
                                                                <strong><%= task.monthlyPrice %> kr.</strong>
                                                        </div>

                                                        <% if (task.description && task.description.trim().length > 0) { %>
                                                                <div class="task-description"><em><%= task.description %></em></div>
                                                        <% } %>
                                                </div>

                                                <div class="task-actions">
                                                        <button class="button small"
                                                                hx-get="/newPlan/tasks/<%= task._id %>/edit"
                                                                hx-target="#taskArea">
                                                                Rediger
                                                        </button>

                                                        <button class="button small danger"
                                                                hx-delete="/newPlan/tasks/<%= task._id %>/delete"
                                                                hx-target="#taskArea">
                                                                Slet
                                                        </button>
                                                </div>

                                        </li>
                                <% }) %>

                        </ul>

                </section>
        <% } %>

</article>
