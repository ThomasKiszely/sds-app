<article class="task-list">

        <h3>Samlet månedlig pris</h3>
        <p class="plan-total"><strong><%= monthlyTotal %> kr./måned</strong></p>

        <hr>

        <h3>Valgte opgaver</h3>

        <ul>
                <% tasks.forEach(task => { %>
                        <li class="task-item">

                                <!-- Navn + kategori -->
                                <strong><%= task.name || "Ukendt opgave" %></strong>
                                <span>(<%= categoryLabels[task.category] %>)</span>

                                <!-- ⭐ Lokale + programkode -->
                                <div class="task-room">
                                        <strong>Lokale:</strong> <%= task.roomName %>
                                        – <strong>Kode:</strong> <%= task.programCode %>
                                </div>


                                <!-- Mængde -->
                                <% if (task.unit === units.m2 || task.unit === units.lbm) { %>
                                        – <%= task.amount %> <%= unitsLabels[task.unit] %>
                                <% } else if (task.unit === units.stk) { %>
                                        – <%= task.quantity %> <%= unitsLabels[task.unit] %>
                                <% } %>

                                <!-- Dage + frekvens (kun hvis ikke consumables) -->
                                <% if (task.category !== categoryTypes.consumables) { %>
                                        –
                                        <% (task.days || []).forEach(d => { %>
                                                <%= daysLabels[d] %>
                                        <% }) %>

                                        – <%= frequencyLabels[task.frequency] %>
                                <% } %>

                                <!-- Pris pr måned -->
                                <div class="task-meta">

                                        <% if (task.customPrice != null) { %>
                                                <div>Fast pris pr gang: <strong><%= task.customPrice %> kr.</strong></div>
                                        <% } %>

                                        <div>Pris pr måned: <strong><%= task.monthlyPrice %> kr.</strong></div>
                                </div>

                                <!-- Beskrivelse -->
                                <% if (task.description && task.description.trim().length > 0) { %>
                                        <div class="task-description"><em><%= task.description %></em></div>
                                <% } %>

                                <!-- Knapper -->
                                <button class="button small"
                                        hx-get="/newPlan/tasks/<%= task._id %>/edit"
                                        hx-target="#taskArea">
                                        Rediger
                                </button>

                                <button class="button small danger"
                                        hx-delete="/newPlan/tasks/<%= task._id %>/delete"
                                        hx-target="#taskArea">
                                        Slet
                                </button>

                        </li>
                <% }) %>
        </ul>

</article>

