<article class="task-list">

        <!-- ⭐ Samlet månedlig pris -->
        <h3>Samlet månedlig pris</h3>
        <p class="plan-total">
                <strong>
                        <%= monthlyTotal.toLocaleString("da-DK", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> kr./måned
                </strong>
        </p>

        <hr>

        <h3>Valgte opgaver</h3>

        <!-- ⭐ 1: SDS‑bundles pr rum -->
        <% for (const roomName in grouped) { %>
                <section class="task-room-group">

                        <h4>
                                <strong><%= roomName %></strong>
                                <span class="program-code">(Kode: <%= grouped[roomName].programCode %>)</span>
                        </h4>

                        <ul class="task-list-room">
                                <% grouped[roomName].sds.forEach(task => { %>
                                        <li class="task-item sds-task">
                                                <div class="task-info">
                                                        <strong><%= task.name %></strong>

                                                        <div class="task-days">
                                                                <% (task.days || []).forEach(d => { %>
                                                                        <%= daysLabels[d] %>
                                                                <% }) %>
                                                                – <%= frequencyLabels[task.frequency] %>
                                                        </div>

                                                        <div class="task-meta">
                                                                Pris pr måned:
                                                                <strong>
                                                                        <%= task.monthlyPrice.toLocaleString("da-DK", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> kr
                                                                </strong>
                                                        </div>

                                                        <% if (task.description && task.description.trim().length > 0) { %>
                                                                <div class="task-description"><em><%= task.description %></em></div>
                                                        <% } %>
                                                </div>
                                        </li>
                                <% }) %>
                        </ul>

                        <div class="task-actions">
                                <button class="button small"
                                        hx-get="/newPlan/tasks/dailyBundle/edit?planId=<%= planId %>&roomName=<%= roomName %>"
                                        hx-target="#taskArea"
                                        hx-swap="innerHTML">
                                        Rediger bundle
                                </button>

                                <button class="button small danger"
                                        hx-delete="/newPlan/tasks/dailyBundle/delete?planId=<%= planId %>&roomName=<%= roomName %>"
                                        hx-target="#taskArea">
                                        Slet bundle
                                </button>
                        </div>

                </section>

                <hr>
        <% } %>

        <!-- ⭐ 2: ALLE ANDRE OPGAVER (uden rum eller med rum, men ikke SDS) -->
        <%
        const otherTasks = tasks.filter(t =>
                !grouped[t.roomName] && t.category !== categoryTypes.consumables
        );
        %>

        <% if (otherTasks.length > 0) { %>
                <section>
                        <h3>Øvrige opgaver</h3>

                        <ul>
                                <% otherTasks.forEach(t => { %>
                                        <li class="task-item">
                                                <div class="task-info">

                                                        <!-- ⭐ Navn -->
                                                        <strong><%= t.name %></strong>

                                                        <!-- ⭐ Frekvens -->
                                                        <% if (t.frequency) { %>
                                                                – <%= frequencyLabels[t.frequency] %>
                                                        <% } %>

                                                        <!-- ⭐ Pris -->
                                                        <%
                                                                // ⭐ KUN vis recalc-priser
                                                                const price =
                                                                        t.monthlyPrice > 0
                                                                                ? t.monthlyPrice
                                                                                : t.pricePerTime;
                                                        %>

                                                        – <%= price.toLocaleString("da-DK", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> kr

                                                        <% if (t.monthlyPrice > 0) { %>
                                                                / måned
                                                        <% } else { %>
                                                                pr gang
                                                        <% } %>

                                                        <!-- ⭐ Beskrivelse -->
                                                        <% if (t.description && t.description.trim().length > 0) { %>
                                                                <div><em><%= t.description %></em></div>
                                                        <% } %>

                                                </div>

                                                <div class="task-actions">
                                                        <button class="button small"
                                                                hx-get="/newPlan/tasks/<%= t._id %>/edit"
                                                                hx-target="#taskArea">
                                                                Rediger
                                                        </button>

                                                        <button class="button small danger"
                                                                hx-delete="/newPlan/tasks/<%= t._id %>/delete"
                                                                hx-target="#taskArea">
                                                                Slet
                                                        </button>
                                                </div>
                                        </li>
                                <% }) %>
                        </ul>
                </section>

                <hr>
        <% } %>

        <!-- ⭐ 3: Forbrugsvarer -->
        <% const consumables = tasks.filter(t => t.category === categoryTypes.consumables); %>

        <% if (consumables.length > 0) { %>
                <section>
                        <h3>Tilkøb – Forbrugsvarer</h3>

                        <ul>
                                <% consumables.forEach(c => { %>
                                        <li class="task-item">
                                                <div class="task-info">
                                                        <strong><%= c.name %></strong>
                                                        – <%= (c.customPrice ?? 0).toLocaleString("da-DK", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> kr pr stk
                                                        – <%= c.quantity %> stk

                                                        <% if (c.description && c.description.trim().length > 0) { %>
                                                                <div><em><%= c.description %></em></div>
                                                        <% } %>
                                                </div>

                                                <div class="task-actions">
                                                        <button class="button small"
                                                                hx-get="/newPlan/tasks/<%= c._id %>/edit"
                                                                hx-target="#taskArea">
                                                                Rediger
                                                        </button>

                                                        <button class="button small danger"
                                                                hx-delete="/newPlan/tasks/<%= c._id %>/delete"
                                                                hx-target="#taskArea">
                                                                Slet
                                                        </button>
                                                </div>
                                        </li>
                                <% }) %>
                        </ul>

                        <p><em>Faktureres efter forbrug</em></p>
                </section>
        <% } %>

</article>
