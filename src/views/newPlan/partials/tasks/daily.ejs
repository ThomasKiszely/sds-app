<article class="task-category">
    <h2>Daglige opgaver</h2>


    <button
            class="button"
            hx-get="/newPlan/tasks/dailyBundle/create?planId=<%= plan._id %>"
            hx-target="#taskArea"
            hx-swap="innerHTML"
    >
        Opret daglig opgave (bundle)
    </button>

    <ul class="template-list">
        <% templates.forEach(t => { %>
            <li>
                <strong><%= t.name %></strong>
                <span><%= t.description %></span>

                <button class="button small"
                        hx-post="/newPlan/tasks/add"
                        hx-target="#taskArea"
                        hx-include="[name=planId]"
                        hx-vals='{"templateId": "<%= t._id %>"}'>
                    Tilføj
                </button>
            </li>
        <% }) %>
    </ul>

    <hr>

    <h3>Valgte opgaver</h3>

    <%
    // Find de tre SDS-opgaver
    const soignering = tasks.find(t => t.category === categoryTypes.daily && t.name.toLowerCase().includes("soignering"));
    const gulv = tasks.find(t => t.category === categoryTypes.daily && t.name.toLowerCase().includes("gulv"));
    const inventar = tasks.find(t => t.category === categoryTypes.daily && t.name.toLowerCase().includes("inventar"));

    const hasBundle = soignering && gulv && inventar;
    %>

    <% if (hasBundle) { %>
        <button
                class="button"
                hx-get="/newPlan/tasks/dailyBundle/edit?planId=<%= plan._id %>"
                hx-target="#taskArea"
                hx-swap="innerHTML"
        >
            Rediger daglig opgave (bundle)
        </button>
    <% } %>


    <ul class="task-list">
        <% tasks.forEach(task => { %>
            <li>
                <%= task.name %> – <%= task.totalPrice %> kr.
            </li>
        <% }) %>
    </ul>

</article>
