<article class="task-category">
    <h2>Daglige opgaver</h2>

    <!-- ⭐ Opret bundle -->
    <button
            class="button"
            hx-get="/newPlan/tasks/dailyBundle/create?planId=<%= plan._id %>"
            hx-target="#taskArea"
            hx-swap="innerHTML"
    >
        Opret daglig opgave (bundle)
    </button>

    <!-- ⭐ Templates -->
    <ul class="template-list">
        <% templates.forEach(t => { %>
            <li>
                <strong><%= t.name %></strong>
                <span><%= t.description %></span>

                <button class="button small"
                        hx-post="/newPlan/tasks/add"
                        hx-target="#taskArea"
                        hx-include="[name=planId]"
                        hx-vals='{"templateId": "<%= t._id %>"}'>
                    Tilføj
                </button>
            </li>
        <% }) %>
    </ul>

    <hr>

    <h3>Valgte opgaver</h3>

    <!-- ⭐ Rumbaseret visning -->
    <% for (const roomName in grouped) { %>
        <section class="task-room-group">

            <!-- ⭐ Rum + programkode -->
            <h4>
                <strong><%= roomName %></strong>
                <span class="program-code">(Kode: <%= grouped[roomName].programCode %>)</span>
            </h4>

            <ul class="task-list-room">

                <!-- ⭐ SDS-opgaver -->
                <% grouped[roomName].sds.forEach(task => { %>
                    <li class="task-item sds-task">

                        <!-- ⭐ Tekst -->
                        <div class="task-info">
                            <strong><%= task.name %></strong>

                            <div class="task-days">
                                <% (task.days || []).forEach(d => { %>
                                    <%= daysLabels[d] %>
                                <% }) %>
                                – <%= frequencyLabels[task.frequency] %>
                            </div>

                            <div class="task-meta">
                                Pris pr måned:
                                <strong><%= task.monthlyPrice %> kr.</strong>
                            </div>
                        </div>

                        <!-- ⭐ Knapper -->
                        <div class="task-actions">
                            <button class="button small"
                                    hx-get="/newPlan/tasks/dailyBundle/edit?planId=<%= plan._id %>&roomName=<%= roomName %>"
                                    hx-target="#taskArea"
                                    hx-swap="innerHTML">
                                Rediger bundle
                            </button>

                            <button class="button small danger"
                                    hx-delete="/newPlan/tasks/dailyBundle/delete?planId=<%= plan._id %>&roomName=<%= roomName %>"
                                    hx-target="#taskArea">
                                Slet opgaver
                            </button>
                        </div>

                    </li>
                <% }) %>

            </ul>

        </section>
    <% } %>

</article>
