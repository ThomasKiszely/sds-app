<article class="standard wizard-step">

    <h1>Rediger daglig opgave – Soignering, Gulv, Inventar</h1>

    <form
            hx-post="/newPlan/tasks/dailyBundle/update"
            hx-target="#taskArea"
            hx-swap="innerHTML"
            class="daily-bundle-edit-form"
    >
        <input type="hidden" name="planId" value="<%= tasks[0].planId %>">

        <!-- FÆLLES FELTER -->
        <section>
            <h2>Fælles oplysninger</h2>

            <label for="roomName">Lokale</label>
            <input type="text" id="roomName" name="roomName"
                   value="<%= tasks[0].roomName %>" required>

            <label for="amount">Areal (m²)</label>
            <input type="number" id="amount" name="amount"
                   value="<%= tasks[0].amount %>" min="0" required>

            <label>Bemærkninger for rummet</label>
            <textarea name="roomNotes" rows="3"><%= existingNotes.join("\n") %></textarea>
        </section>

        <hr>

        <!-- INDIVIDUELLE SDS-OPGAVER -->
        <% tasks.forEach(task => { %>
            <section>
                <h2><%= task.name %></h2>

                <input type="hidden" name="taskIds[]" value="<%= task._id %>">

                <!-- Varighed -->
                <label>Varighed pr enhed (minutter)</label>
                <input type="number"
                       name="duration_<%= task._id %>"
                       value="<%= task.durationPerUnit %>"
                       step="0.01" min="0"
                       hx-post="/newPlan/tasks/preview/<%= task._id %>"
                       hx-trigger="change"
                       hx-include="closest form"
                       hx-target="#price_<%= task._id %>">

                <!-- Fast pris -->
                <label>Fast pris (valgfrit)</label>
                <input type="number"
                       name="custom_<%= task._id %>"
                       value="<%= task.customPrice ?? '' %>"
                       min="0"
                       hx-post="/newPlan/tasks/preview/<%= task._id %>"
                       hx-trigger="change"
                       hx-include="closest form"
                       hx-target="#price_<%= task._id %>">

                <!-- DAGE (INDIVIDUELT) -->
                <label>Dage</label>

                <button type="button"
                        class="button"
                        data-weekdays="days_<%= task._id %>">
                    Daglig (Man–Fre)
                </button>

                <% Object.keys(days).forEach(key => { %>
                    <label class="checkbox-row">
                        <input
                                type="checkbox"
                                name="days_<%= task._id %>"
                                value="<%= days[key] %>"
                                data-days-button="true"
                                <%= (task.days || []).includes(days[key]) ? "checked" : "" %>
                        >
                        <span><%= daysLabels[key] %></span>
                    </label>
                <% }) %>

                <!-- FREKVENS (INDIVIDUELT) -->
                <label>Frekvens</label>
                <select name="frequency_<%= task._id %>">
                    <% Object.keys(frequencies).forEach(key => { %>
                        <option value="<%= frequencies[key] %>"
                                <%= task.frequency === frequencies[key] ? "selected" : "" %>>
                            <%= frequencyLabels[key] %>
                        </option>
                    <% }) %>
                </select>

                <!-- Beskrivelse -->
                <label>Beskrivelse</label>
                <textarea name="description_<%= task._id %>" rows="3"><%= task.description %></textarea>

                <!-- Pris -->
                <p>
                    <strong>Aktuel pris:</strong>
                    <span id="price_<%= task._id %>"><%= task.monthlyPrice %> kr.</span>
                </p>
            </section>

            <hr>
        <% }) %>

        <button type="submit" class="button">Gem daglig opgave</button>

        <button class="button-secondary"
                hx-get="/newPlan/tasks/daily?planId=<%= tasks[0].planId %>"
                hx-target="#taskArea">
            Tilbage
        </button>

    </form>

</article>

<script>
    function setDailyWeekdaysFor(groupName) {
        const weekdays = ["monday", "tuesday", "wednesday", "thursday", "friday"];
        document.querySelectorAll(`input[name="${groupName}"]`).forEach(cb => {
            cb.checked = weekdays.includes(cb.value);
        });
    }

    document.querySelectorAll('[data-weekdays]').forEach(btn => {
        btn.addEventListener('click', () => {
            const group = btn.getAttribute('data-weekdays');
            setDailyWeekdaysFor(group);
        });
    });
</script>
