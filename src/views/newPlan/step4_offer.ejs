<article class="standard wizard-step">

    <h2>Prisberegning – Lav tilbud</h2>

    <section class="offer-summary">

        <!-- ⭐ Samlet månedlig pris -->
        <h3>Samlet månedlig pris</h3>
        <p class="plan-total"><strong><%= monthlyTotal.toFixed(2) %> kr./måned</strong></p>

        <hr>

        <h3>Faste opgaver (pris pr måned)</h3>

        <%
        // ⭐ Opdel tasks i sektioner

        const roomTasks = tasks.filter(t =>
                t.roomName &&
                t.roomName.trim() !== "" &&
                t.monthlyPrice > 0
        );

        const noRoomTasks = tasks.filter(t =>
                (!t.roomName || t.roomName.trim() === "") &&
                t.monthlyPrice > 0
        );

        const adHocTasks = tasks.filter(t =>
                t.monthlyPrice === 0 &&
                t.customPrice != null &&
                t.category !== categoryTypes.consumables
        );

        const consumables = tasks.filter(t =>
                t.category === categoryTypes.consumables
        );
        %>

        <!-- ⭐ RUM -->
        <% if (roomTasks.length > 0) { %>
            <section>
                <h3>Rum</h3>

                <%
                    const rooms = {};
                    roomTasks.forEach(t => {
                        if (!rooms[t.roomName]) rooms[t.roomName] = [];
                        rooms[t.roomName].push(t);
                    });
                %>

                <% Object.keys(rooms).forEach(room => {
                    const tasksInRoom = rooms[room];
                    const programCode = grouped[room]?.programCode || "";
                %>

                <h4><%= room %> (<%= programCode %>)</h4>

                <ul>
                    <% tasksInRoom.forEach(t => { %>
                        <li>
                            <strong><%= t.name %></strong>

                            <!-- Dage + frekvens -->
                            <div>
                                <% (t.days || []).forEach(d => { %>
                                    <%= daysLabels[d] %>
                                <% }) %>
                                – <%= frequencyLabels[t.frequency] %>
                            </div>

                            <!-- ⭐ Pris pr måned -->
                            <div>
                                <strong><%= t.monthlyPrice.toFixed(2) %> kr./måned</strong>
                            </div>

                            <% if (t.description && t.description.trim().length > 0) { %>
                                <div><em><%= t.description %></em></div>
                            <% } %>
                        </li>
                    <% }) %>
                </ul>

                <% }) %>
            </section>

            <hr>
        <% } %>

        <!-- ⭐ OPGAVER UDEN RUM -->
        <% if (noRoomTasks.length > 0) { %>
            <section>
                <h3>Opgaver uden rum</h3>

                <ul>
                    <% noRoomTasks.forEach(t => { %>
                        <li>
                            <strong><%= t.name %></strong>
                            – <%= frequencyLabels[t.frequency] %>
                            – <strong><%= t.monthlyPrice.toFixed(2) %> kr./måned</strong>

                            <% if (t.description && t.description.trim().length > 0) { %>
                                <div><em><%= t.description %></em></div>
                            <% } %>
                        </li>
                    <% }) %>
                </ul>
            </section>

            <hr>
        <% } %>

        <!-- ⭐ AD HOC / VINDUER / EFTER AFTALE -->
        <% if (adHocTasks.length > 0) { %>
            <section>
                <h3>Pris pr gang – Ad hoc / Vinduer / Efter aftale</h3>

                <ul>
                    <% adHocTasks.forEach(t => { %>
                        <li>
                            <strong><%= t.name %></strong>
                            – <strong><%= t.customPrice %> kr pr gang</strong>

                            <% if (t.description && t.description.trim().length > 0) { %>
                                <div><em><%= t.description %></em></div>
                            <% } %>
                        </li>
                    <% }) %>
                </ul>
            </section>

            <hr>
        <% } %>

        <!-- ⭐ FORBRUGSVARER -->
        <% if (consumables.length > 0) { %>
            <section>
                <h3>Tilkøb – Forbrugsvarer</h3>

                <ul>
                    <% consumables.forEach(c => { %>
                        <li>
                            <strong><%= c.name %></strong>
                            – <%= c.customPrice %> kr pr stk
                            – <%= c.quantity %> stk

                            <% if (c.description && c.description.trim().length > 0) { %>
                                <div><em><%= c.description %></em></div>
                            <% } %>
                        </li>
                    <% }) %>
                </ul>

                <p><em>Faktureres efter forbrug</em></p>
            </section>

            <hr>
        <% } %>

        <!-- ⭐ TOTALPRIS MED TILLÆG OG RABAT -->
        <div class="offer-total-box" style="margin-top:1rem;">
            <h3>Totalpris inkl drift og miljøtillæg</h3>
            <div id="offerTotal">
                <%= total.toFixed(2) %> kr.
            </div>
        </div>

    </section>

    <hr>

    <!-- ⭐ FORMULAR -->
    <form hx-post="/newPlan/offer/save" hx-target="#content" style="margin-top: 1rem;">

        <input type="hidden" name="planId" value="<%= planId %>">

        <button class="button"
                type="button"
                onclick="document.getElementById('advanced').classList.toggle('hidden')">
            Avanceret
        </button>

        <div id="advanced" class="hidden" style="margin-top: 1rem;">

            <label>Drift- og miljøtillæg (%)</label>
            <input type="number"
                   name="environmentalFee"
                   value="<%= environmentalFee || 0 %>"
                   hx-post="/newPlan/offer/preview"
                   hx-trigger="change"
                   hx-target="#offerTotal"
                   hx-swap="innerHTML">

            <label>Rabat (%)</label>
            <input type="number"
                   name="discountPercent"
                   value="<%= discountPercent || 0 %>"
                   hx-post="/newPlan/offer/preview"
                   hx-trigger="change"
                   hx-target="#offerTotal"
                   hx-swap="innerHTML">
        </div>

        <button type="submit" class="button" style="margin-top: 1rem;">
            Generér tilbud
        </button>

        <button class="button-secondary"
                hx-get="/newPlan/tasks/list?planId=<%= planId %>"
                hx-target="#content"
                hx-push-url="true">
            Tilbage til opgaver
        </button>
    </form>

</article>

<style>
    .hidden {
        display: none;
    }
</style>
