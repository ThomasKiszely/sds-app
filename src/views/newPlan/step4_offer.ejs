<article class="standard wizard-step">
    <h2>Prisberegning – Lav tilbud</h2>

    <section class="offer-summary">

        <h3>Opgaver</h3>

        <% const groups = { daily: [], extra: [], consumables: [], windows: [] }; %>
        <% tasks.forEach(t => groups[t.category].push(t)); %>

        <% if (groups.daily.length) { %>
            <h4>Daglig</h4>
            <ul>
                <% groups.daily.forEach(t => { %>
                    <li><strong><%= t.name %></strong> — <%= t.totalPrice %> kr.</li>
                <% }) %>
            </ul>
        <% } %>

        <% if (groups.extra.length) { %>
            <h4>Ekstra</h4>
            <ul>
                <% groups.extra.forEach(t => { %>
                    <li><strong><%= t.name %></strong> — <%= t.totalPrice %> kr.</li>
                <% }) %>
            </ul>
        <% } %>

        <% if (groups.consumables.length) { %>
            <h4>Forbrugsvare</h4>
            <ul>
                <% groups.consumables.forEach(t => { %>
                    <li><strong><%= t.name %></strong> — <%= t.totalPrice %> kr.</li>
                <% }) %>
            </ul>
        <% } %>

        <% if (groups.windows.length) { %>
            <h4>Vinduespudsning</h4>
            <ul>
                <% groups.windows.forEach(t => { %>
                    <li><strong><%= t.name %></strong> — <%= t.totalPrice %> kr.</li>
                <% }) %>
            </ul>
        <% } %>

        <!-- TOTALPRIS (LIVE) -->
        <div class="offer-total-box" style="margin-top:1rem;">
            <h3>Totalpris inkl miljøafgift</h3>
            <div id="offerTotal">
                <%= total.toFixed(2) %> kr.
            </div>
        </div>

    </section>

    <hr>

    <!-- Hele formularen -->
    <form hx-post="/newPlan/offer/save" hx-target="#content" style="margin-top: 1rem;">

        <input type="hidden" name="planId" value="<%= planId %>">

        <!-- Avanceret knap -->
        <button class="button"
                type="button"
                onclick="document.getElementById('advanced').classList.toggle('hidden')">
            Avanceret
        </button>

        <!-- Avanceret sektion -->
        <div id="advanced" class="hidden" style="margin-top: 1rem;">


            <label>Miljøafgift (%)</label>
            <input type="number"
            name="environmentalFee"
            value="<%= environmentalFee || 0 %>"
            hx-post="/newPlan/offer/preview"
            hx-trigger="change"
            hx-target="#offerTotal"
            hx-swap="innerHTML">

            <label>Rabat (%)</label>
            <input type="number"
                   name="discountPercent"
                   value="<%= discountPercent || 0 %>"
                   hx-post="/newPlan/offer/preview"
                   hx-trigger="change"
                   hx-target="#offerTotal"
                   hx-swap="innerHTML">
        </div>

        <button type="submit" class="button" style="margin-top: 1rem;">
            Generér tilbud
        </button>

    </form>
</article>

<style>
    .hidden {
        display: none;
    }
</style>
