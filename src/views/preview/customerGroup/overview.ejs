<article class="standard preview-page">
    <%- include('../_banner', { text: 'Kundegrupper med flere bygninger, samlet tilbud og gruppe-rabat er ikke bygget endnu. Alt her er eksempeldata.' }) %>

    <button type="button" class="back-link" hx-get="/customers" hx-target="#content"><%- icon('arrow-left') %> Kunder</button>

    <header class="page-header">
        <div>
            <h1><%= group.name %><span class="preview-badge">Preview</span></h1>
            <p class="page-sub"><%= group.meta %></p>
        </div>
        <div class="page-actions">
            <button type="button">Rediger kunde</button>
            <button type="button" class="btn-primary"><%- icon('plus') %> Ny bygning</button>
        </div>
    </header>

    <div class="stat-row">
        <% group.stats.forEach(([label, value]) => { %>
            <div><div class="stat-label"><%= label %></div><div class="stat-value"><%= value %></div></div>
        <% }) %>
    </div>

    <div class="two-col">
        <section>
            <h2 style="margin-top: 0">Bygninger</h2>
            <table class="data-table responsive-table" style="margin-top: 0">
                <thead>
                <tr>
                    <th>Bygning</th>
                    <th>Status</th>
                    <th class="num">Grundpris</th>
                    <th class="num">Pr. måned</th>
                    <th class="num">Næste skridt</th>
                </tr>
                </thead>
                <tbody>
                <% group.buildings.forEach(b => { %>
                    <tr>
                        <td data-label="Bygning"><strong><%= b.name %></strong><div class="list-row-sub"><%= b.address %></div></td>
                        <td data-label="Status"><span class="badge badge-<%= b.tone %>"><%= b.status %></span></td>
                        <td data-label="Grundpris" class="num"><%= b.base %></td>
                        <td data-label="Pr. måned" class="num"><strong><%= b.monthly %></strong></td>
                        <td data-label="Næste skridt" class="num">
                            <% if (b.link) { %>
                                <a href="#"><%= b.next %></a>
                            <% } else { %>
                                <a href="#" class="muted" hx-get="/preview/customer-group/offer" hx-target="#content"><%= b.next %></a>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
                </tbody>
            </table>
        </section>

        <aside class="stack" style="padding-top: 34px">
            <section class="card">
                <h2 class="panel-title" style="font-size: 15px">Gruppe-rabat</h2>
                <p class="muted" style="font-size: 12px"><%= group.discount.rate %> % på alle bygninger. Rabatten sættes af admin og kommer selv med i dine tilbud.</p>
                <div class="kv"><span class="k">Kunden sparer pr. måned</span><span class="v"><%= group.discount.saving %></span></div>
                <% if (user.role === 'admin') { %>
                    <button type="button" class="btn-small" style="margin-top: 8px" hx-get="/preview/customer-group/discount" hx-target="#content">Ret rabat</button>
                <% } %>
            </section>

            <section class="card">
                <h2 class="panel-title" style="font-size: 15px">Faktura</h2>
                <label class="checklist-row" style="border: 0; padding: 4px 0">
                    <input type="radio" name="pvInvoice" checked>
                    <span><strong style="color: var(--ink)">Samlet faktura</strong><br>Alle bygninger på én faktura</span>
                </label>
                <label class="checklist-row" style="border: 0; padding: 4px 0">
                    <input type="radio" name="pvInvoice">
                    <span><strong style="color: var(--ink)">En faktura pr. bygning</strong><br>Hver afdeling betaler selv</span>
                </label>
            </section>
        </aside>
    </div>
</article>
