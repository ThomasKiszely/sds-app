<%
    const effectiveBaseUrl = (typeof baseUrl !== 'undefined' && baseUrl) ? baseUrl : '/newPlanDraft';
    const effectiveIsEditing = (typeof isEditing !== 'undefined') ? isEditing : false;
    const effectivePlanId = (typeof planId !== 'undefined' && planId) ? planId : (typeof draft !== 'undefined' && draft?.planId ? draft.planId : (typeof plan !== 'undefined' && plan?._id ? plan._id : ''));

    const hourlyRate = (draft && draft.hourlyRate) || (systemSettings && systemSettings.hourlyRate) || 0;
    const allTasks = roomsList.flatMap(r => r.tasks || []).concat(generalTasks || []);

    // Timer pr. uge: minutter pr. gang × antal gange pr. måned / 4,3 uger.
    // Antal gange pr. måned = månedspris / pris pr. gang (samme multiplier som prisberegningen).
    const weeklyHours = allTasks.reduce((sum, t) => {
        if (!(t.monthlyPrice > 0) || !(t.basePrice > 0) || !(t.duration > 0)) return sum;
        return sum + (t.duration * (t.monthlyPrice / t.basePrice)) / 4.3 / 60;
    }, 0);

    const fmt = (n, d = 0) => Number(n || 0).toLocaleString('da-DK', { minimumFractionDigits: d, maximumFractionDigits: d });
    const dayKeys = Object.keys(daysLabels);
    const dayLetter = { monday: 'M', tuesday: 'T', wednesday: 'O', thursday: 'T', friday: 'F', saturday: 'L', sunday: 'S' };
    const taskPrice = t => t.monthlyPrice > 0 ? fmt(t.monthlyPrice) + ' kr./md.' : fmt(t.pricePerOccurrence || 0) + ' kr. pr. gang';
    const countLabel = (n, one, many) => n + ' ' + (n === 1 ? one : many);

    const roomTasksTemplates = (taskTemplates || []).filter(t => t.category !== 'consumables');
    const metaParts = [
        location ? location.name : null,
        countLabel(roomsList.length, 'lokale', 'lokaler'),
        'Timepris ' + fmt(hourlyRate) + ' kr.',
    ].filter(Boolean);
%>
<article class="editor-workspace pb" id="editorWorkspace" data-base-url="<%= effectiveBaseUrl %>" data-plan-id="<%= effectivePlanId %>" data-is-editing="<%= effectiveIsEditing %>">

    <!-- Opgaver og varer man kan søge frem i lokalerne -->
    <datalist id="pbRoomTaskOptions">
        <% roomTasksTemplates.forEach(t => { %><option value="<%= t.name %>" data-id="<%= t._id %>"><%= categoryLabels[t.category] || '' %></option><% }) %>
    </datalist>
    <datalist id="pbAllTaskOptions">
        <% (taskTemplates || []).forEach(t => { %><option value="<%= t.name %>" data-id="<%= t._id %>"><%= categoryLabels[t.category] || '' %></option><% }) %>
    </datalist>

    <!-- SIDEHOVED -->
    <header class="page-header pb-header">
        <div>
            <h1><%= customer ? customer.customerName : 'Hurtig beregning' %></h1>
            <p class="page-sub"><%= customer ? metaParts.join(' · ') : 'Vælg kunde og bygning, eller regn en pris ud uden kunde.' %></p>
        </div>
        <div class="page-actions">
            <% if (customer) { %>
                <button type="button" hx-get="/preview/customer-group" hx-target="#content">
                    Se kundegruppe <span class="preview-badge">Preview</span>
                </button>
            <% } %>
            <% if (!effectiveIsEditing) { %>
                <button type="button" id="toggleCustomerPickerBtn"><%- icon('building-2') %> <%= customer ? 'Skift kunde' : 'Vælg kunde' %></button>
            <% } %>
        </div>
    </header>

    <!-- BYGNINGER -->
    <div class="pb-buildings" id="customerMetaBar">
        <% if (location) { %>
            <span class="pb-building is-active">
                <strong><%= location.name %></strong>
                <span><%= fmt(finalTotal) %> kr.</span>
            </span>
        <% } else if (customer) { %>
            <span class="pb-building is-missing">Ingen bygning valgt</span>
        <% } %>
        <% if (!effectiveIsEditing && customer) { %>
            <button type="button"
                    class="pb-link-btn"
                    hx-get="/customers/<%= customer._id %>/locations/create?flow=newPlanDraft"
                    hx-target="#overlay">
                <%- icon('plus') %> Bygning
            </button>
        <% } %>
    </div>

    <% if (!effectiveIsEditing) { %>
        <!-- KUNDE- OG BYGNINGSVÆLGER -->
        <section id="customerPickerPanel" class="card pb-picker <%= customer ? 'hidden' : '' %>">
            <div class="pb-picker-head">
                <h2 class="panel-title">Kunde og bygning</h2>
                <% if (customer) { %>
                    <button type="button" class="btn-ghost btn-small" id="closeCustomerPickerBtn" aria-label="Luk"><%- icon('x') %></button>
                <% } %>
            </div>

            <div class="pb-picker-grid">
                <div class="form-group">
                    <div class="pb-picker-label">
                        <label for="customerSearch">1. Kunde</label>
                        <button type="button"
                                class="pb-link-btn"
                                hx-get="/customers/create?flow=newPlanDraft"
                                hx-target="#overlay">
                            <%- icon('plus') %> Ny kunde
                        </button>
                    </div>
                    <div class="search-field" style="width: 100%">
                        <%- icon('search') %>
                        <input id="customerSearch"
                               type="search"
                               name="search"
                               autocomplete="off"
                               placeholder="Søg navn, adresse eller CVR"
                               hx-get="/newPlanDraft/customerSearch"
                               hx-trigger="keyup changed delay:300ms"
                               hx-target="#customerResults"
                               hx-include="#customerSearch">
                    </div>
                    <select id="customerId"
                            name="customerId"
                            aria-label="Valgt kunde"
                            hx-get="/newPlanDraft/customerLocations"
                            hx-target="#locationContainer"
                            hx-trigger="change">
                        <option value="" disabled <%= !customer ? "selected" : "" %>>
                            <%= customer ? customer.customerName : "Vælg kunde fra søgningen" %>
                        </option>
                        <% if (customer) { %>
                            <option value="<%= customer._id %>" selected><%= customer.customerName %></option>
                        <% } %>
                    </select>
                    <div id="customerResults" class="customer-results"></div>
                </div>

                <div class="form-group">
                    <div class="pb-picker-label">
                        <label>2. Bygning</label>
                        <div id="createLocationBtn">
                            <% if (customer) { %>
                                <button type="button"
                                        class="pb-link-btn"
                                        hx-get="/customers/<%= customer._id %>/locations/create?flow=newPlanDraft"
                                        hx-target="#overlay">
                                    <%- icon('plus') %> Ny bygning
                                </button>
                            <% } %>
                        </div>
                    </div>
                    <div id="locationContainer" class="location-container-box">
                        <% if (customer) { %>
                            <div hx-get="/newPlanDraft/customerLocations?customerId=<%= customer._id %>"
                                 hx-trigger="load"
                                 hx-target="#locationContainer">
                                <p class="muted">Henter bygninger …</p>
                            </div>
                        <% } else { %>
                            <p class="pb-hint">Vælg en kunde for at se kundens bygninger.</p>
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="pb-picker-foot">
                <% if (customer) { %>
                    <button type="button" id="closeCustomerPickerBtn2">Luk</button>
                <% } %>
                <button type="button" class="btn-primary" hx-get="<%= effectiveBaseUrl %>/summary" hx-target="#content">
                    <%- icon('check') %> Brug valget
                </button>
            </div>
        </section>
    <% } %>

    <div class="pb-layout">
        <!-- LOKALER OG OPGAVER -->
        <main class="editor-main pb-plan" aria-label="Lokaler og opgaver">
            <div id="planRoomsList" class="pb-rooms">

                <% if (roomsList.length === 0) { %>
                    <div class="pb-empty" id="emptyPlanPlaceholder">
                        <strong>Planen er tom</strong>
                        <span>Tilføj et lokale nedenfor for at komme i gang.</span>
                    </div>
                <% } %>

                <% roomsList.forEach(room => {
                    const tasks = room.tasks || [];
                    const roomDays = room.days || [];
                %>
                    <article class="plan-room-card pb-room is-minimized" data-room-name="<%= room.name %>">
                        <header class="room-card-header pb-room-head">
                            <span class="room-drag-handle pb-grip" title="Træk for at ændre rækkefølgen"><%- icon('grip-vertical') %></span>

                            <input type="text"
                                   class="pb-room-name"
                                   name="newRoomName"
                                   value="<%= room.name %>"
                                   aria-label="Lokalets navn"
                                   size="<%= Math.max(4, room.name.length) %>"
                                   hx-post="<%= effectiveBaseUrl %>/updateRoom"
                                   hx-vals='{"oldRoomName": "<%= room.name %>"}'
                                   hx-target="#content"
                                   hx-trigger="change">

                            <label class="pb-room-size">
                                <input type="number"
                                       name="size"
                                       value="<%= room.size %>"
                                       min="0"
                                       step="1"
                                       aria-label="Størrelse i m²"
                                       hx-post="<%= effectiveBaseUrl %>/updateRoom"
                                       hx-vals='{"oldRoomName": "<%= room.name %>", "newRoomName": "<%= room.name %>"}'
                                       hx-target="#content"
                                       hx-trigger="change">
                                <span>m²</span>
                            </label>

                            <% if (room.programCode && room.programCode !== "000") { %>
                                <span class="tag" title="Programkode (Daglig / Gulv / Inventar)">Kode <%= room.programCode %></span>
                            <% } %>

                            <span class="pb-push"></span>

                            <span class="pb-room-summary">
                                <%= countLabel(tasks.length, 'opgave', 'opgaver') %><% if (roomDays.length) { %> · <%= countLabel(roomDays.length, 'dag', 'dage') %><% } %>
                            </span>
                            <strong class="pb-room-price"><%= fmt(room.totalPrice) %> kr./md.</strong>

                            <button type="button" class="btn-toggle-room pb-icon-btn" aria-label="Åbn eller luk lokalet">
                                <span class="toggle-room-text visually-hidden">Rediger</span>
                                <%- icon('chevron-down', 'pb-chevron') %>
                            </button>
                            <button type="button"
                                    class="btn-icon-delete pb-icon-btn"
                                    title="Slet lokalet"
                                    aria-label="Slet lokalet"
                                    hx-post="<%= effectiveBaseUrl %>/removeRoom"
                                    hx-vals='{"roomName": "<%= room.name %>"}'
                                    hx-target="#content"
                                    hx-confirm="Slet lokalet <%= room.name %> og dets opgaver?">
                                <%- icon('x') %>
                            </button>
                        </header>

                        <div class="room-card-body pb-room-body">
                            <!-- Dage for hele lokalet -->
                            <div class="pb-room-days">
                                <span class="pb-label">Dage for lokalet</span>
                                <div class="pb-days room-days-dropzone" data-room-name="<%= room.name %>">
                                    <% dayKeys.forEach(dayKey => { const on = roomDays.includes(dayKey); %>
                                        <button type="button"
                                                class="pb-day room-day-pill <%= on ? 'active' : '' %>"
                                                title="<%= daysLabels[dayKey] %>"
                                                aria-pressed="<%= on %>"
                                                hx-post="<%= on ? effectiveBaseUrl + '/removeDay' : effectiveBaseUrl + '/addDayToRoom' %>"
                                                hx-vals='{"roomName": "<%= room.name %>", "day": "<%= dayKey %>"}'
                                                hx-target="#content"><%= dayLetter[dayKey] %></button>
                                    <% }) %>
                                </div>
                                <button type="button"
                                        class="btn-small btn-ghost btn-shortcut"
                                        hx-post="<%= effectiveBaseUrl %>/setDaysForRoom"
                                        hx-vals='{"roomName": "<%= room.name %>", "days": "[\"monday\",\"tuesday\",\"wednesday\",\"thursday\",\"friday\"]"}'
                                        hx-target="#content">Man–fre</button>
                                <button type="button"
                                        class="btn-small btn-ghost btn-shortcut"
                                        hx-post="<%= effectiveBaseUrl %>/setDaysForRoom"
                                        hx-vals='{"roomName": "<%= room.name %>", "days": "[]"}'
                                        hx-target="#content">Nulstil</button>
                            </div>

                            <div class="room-tasks-dropzone pb-tasks" data-room-name="<%= room.name %>">
                                <% tasks.forEach(task => { %>
                                    <%- include('partials/taskRow', { task, roomName: room.name, effectiveBaseUrl, dayKeys, dayLetter, daysLabels, frequencyLabels, unitsLabels, categoryLabels, taskPrice }) %>
                                <% }) %>
                            </div>

                            <label class="pb-add-task">
                                <%- icon('search') %>
                                <input type="text"
                                       list="pbRoomTaskOptions"
                                       placeholder="Skriv for at tilføje en opgave, fx vinduer"
                                       aria-label="Tilføj opgave til <%= room.name %>"
                                       data-add-task
                                       data-room-name="<%= room.name %>">
                            </label>

                            <details class="pb-notes">
                                <summary><%- icon('message-square') %> Bemærkninger til lokalet</summary>
                                <textarea name="notes"
                                          rows="3"
                                          placeholder="Adgang, nøgler, særlige krav …"
                                          hx-post="<%= effectiveBaseUrl %>/updateRoomNotes"
                                          hx-vals='{"roomName": "<%= room.name %>"}'
                                          hx-target="#content"
                                          hx-trigger="change"><%= ((draft.roomNotes || []).find(n => n.roomName === room.name)?.notes || []).join('\n') %></textarea>
                            </details>
                        </div>
                    </article>
                <% }) %>

                <!-- Opgaver og forbrugsvarer uden lokale -->
                <% const generalTotal = (generalTasks || []).reduce((sum, t) => sum + (t.monthlyPrice > 0 ? t.monthlyPrice : (t.pricePerOccurrence || 0)), 0); %>
                <article class="plan-room-card pb-room general-tasks-card is-minimized" data-room-name="__general__">
                    <header class="room-card-header pb-room-head">
                        <span class="pb-room-title">Øvrige opgaver og forbrugsvarer</span>
                        <span class="pb-room-sub">Vinduer, ad hoc og varer uden lokale</span>
                        <span class="pb-push"></span>
                        <span class="pb-room-summary"><%= countLabel((generalTasks || []).length, 'opgave', 'opgaver') %></span>
                        <% if (generalTasks && generalTasks.length) { %>
                            <strong class="pb-room-price"><%= fmt(generalTotal) %> kr.</strong>
                        <% } %>
                        <button type="button" class="btn-toggle-room pb-icon-btn" aria-label="Åbn eller luk øvrige opgaver">
                            <span class="toggle-room-text visually-hidden">Rediger</span>
                            <%- icon('chevron-down', 'pb-chevron') %>
                        </button>
                    </header>

                    <div class="room-card-body pb-room-body">
                        <div class="room-tasks-dropzone general-tasks-dropzone pb-tasks" id="generalTasksDropzone" data-room-name="">
                            <% (generalTasks || []).forEach(task => { %>
                                <%- include('partials/taskRow', { task, roomName: '', effectiveBaseUrl, dayKeys, dayLetter, daysLabels, frequencyLabels, unitsLabels, categoryLabels, taskPrice }) %>
                            <% }) %>
                        </div>

                        <label class="pb-add-task">
                            <%- icon('search') %>
                            <input type="text"
                                   list="pbAllTaskOptions"
                                   placeholder="Skriv for at tilføje en opgave eller vare, fx toiletpapir"
                                   aria-label="Tilføj opgave eller vare uden lokale"
                                   data-add-task
                                   data-room-name="">
                        </label>
                    </div>
                </article>
            </div>

            <!-- Tilføj lokale -->
            <div class="pb-add-rooms">
                <span class="muted">Tilføj:</span>
                <% (roomTemplates || []).forEach(tpl => { %>
                    <button type="button"
                            class="pb-chip"
                            title="<%= tpl.name %>, <%= tpl.defaultSize %> m²"
                            hx-post="<%= effectiveBaseUrl %>/addRoom"
                            hx-vals='{"templateId": "<%= tpl._id %>"}'
                            hx-target="#content">
                        <%- icon('plus') %> <%= tpl.name %>
                    </button>
                <% }) %>
                <details class="pb-custom-room">
                    <summary class="pb-chip"><%- icon('plus') %> Tom</summary>
                    <form class="pb-custom-room-form" hx-post="<%= effectiveBaseUrl %>/addRoom" hx-target="#content">
                        <input type="text" name="name" placeholder="Lokalets navn" aria-label="Lokalets navn" required>
                        <input type="number" name="size" value="20" min="1" step="1" aria-label="Størrelse i m²" required>
                        <span class="muted">m²</span>
                        <button type="submit" class="btn-small">Tilføj</button>
                    </form>
                </details>
            </div>
        </main>

        <!-- PRIS OG VILKÅR -->
        <aside class="card pb-price" aria-label="Pris og vilkår">
            <div class="stat-label">Pris pr. måned, ekskl. moms</div>
            <div class="pb-total"><%= fmt(finalTotal) %> kr.</div>

            <div class="kv"><span class="k">Grundpris</span><span class="v"><%= fmt(monthlyTotal) %> kr.</span></div>
            <% if (discountPercent > 0) { %>
                <div class="kv neg"><span class="k">Rabat <%= fmt(discountPercent, 0) %> %</span><span class="v">−<%= fmt(discountAmount) %> kr.</span></div>
            <% } %>
            <div class="kv"><span class="k">Drift- og miljøtillæg <%= fmt(environmentalFeePercent, 1).replace(',0', '') %> %</span><span class="v"><%= fmt(environmentalFeeAmount) %> kr.</span></div>
            <div class="kv"><span class="k">Timer pr. uge</span><span class="v"><%= fmt(weeklyHours, 1) %> t</span></div>

            <div class="divider"></div>

            <form class="pb-terms" hx-post="<%= effectiveBaseUrl %>/saveSummaryAdjustments" hx-target="#content" hx-trigger="change">
                <div class="form-group">
                    <label for="paymentTermsSelect">Betaling</label>
                    <select id="paymentTermsSelect" name="paymentTerms" required>
                        <% if (!operations.paymentTerms) { %><option value="" selected disabled>Vælg …</option><% } %>
                        <% Object.keys(paymentTerms).forEach(key => { %>
                            <option value="<%= paymentTerms[key] %>" <%= operations.paymentTerms === paymentTerms[key] ? "selected" : "" %>><%= paymentTermLabels[key] %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="form-group">
                    <label for="terminationNoticeSelect">Opsigelse</label>
                    <select id="terminationNoticeSelect" name="terminationNotice" required>
                        <% if (!operations.terminationNotice) { %><option value="" selected disabled>Vælg …</option><% } %>
                        <% Object.keys(terminationNotice).forEach(key => { %>
                            <option value="<%= terminationNotice[key] %>" <%= operations.terminationNotice === terminationNotice[key] ? "selected" : "" %>><%= terminationNoticeLabels[key] %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="pb-terms-pct">
                    <div class="form-group">
                        <label for="discountPercent">Egen rabat</label>
                        <div class="input-unit">
                            <input type="number" id="discountPercent" name="discountPercent" value="<%= discounts.discountPercent || 0 %>" min="0" max="100" step="1">
                            <span>%</span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="environmentalFeePercent">Miljøtillæg</label>
                        <div class="input-unit">
                            <input type="number" id="environmentalFeePercent" name="environmentalFeePercent" value="<%= environment.environmentalFeePercent %>" min="0" max="100" step="0.5" required>
                            <span>%</span>
                        </div>
                    </div>
                </div>
            </form>

            <% if (!effectiveIsEditing) { %>
                <button class="btn-primary btn-large pb-cta"
                        hx-post="<%= effectiveBaseUrl %>/generateOffer"
                        hx-target="#content"
                        hx-swap="innerHTML show:window:top">
                    <%- icon('arrow-right') %> Videre til tilbud
                </button>
            <% } else { %>
                <button class="btn-primary btn-large pb-cta"
                        hx-get="/customers/<%= customer ? customer._id : '' %>/plans"
                        hx-target="#content">
                    <%- icon('check') %> Afslut redigering
                </button>
            <% } %>
        </aside>
    </div>
</article>
