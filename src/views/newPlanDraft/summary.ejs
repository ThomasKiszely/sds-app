<article class="standard summary">

    <h1>Opsummering af rengøringsplan</h1>

    <!-- SDS-OPGAVER -->
    <section>
        <h2>Rum</h2>

        <% Object.keys(grouped).forEach(roomName => { %>
            <h3><%= roomName %></h3>

            <ul class="item-list">
                <% grouped[roomName].sds.forEach(t => { %>
                    <li>
                        <strong><%= t.name %></strong>
                        — <%= t.monthlyPrice.toFixed(2) %> kr/måned
                    </li>
                <% }) %>
            </ul>

            <% const roomNoteObj = draft.roomNotes?.find(r => r.roomName === roomName); %>

            <% if (roomNoteObj && roomNoteObj.notes.length > 0) { %>
                <div class="room-notes">
                    <strong>Bemærkninger:</strong><br>
                    <% roomNoteObj.notes.forEach(n => { %>
                        <div><%= n %></div>
                    <% }) %>
                </div>

            <% } %>


            <button class="button-secondary"
                    hx-get="/newPlanDraft/tasks/dailyBundle/edit?roomName=<%= roomName %>"
                    hx-target="#content">
                Rediger rum
            </button>
        <% }) %>
    </section>

    <hr>

    <!-- ØVRIGE OPGAVER -->
    <section>
        <h2>Øvrige opgaver</h2>

        <% const extraTasks = draft.tasks.filter(t =>
                t.category !== categoryTypes.daily &&
                t.category !== categoryTypes.floor &&
                t.category !== categoryTypes.inventory &&
                t.category !== categoryTypes.consumables
        ); %>

        <% if (extraTasks.length === 0) { %>
            <p><em>Ingen øvrige opgaver tilføjet endnu.</em></p>
        <% } else { %>
            <ul class="item-list">
                <% extraTasks.forEach(t => { %>
                    <li>
                        <strong><%= t.name %></strong>
                        — <%= t.monthlyPrice.toFixed(2) %> kr/måned
                    </li>
                <% }) %>
            </ul>
        <% } %>

        <button class="button-secondary"
                hx-get="/newPlanDraft/taskEditor?category=<%= categoryTypes.other %>"
                hx-target="#overlay"
                hx-swap="innerHTML">
            Tilføj opgave
        </button>

    </section>

    <hr>

    <!-- FORBRUGSVARER -->
    <section>
        <h2>Forbrugsvarer</h2>

        <% const consumables = draft.tasks.filter(t =>
                t.category === categoryTypes.consumables
        ); %>

        <% if (consumables.length === 0) { %>
            <p><em>Ingen forbrugsvarer tilføjet endnu.</em></p>
        <% } else { %>
            <ul class="item-list">
                <% consumables.forEach(c => { %>
                    <li>
                        <strong><%= c.name %></strong>
                        — <%= c.amount %> stk
                        — <%= c.monthlyPrice.toFixed(2) %> kr/måned
                    </li>
                <% }) %>
            </ul>
        <% } %>

        <button class="button-secondary"
                hx-get="/newPlanDraft/taskEditor?category=<%= categoryTypes.consumables %>"
                hx-target="#overlay"
                hx-swap="innerHTML">
            Tilføj opgave
        </button>

    </section>


    <hr>

    <!-- TOTALPRIS -->
    <section>
        <h2>Samlet månedlig pris</h2>
        <p class="plan-total">
            <strong><%= monthlyTotal.toFixed(2) %> kr./måned</strong>
        </p>
    </section>

    <hr>

    <!-- AVANCERET -->
    <section>
        <button class="button-secondary" type="button" id="toggleAdvancedBtn">
            Avanceret
        </button>

        <div id="advanced" class="hidden" style="margin-top: 1rem;">

            <form hx-post="/newPlanDraft/adjustments" hx-target="#content">

            <label>Rabat (%)</label>
                <input type="number"
                       name="discountPercent"
                       value="<%= discounts.discountPercent || 0 %>"
                       min="0" max="100">

                <label>Drift- og miljøtillæg (%)</label>
                <input type="number"
                       value="<%= systemSettings.environmentalFee %>"
                       readonly>

                <label>Betalingsbetingelser</label>
                <select name="paymentTerms">
                    <% Object.keys(paymentTerms).forEach(key => { %>
                        <option value="<%= paymentTerms[key] %>"
                                <%= operations.paymentTerms === paymentTerms[key] ? "selected" : "" %>>
                            <%= paymentTermLabels[key] %>
                        </option>
                    <% }) %>
                </select>

                <label>Opsigelsesvarsel</label>
                <select name="terminationNotice">
                    <% Object.keys(terminationNotice).forEach(key => { %>
                        <option value="<%= terminationNotice[key] %>"
                                <%= operations.terminationNotice === terminationNotice[key] ? "selected" : "" %>>
                            <%= terminationNoticeLabels[key] %>
                        </option>
                    <% }) %>
                </select>

                <button class="button-secondary">Opdater</button>
            </form>
        </div>
    </section>

    <hr>

    <!-- VIDERE -->
    <button class="button-secondary"
            hx-post="/newPlanDraft/generateOffer"
            hx-target="#content">
        Videre til tilbud
    </button>
    <button class="button-secondary"
            hx-get="/newPlanDraft/tasks"
            hx-target="#content">
        Tilbage
    </button>


</article>

<div hx-swap-oob="innerHTML:#overlay"></div>
