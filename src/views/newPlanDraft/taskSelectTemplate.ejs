<div class="overlay">
    <div class="overlay-content">

        <h1>Vælg opgave</h1>

        <ul class="item-list">
            <% templates.forEach(tpl => { %>
                <li>
                    <button class="button"
                            hx-get="/newPlanDraft/taskEditor?templateId=<%= tpl._id %>"
                            hx-target="#overlay"
                            hx-swap="innerHTML">
                        <%= tpl.name %>
                    </button>
                </li>
            <% }) %>
        </ul>

        <button class="button-secondary"
                hx-get="/newPlanDraft/taskSelectCategory"
                hx-target="#overlay"
                hx-swap="innerHTML">
            Tilbage
        </button>

    </div>
</div>
