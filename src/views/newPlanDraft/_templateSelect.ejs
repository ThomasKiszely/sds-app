<label>Opgave</label>
<select name="templateId"
        hx-get="/newPlanDraft/taskLoadTemplate?category=<%= initialCategory %>"
        hx-target="#templateFields"
        hx-trigger="change"
        required>

    <option value="">-- Vælg opgave --</option>

    <% templates.forEach(tpl => { %>
        <option value="<%= tpl._id %>"><%= tpl.name %></option>
    <% }) %>

</select>
