<%
    const fmt = (n, d = 0) => Number(n || 0).toLocaleString('da-DK', { minimumFractionDigits: d, maximumFractionDigits: d });
    const dayOrder = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'];
    const dayShort = { monday: 'man', tuesday: 'tir', wednesday: 'ons', thursday: 'tor', friday: 'fre', saturday: 'lør', sunday: 'søn' };
    const describeDays = (days) => {
        const sorted = dayOrder.filter(d => days.includes(d));
        if (sorted.join() === 'monday,tuesday,wednesday,thursday,friday') return 'Man–fre';
        const text = sorted.map(d => dayShort[d]).join(', ');
        return text ? text.charAt(0).toUpperCase() + text.slice(1) : '';
    };
    const countLabel = (n, one, many) => n + ' ' + (n === 1 ? one : many);

    const monthlyTasks = tasks.filter(t => t.monthlyPrice > 0);
    const perTimeTasks = tasks.filter(t => t.monthlyPrice === 0 && t.category !== categoryTypes.consumables);
    const consumables = tasks.filter(t => t.category === categoryTypes.consumables);

    // Faste månedlige opgaver samlet pr. lokale; opgaver uden lokale står hver for sig
    const roomRows = new Map();
    const noRoomRows = [];
    monthlyTasks.forEach(t => {
        const room = t.roomName && t.roomName.trim();
        if (!room) {
            noRoomRows.push({ name: t.name, sub: frequencyLabels[t.frequency] || '', price: t.monthlyPrice });
            return;
        }
        if (!roomRows.has(room)) roomRows.set(room, { name: room, days: new Set(), count: 0, price: 0 });
        const row = roomRows.get(room);
        row.count += 1;
        row.price += t.monthlyPrice;
        (t.days || []).forEach(d => row.days.add(d));
    });
    roomRows.forEach(r => {
        r.sub = [describeDays([...r.days]), countLabel(r.count, 'opgave', 'opgaver')].filter(Boolean).join(' · ');
    });
    const monthlyRows = [...roomRows.values(), ...noRoomRows];

    const contact = customer && customer.contactPerson ? customer.contactPerson : null;
    const canSave = Boolean(customer);
    const title = location ? 'Tilbud på ' + location.name : 'Tilbud';
%>
<article class="standard pb-offer">
    <header class="page-header">
        <div>
            <h1><%= title %></h1>
            <p class="page-sub"><%= customer ? customer.customerName + ' · ' : '' %>Kladde, kunden kan ikke se det endnu</p>
        </div>
        <div class="page-actions">
            <button type="button" hx-get="/newPlanDraft/summary" hx-target="#content">Tilbage til justeringer</button>
            <button type="button"
                    hx-post="/newPlanDraft/saveAsDraftOffer"
                    hx-target="#content"
                    hx-swap="innerHTML show:window:top"
                    <%= canSave ? '' : 'disabled' %>>
                Gem som kladde
            </button>
            <button type="button"
                    class="btn-primary"
                    hx-post="/newPlanDraft/finalize"
                    hx-target="#content"
                    hx-swap="innerHTML show:window:top"
                    <%= canSave ? '' : 'disabled' %>>
                <%- icon('file-check') %> Opret endeligt tilbud
            </button>
        </div>
    </header>

    <% if (!canSave) { %>
        <div class="notice" style="margin-bottom: 14px"><%- icon('info') %> Vælg en kunde i Hurtig beregning, før tilbuddet kan gemmes.</div>
    <% } %>

    <div class="two-col">
        <section class="card pb-offer-lines">
            <% if (monthlyRows.length > 0) { %>
                <h2 class="pb-offer-group">Fast månedlig pris</h2>
                <% monthlyRows.forEach(r => { %>
                    <div class="pb-offer-line">
                        <div><strong><%= r.name %></strong><% if (r.sub) { %><span><%= r.sub %></span><% } %></div>
                        <span class="pb-offer-amount"><%= fmt(r.price) %> kr./md.</span>
                    </div>
                <% }) %>
            <% } %>

            <% if (perTimeTasks.length > 0) { %>
                <h2 class="pb-offer-group">Pris pr. gang, vinduer og ekstra</h2>
                <% perTimeTasks.forEach(t => {
                    // pricePerOccurrence er prisen pr. gang (customPrice eller beregnet)
                    const price = Number(t.pricePerOccurrence || t.pricePerTime || t.customPrice || 0);
                %>
                    <div class="pb-offer-line">
                        <div><strong><%= t.name %></strong><span><%= frequencyLabels[t.frequency] || '' %><%= t.roomName ? ' · ' + t.roomName : '' %></span></div>
                        <span class="pb-offer-amount"><%= fmt(price, price % 1 ? 2 : 0) %> kr. pr. gang</span>
                    </div>
                <% }) %>
            <% } %>

            <% if (consumables.length > 0) { %>
                <h2 class="pb-offer-group">Forbrugsvarer, faktureres efter forbrug</h2>
                <% consumables.forEach(c => { const price = Number(c.customPrice ?? 0); %>
                    <div class="pb-offer-line">
                        <div><strong><%= c.name %></strong></div>
                        <span class="pb-offer-amount"><%= fmt(price, price % 1 ? 2 : 0) %> kr. pr. stk.</span>
                    </div>
                <% }) %>
            <% } %>

            <% if (tasks.length === 0) { %>
                <div class="empty-state">Planen har ingen opgaver endnu. Gå tilbage og tilføj lokaler.</div>
            <% } %>
        </section>

        <aside class="stack">
            <section class="card">
                <div class="stat-label">Total pr. måned, ekskl. moms</div>
                <div class="big-number" style="margin-bottom: 10px"><%= fmt(finalTotal, 2) %> kr.</div>
                <div class="kv"><span class="k">Grundpris</span><span class="v"><%= fmt(monthlyTotal, 2) %> kr.</span></div>
                <% if (discounts && discounts.discountPercent > 0) { %>
                    <div class="kv neg"><span class="k">Rabat <%= discounts.discountPercent %> %</span><span class="v">−<%= fmt(discountAmount, 2) %> kr.</span></div>
                <% } %>
                <div class="kv"><span class="k">Drift- og miljøtillæg <%= (environment && environment.environmentalFeePercent) || 0 %> %</span><span class="v"><%= fmt(environmentalFeeAmount, 2) %> kr.</span></div>
                <div class="divider"></div>
                <div class="kv"><span class="k">Betaling</span><span class="v"><%= (operations && paymentTermLabels[operations.paymentTerms]) || '–' %></span></div>
                <div class="kv"><span class="k">Opsigelse</span><span class="v"><%= (operations && terminationNoticeLabels[operations.terminationNotice]) || '–' %></span></div>
            </section>

            <% if (contact) { %>
                <section class="card">
                    <div class="stat-label">Sendes til</div>
                    <div style="font-weight: 600; margin: 4px 0 2px"><%= contact.name %></div>
                    <div class="muted" style="font-size: 13px"><%= contact.email %></div>
                    <p class="muted" style="font-size: 12px; margin: 10px 0 0">Kunden får tilbuddet som PDF på mail med et acceptlink. Status skifter her, når kunden har accepteret.</p>
                </section>
            <% } %>
        </aside>
    </div>
</article>
