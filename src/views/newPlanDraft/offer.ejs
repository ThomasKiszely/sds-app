<article class="standard wizard-step">

    <h2>Tilbud (kladde)</h2>
    <p><em>Dette er en kladde. Intet er gemt endnu.</em></p>

    <section class="offer-summary">

        <h3>Samlet månedlig pris</h3>
        <p class="plan-total">
            <strong><%= monthlyTotal.toFixed(2) %> kr./måned</strong>
        </p>

        <hr>

        <%
        // FAST MÅNEDLIG PRIS
        const monthlyTasks = tasks.filter(t => t.monthlyPrice > 0);

        // PRIS PR GANG
        const perTimeTasks = tasks.filter(t =>
                t.monthlyPrice === 0 &&
                t.category !== categoryTypes.consumables
        );

        // FORBRUGSVARER
        const consumables = tasks.filter(t => t.category === categoryTypes.consumables);

        // SDS grupperet pr rum
        const rooms = {};
        monthlyTasks.forEach(t => {
            if (t.roomName && t.roomName.trim() !== "") {
                if (!rooms[t.roomName]) rooms[t.roomName] = [];
                rooms[t.roomName].push(t);
            }
        });
        %>

        <!-- FAST MÅNEDLIG PRIS – SDS pr rum -->
        <% if (Object.keys(rooms).length > 0) { %>
            <section>
                <h3>Fast månedlig pris – SDS</h3>

                <% Object.keys(rooms).forEach(room => { %>
                    <h4><%= room %></h4>

                    <ul>
                        <% rooms[room].forEach(t => { %>
                            <li>
                                <strong><%= t.name %></strong>

                                <div>
                                    <% (t.days || []).forEach(d => { %>
                                        <%= daysLabels[d] %>
                                    <% }) %>
                                    – <%= frequencyLabels[t.frequency] %>
                                </div>

                                <div>
                                    <strong><%= t.monthlyPrice.toFixed(2) %> kr./måned</strong>
                                </div>

                                <% if (t.description && t.description.trim().length > 0) { %>
                                    <div><em><%= t.description %></em></div>
                                <% } %>
                            </li>
                        <% }) %>
                    </ul>

                    <hr>
                <% }) %>
            </section>
        <% } %>

        <!-- FAST MÅNEDLIG PRIS – opgaver uden rum -->
        <%
        const monthlyNoRoom = monthlyTasks.filter(t =>
                !t.roomName || t.roomName.trim() === ""
        );
        %>

        <% if (monthlyNoRoom.length > 0) { %>
            <section>
                <h3>Fast månedlig pris – øvrige opgaver</h3>

                <ul>
                    <% monthlyNoRoom.forEach(t => { %>
                        <li>
                            <strong><%= t.name %></strong>
                            – <%= frequencyLabels[t.frequency] %>
                            – <strong><%= t.monthlyPrice.toFixed(2) %> kr./måned</strong>

                            <% if (t.description && t.description.trim().length > 0) { %>
                                <div><em><%= t.description %></em></div>
                            <% } %>
                        </li>
                    <% }) %>
                </ul>

                <hr>
            </section>
        <% } %>

        <!-- PRIS PR GANG -->
        <% if (perTimeTasks.length > 0) { %>
            <section>
                <h3>Pris pr gang – Vinduer / Efter aftale / Ad hoc / Ekstra</h3>

                <ul>
                    <% perTimeTasks.forEach(t => { %>

                        <%
                            const price =
                                    t.totalPrice != null
                                            ? Number(t.totalPrice)
                                            : t.pricePerTime != null && t.pricePerTime > 0
                                                    ? Number(t.pricePerTime)
                                                    : t.customPrice != null
                                                            ? Number(t.customPrice)
                                                            : 0;
                        %>

                        <li>
                            <strong><%= t.name %></strong>
                            – <%= frequencyLabels[t.frequency] %>
                            – <strong><%= price.toFixed(2) %> kr pr gang</strong>

                            <% if (t.description && t.description.trim().length > 0) { %>
                                <div><em><%= t.description %></em></div>
                            <% } %>
                        </li>

                    <% }) %>
                </ul>

                <hr>
            </section>
        <% } %>

        <!-- FORBRUGSVARER -->
        <% if (consumables.length > 0) { %>
            <section>
                <h3>Tilkøb – Forbrugsvarer</h3>

                <ul>
                    <% consumables.forEach(c => { %>
                        <li>
                            <strong><%= c.name %></strong>
                            – <%= (c.customPrice ?? 0).toFixed(2) %> kr pr stk
                            – <%= c.quantity %> stk

                            <% if (c.description && c.description.trim().length > 0) { %>
                                <div><em><%= c.description %></em></div>
                            <% } %>
                        </li>
                    <% }) %>
                </ul>

                <p><em>Faktureres efter forbrug</em></p>

                <hr>
            </section>
        <% } %>

        <!-- Totalpris -->
        <div class="price-box">
            <h3>Prisberegning</h3>

            <div class="price-line">
                <span>Grundpris</span>
                <strong><%= monthlyTotal.toFixed(2) %> kr.</strong>
            </div>

            <% if (discounts.discountPercent > 0) { %>
                <div class="price-line">
                    <span>Rabat (<%= discounts.discountPercent %>%)</span>
                    <strong>- <%= discountAmount.toFixed(2) %> kr.</strong>
                </div>
            <% } %>

            <div class="price-line">
                <span>Drift- og miljøtillæg (<%= environment.environmentalFeePercent || 0 %>%)</span>
                <strong>+ <%= environmentalFeeAmount.toFixed(2) %> kr.</strong>
            </div>

            <hr>

            <div class="price-total">
                <span>Total</span>
                <strong><%= finalTotal.toFixed(2) %> kr./måned</strong>
            </div>
        </div>


    </section>

    <hr>

    <!-- KNAPPER -->
    <div class="wizard-actions">
        <button class="button-secondary"
                hx-get="/newPlanDraft/summary"
                hx-target="#content">
            Tilbage til justeringer
        </button>

        <button class="button-secondary"
                hx-post="/newPlanDraft/saveAsDraftOffer"
                hx-target="#content">
            Gem som tilbud (kladde)
        </button>

        <button class="button-secondary"
                hx-post="/newPlanDraft/finalize"
                hx-target="#content">
            Gem og opret endeligt tilbud
        </button>
    </div>


</article>
