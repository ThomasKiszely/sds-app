<div class="overlay">
    <div class="overlay-content">

        <h1>Vælg kategori</h1>

        <ul class="item-list">
            <% Object.keys(categoryTypes).forEach(key => { %>
                <li>
                    <button class="button"
                            hx-get="/newPlanDraft/taskSelectTemplate?category=<%= categoryTypes[key] %>"
                            hx-target="#overlay"
                            hx-swap="innerHTML">
                        <%= categoryLabels[key] %>
                    </button>
                </li>
            <% }) %>
        </ul>

        <button class="button-secondary"
                hx-get="/newPlanDraft/summary"
                hx-target="#content">
            Luk
        </button>

    </div>
</div>
