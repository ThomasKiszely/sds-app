<article class="standard newPlanDraft rooms">
    <h1>Vælg rum</h1>

    <form hx-post="/newPlanDraft/rooms" hx-target="#content">

        <ul class="item-list">
            <% templates.forEach(t => { %>
                <li>
                    <label class="checkbox-row">
                        <input type="checkbox"
                               name="selectedTemplates"
                               value="<%= t._id %>"
                               class="room-checkbox"
                               data-id="<%= t._id %>">
                        <strong><%= t.name %></strong>
                        — <%= t.defaultSize %> m²
                        — <%= t.bundleType %>
                    </label>

                    <div class="count hidden" id="count-<%= t._id %>">
                        Antal:
                        <input type="number"
                               name="counts[<%= t._id %>]"
                               value="1"
                               min="1">
                    </div>
                </li>
            <% }) %>
        </ul>

        <button>Videre</button>
    </form>

    <button hx-get="/newPlanDraft/customer" hx-target="#content">Tilbage</button>
</article>