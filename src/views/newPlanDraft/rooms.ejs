<article class="standard newPlanDraft rooms">
    <h1>Vælg rum</h1>

    <form hx-post="/newPlanDraft/rooms" hx-target="#content">

        <div class="alphabet-nav">
            <% "ABCDEFGHIJKLMNOPQRSTUVWXYZÆØÅ".split("").forEach(letter => { %>
                <button type="button"
                        class="alpha-btn"
                        data-letter="<%= letter %>">
                    <%= letter %>
                </button>
            <% }) %>
        </div>

        <ul class="item-list">
            <% templates.forEach(t => { %>
                <% const firstLetter = t.name.charAt(0).toUpperCase(); %>

                <li id="letter-<%= firstLetter %>">
                    <label class="checkbox-row">
                        <input type="checkbox"
                               name="selectedTemplates"
                               value="<%= t._id %>"
                               class="room-checkbox"
                               data-id="<%= t._id %>">
                        <strong><%= t.name %></strong>
                        — <%= t.defaultSize %> m²
                        — <%= t.bundleType %>
                    </label>

                    <div class="count hidden" id="count-<%= t._id %>">
                        Antal:
                        <input type="number"
                               name="counts[<%= t._id %>]"
                               value="1"
                               min="1">
                    </div>
                </li>
            <% }) %>
        </ul>


        <button class="button-secondary">Videre</button>
    </form>

    <button class="button-secondary" hx-get="/newPlanDraft/customer" hx-target="#content">Tilbage</button>
</article>