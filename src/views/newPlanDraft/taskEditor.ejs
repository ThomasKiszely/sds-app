<div class="overlay">
    <div class="overlay-content">

        <h1><%= task ? "Rediger opgave" : "Tilføj opgave" %></h1>

        <form hx-post="/newPlanDraft/taskSave"
              hx-target="#content"
              hx-swap="innerHTML">

            <!-- KATEGORI -->
            <label>Kategori</label>
            <select name="category"
                    hx-get="/newPlanDraft/taskSelectTemplate"
                    hx-target="#templateSelectContainer"
                    hx-trigger="change">

                <% Object.keys(categoryTypes).forEach(key => { %>

                    <%
                        const value = categoryTypes[key];
                        const label = categoryLabels[key];

                        // Skjul consumables hvis vi IKKE er i consumables
                        const hideConsumables = (initialCategory !== categoryTypes.consumables && value === categoryTypes.consumables);
                    %>

                    <% if (!hideConsumables) { %>
                        <option value="<%= value %>"
                                <%= (initialCategory === value) ? "selected" : "" %>>
                            <%= label %>
                        </option>
                    <% } %>

                <% }) %>

            </select>


            <!-- TEMPLATE -->
            <div id="templateSelectContainer">
                <label>Opgave</label>
                <select name="templateId"
                        hx-get="/newPlanDraft/taskLoadTemplate?category=<%= initialCategory %>"
                        hx-target="#templateFields"
                        hx-trigger="change"
                        required>
                <option value="">-- Vælg opgave --</option>
                    <% if (templates) { %>
                        <% templates.forEach(tpl => { %>
                            <option value="<%= tpl._id %>"><%= tpl.name %></option>
                        <% }) %>
                    <% } %>
                </select>
            </div>

            <!-- TEMPLATE-FELTER (HTMX loader her) -->
            <div id="templateFields"></div>


            <!-- GEM / ANNULLER -->
            <div style="margin-top: 1.5rem;">
                <button class="button" type="submit">Gem opgave</button>

                <button class="button-secondary"
                        type="button"
                        hx-get="/newPlanDraft/summary"
                        hx-target="#content">
                    Annuller
                </button>
            </div>

        </form>

    </div>
</div>
