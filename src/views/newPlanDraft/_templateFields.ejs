<% if (initialCategory === categoryTypes.consumables) { %>

    <!-- FORBRUGSVARER -->

    <label>Beskrivelse</label>
    <textarea name="description"><%= tpl.description %></textarea>

    <label>Enhed</label>
    <select name="unit">
        <% Object.keys(unitsLabels).forEach(key => { %>
            <option value="<%= key %>" <%= tpl.unit === key ? "selected" : "" %>>
                <%= unitsLabels[key] %>
            </option>
        <% }) %>
    </select>

    <label>Pris pr stk</label>
    <input type="number" name="customPrice" value="<%= tpl.customPrice %>" step="0.01">

    <label>Antal</label>
    <input type="number" name="amount" value="1" min="1">

    <label>Frekvens</label>
    <select name="frequency">
        <% Object.keys(frequencyLabels).forEach(key => { %>
            <option value="<%= key %>" <%= tpl.frequency === key ? "selected" : "" %>>
                <%= frequencyLabels[key] %>
            </option>
        <% }) %>
    </select>


<% } else { %>

    <!-- ALMINDELIGE OPGAVER -->

    <label>Beskrivelse</label>
    <textarea name="description"><%= tpl.description %></textarea>

    <label>Mængde</label>
    <input type="number" name="amount" value="0" step="1">

    <label>Varighed pr. enhed (minutter)</label>
    <input type="number" name="durationPerUnit" value="<%= tpl.durationPerUnit %>" step="1">

    <label>Enhed</label>
    <select name="unit">
        <% Object.keys(unitsLabels).forEach(key => { %>
            <option value="<%= key %>" <%= tpl.unit === key ? "selected" : "" %>>
                <%= unitsLabels[key] %>
            </option>
        <% }) %>
    </select>

    <label>Fast pris pr gang (valgfrit)</label>
    <input type="number" name="customPrice" value="<%= tpl.customPrice %>" step="0.01">

    <label>Dage</label>
    <div>
        <% Object.keys(daysLabels).forEach(day => { %>
            <label class="checkbox-row">
                <input type="checkbox" name="days" value="<%= day %>">
                <%= daysLabels[day] %>
            </label>
        <% }) %>
    </div>

    <label>Frekvens</label>
    <select name="frequency">
        <% Object.keys(frequencyLabels).forEach(key => { %>
            <option value="<%= key %>" <%= tpl.frequency === key ? "selected" : "" %>>
                <%= frequencyLabels[key] %>
            </option>
        <% }) %>
    </select>


<% } %>
