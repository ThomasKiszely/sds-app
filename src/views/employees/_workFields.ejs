<%#
    Kontrakttimer + arbejdstider pr. ugedag. Bruges i Opret- og Rediger-panelet.
    Forventer: employment (kan være undefined), weekDays, weekDayLabels.

    Formularen sender:
      hoursPerWeek            – kontrakttimer pr. uge
      workHours[<dag>][from]  – kun for valgte dage
      workHours[<dag>][to]
    Felter for fravalgte dage er disabled og bliver derfor ikke sendt.
%>
<%
    const job = (typeof employment !== 'undefined' && employment) || {};
    const hoursByDay = {};
    (job.workHours || []).forEach(h => { hoursByDay[h.day] = h; });
%>
<div class="form-group">
    <label for="hoursPerWeek">Kontrakttimer pr. uge</label>
    <input type="number" id="hoursPerWeek" name="hoursPerWeek" min="0" max="500" step="0.5"
           inputmode="decimal" data-contract-hours
           value="<%= job.hoursPerWeek != null ? job.hoursPerWeek : '' %>">
    <p class="field-error" data-error-for="hoursPerWeek" hidden></p>
</div>

<fieldset class="choice-fieldset work-hours" data-work-hours>
    <legend>Arbejdstider</legend>
    <p class="choice-hint muted">Vælg de dage medarbejderen arbejder, og skriv fra- og til-tid for hver dag.</p>

    <div class="work-hours-list">
        <% weekDays.forEach(d => { const h = hoursByDay[d]; const on = Boolean(h); %>
            <div class="work-hours-row<%= on ? '' : ' is-off' %>" data-work-day="<%= d %>">
                <label class="choice-chip work-hours-day">
                    <input type="checkbox" data-work-day-toggle <%= on ? 'checked' : '' %>>
                    <%= weekDayLabels[d] %>
                </label>
                <input type="time" name="workHours[<%= d %>][from]" aria-label="<%= weekDayLabels[d] %> fra"
                       value="<%= on ? h.from : '' %>" data-work-from <%= on ? 'required' : 'disabled' %>>
                <span class="work-hours-sep" aria-hidden="true">–</span>
                <input type="time" name="workHours[<%= d %>][to]" aria-label="<%= weekDayLabels[d] %> til"
                       value="<%= on ? h.to : '' %>" data-work-to <%= on ? 'required' : 'disabled' %>>
                <p class="field-error work-hours-error" hidden></p>
            </div>
        <% }) %>
    </div>

    <p class="work-hours-total" data-work-hours-total aria-live="polite"></p>

    <button type="button" class="btn-small button-secondary work-hours-copy" data-work-hours-copy>
        <%- icon('copy') %> Brug første dags tid på alle valgte dage
    </button>
</fieldset>
