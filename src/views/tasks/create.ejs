<article class="standard tasks-page">
    <h1>Opret opgave-skabelon</h1>

    <form hx-post="/cleaningTaskTemplates" hx-target="#content" hx-swap="innerHTML">
        <label>Navn</label>
        <input type="text" name="name" required>

        <label>Beskrivelse</label>
        <textarea name="description"></textarea>

        <label>Kategori</label>
        <select name="category">
            <% Object.keys(categoryTypes).forEach(key => { %>
                <option value="<%= categoryTypes[key] %>">
                    <%= categoryLabels[key] %>
                </option>
            <% }) %>
        </select>

        <label>Standard varighed (min)</label>
        <input type="number" name="defaultDuration">

        <label>Standard pris (kr)</label>
        <input type="number" name="defaultPrice">

        <label>Enhed</label>
        <select name="unit">
            <% Object.values(units).forEach(u => { %>
                <option value="<%= u %>"><%= u %></option>
            <% }) %>
        </select>

        <button type="submit">Gem</button>
    </form>
</article>
