<article class="standard tasks-page">
    <h1>Rediger opgave-skabelon</h1>

    <form hx-patch="/cleaningTaskTemplates/<%= template._id %>" hx-target="#content">
        <label>Navn</label>
        <input type="text" name="name" value="<%= template.name %>" required>

        <label>Kategori</label>
        <select name="category">
            <% Object.keys(categoryTypes).forEach(key => { %>
                <option value="<%= categoryTypes[key] %>"
                        <%= template.category === categoryTypes[key] ? "selected" : "" %>>
                    <%= categoryLabels[key] %>
                </option>
            <% }) %>
        </select>


        <label>Standard varighed (min)</label>
        <input type="number" name="defaultDuration" value="<%= template.defaultDuration %>">

        <label>Standard pris (kr)</label>
        <input type="number" name="defaultPrice" value="<%= template.defaultPrice %>">

        <label>Enhed</label>
        <select name="unit">
            <% Object.values(units).forEach(u => { %>
                <option value="<%= u %>" <%= template.unit === u ? "selected" : "" %>>
                    <%= u %>
                </option>
            <% }) %>
        </select>

        <button type="submit">Gem ændringer</button>
    </form>
</article>
