<article class="standard admin-user-create-page">
    <h1>Opret ny bruger</h1>

    <form hx-post="/users" hx-target="#content">
        <label for="userName">Brugernavn</label>
        <input type="text" id="userName" name="userName" required>

        <label for="fullName">Fulde navn</label>
        <input type="text" id="fullName" name="fullName" required>

        <label for="position">Stilling</label>
        <input type="text" id="position" name="position">

        <label for="phoneNumber">Telefonnummer</label>
        <input type="text" id="phoneNumber" name="phoneNumber">

        <label for="email">Email</label>
        <input type="email" id="email" name="email">

        <label for="address">Arbejdsadresse</label>
        <input type="text" id="address" name="address">

        <label for="role">Rolle</label>
        <select id="role" name="role" required>
            <option value="admin">Admin</option>
            <option value="user">Bruger</option>
        </select>

        <button type="submit">Opret</button>
    </form>

    <button type="button" class="button-secondary" hx-get="/admin/users" hx-target="#content">Tilbage</button>
</article>
