<article class="standard admin-settings-page">
    <h1>Systemindstillinger</h1>

    <h2>Indeksregulering</h2>

    <form hx-post="/admin/settings/inflation" hx-target="#settings-message">
        <label for="inflationRate">Årlig indeksregulering (%)</label>
        <input
                type="number"
                step="0.1"
                min="0"
                max="<%= maxInflationPercent %>"
                name="inflationRate"
                id="inflationRate"
                value="<%= inflationPercent %>"
                required
        >
        <small>Hæver timeprisen på alle aktive planer hvert år. Maks. <%= maxInflationPercent %>%.</small>

        <button type="submit">Gem</button>
    </form>

    <form hx-post="/admin/settings/environmentalFee" hx-target="#settings-message">
        <label for="environmentalFee">Drift- og miljøtillæg (%)</label>
        <input type="number" step="0.01" name="environmentalFee" id="environmentalFee" value="<%= settings.environmentalFee %>">
        <button type="submit">Gem</button>
    </form>

    <h2>Timepris</h2>

    <form hx-post="/admin/settings/hourlyRate" hx-target="#settings-message">
        <label for="hourlyRate">Timepris (kr/time)</label>
        <input
                type="number"
                step="1"
                name="hourlyRate"
                id="hourlyRate"
                value="<%= settings.hourlyRate %>"
        >
        <button type="submit">Gem</button>
    </form>

    <div id="settings-message"></div>
</article>
