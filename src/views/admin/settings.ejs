<article class="standard admin-settings-page">
    <button type="button" class="back-link" hx-get="/admin" hx-target="#content"><%- icon('arrow-left') %> Admin</button>

    <header class="page-header">
        <div>
            <h1>Priser</h1>
            <p class="page-sub">Priser gælder nye beregninger. Aktive aftaler ændres kun af indeksreguleringen 1. januar.</p>
        </div>
    </header>

    <section class="card settings-grid">
        <form hx-post="/admin/settings/hourlyRate" hx-target="#settings-message">
            <label for="hourlyRate">Timepris</label>
            <div class="input-unit">
                <input type="number" step="1" name="hourlyRate" id="hourlyRate" value="<%= settings.hourlyRate %>">
                <span>kr./time</span>
            </div>
            <button type="submit" class="btn-small"><%- icon('check') %> Gem</button>
        </form>

        <form hx-post="/admin/settings/environmentalFee" hx-target="#settings-message">
            <label for="environmentalFee">Drift- og miljøtillæg</label>
            <div class="input-unit">
                <input type="number" step="0.01" name="environmentalFee" id="environmentalFee" value="<%= settings.environmentalFee %>">
                <span>%</span>
            </div>
            <button type="submit" class="btn-small"><%- icon('check') %> Gem</button>
        </form>

        <form hx-post="/admin/settings/inflation" hx-target="#settings-message">
            <label for="inflationRate">Årlig indeksregulering</label>
            <div class="input-unit">
                <input type="number" step="0.1" min="0" max="<%= maxInflationPercent %>" name="inflationRate" id="inflationRate" value="<%= inflationPercent %>" required>
                <span>%</span>
            </div>
            <small>Hæver timeprisen på alle aktive planer hvert år. Maks. <%= maxInflationPercent %> %.</small>
            <button type="submit" class="btn-small"><%- icon('check') %> Gem</button>
        </form>
    </section>

    <div id="settings-message" role="status"></div>
</article>
