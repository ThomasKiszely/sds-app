<article class="standard admin-settings-page">
    <h1>Systemindstillinger</h1>

    <h2>Inflation</h2>

    <form hx-post="/admin/settings/inflation" hx-target="#settings-message">
        <label for="inflationRate">Inflation (%)</label>
        <input
                type="number"
                step="0.001"
                name="inflationRate"
                id="inflationRate"
                value="<%= settings.inflationRate %>"
        >

        <button>Gem</button>
    </form>

    <div id="settings-message"></div>
</article>
