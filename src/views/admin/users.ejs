<article class="standard admin-users-page">
    <button type="button" class="back-link" hx-get="/admin" hx-target="#content"><%- icon('arrow-left') %> Admin</button>

    <header class="page-header">
        <div class="page-title-row">
            <h1>Brugere</h1>
            <span class="page-count"><%= users.filter(u => u.active).length %> aktive</span>
        </div>
        <div class="page-actions">
            <button type="button" class="btn-primary" hx-get="/users/create" hx-target="#content"><%- icon('plus') %> Opret bruger</button>
        </div>
    </header>

    <table class="data-table responsive-table">
        <thead>
        <tr>
            <th scope="col">Navn</th>
            <th scope="col">Brugernavn</th>
            <th scope="col">Kontakt</th>
            <th scope="col">Rolle</th>
            <th scope="col">Status</th>
            <th scope="col"><span class="visually-hidden">Handlinger</span></th>
        </tr>
        </thead>

        <tbody>
        <% users.forEach(u => { %>
            <% const isSelf = (sessionUserId && u._id.toString() === sessionUserId.toString()); %>

            <tr>
                <td data-label="Navn">
                    <span class="person">
                        <span class="avatar"><%= initials(u.fullName || u.userName) %></span>
                        <span>
                            <strong><%= u.fullName %></strong><% if (isSelf) { %> <span class="tag">Dig</span><% } %>
                            <% if (u.position) { %><div class="list-row-sub"><%= u.position %></div><% } %>
                        </span>
                    </span>
                </td>
                <td data-label="Brugernavn" class="muted"><%= u.userName %></td>
                <td data-label="Kontakt">
                    <%= u.phoneNumber || "–" %>
                    <% if (u.email) { %><div class="list-row-sub"><%= u.email %></div><% } %>
                </td>
                <td data-label="Rolle">
                    <% if (isSelf || !u.active) { %>
                        <%= roleLabel(u.role) %>
                    <% } else { %>
                        <select name="role" aria-label="Rolle for <%= u.fullName %>"
                                hx-patch="/users/<%= u._id %>/role" hx-trigger="change" hx-target="#content">
                            <% Object.values(userRoles).forEach(r => { %>
                                <option value="<%= r %>" <%= u.role === r ? "selected" : "" %>><%= roleLabel(r) %></option>
                            <% }) %>
                        </select>
                    <% } %>
                </td>
                <td data-label="Status">
                    <% if (!u.active) { %>
                        <span class="badge badge-inactive">Deaktiveret</span>
                    <% } else if (u.mustChangePassword) { %>
                        <span class="badge badge-warn">Skal skifte kodeord</span>
                    <% } else { %>
                        <span class="badge badge-active">Aktiv</span>
                    <% } %>
                </td>

                <td class="actions" data-label="Handlinger">
                    <button class="btn-small" hx-get="/users/<%= u._id %>/edit" hx-target="#content">Rediger</button>

                    <% if (!isSelf) { %>
                        <button class="btn-small" hx-patch="/users/<%= u._id %>/reset-password" hx-target="#content">Nulstil kodeord</button>
                    <% } %>

                    <% if (u.active) { %>
                        <% if (!isSelf) { %>
                            <button class="btn-small btn-ghost" hx-delete="/users/<%= u._id %>" hx-target="#content" hx-confirm="Deaktivér bruger?">Deaktivér</button>
                        <% } %>
                    <% } else { %>
                        <button class="btn-small" hx-patch="/users/<%= u._id %>/reactivate" hx-target="#content">Aktivér</button>
                    <% } %>

                    <% if (!isSelf) { %>
                        <button class="btn-small btn-ghost btn-danger"
                                hx-delete="/users/<%= u._id %>/permanent"
                                hx-target="#content"
                                hx-confirm="Slet bruger permanent? Dette kan ikke fortrydes.">
                            Slet helt
                        </button>
                    <% } %>
                </td>
            </tr>
        <% }) %>
        </tbody>
    </table>
</article>
