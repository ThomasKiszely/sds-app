<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="author" content="Thomas BKJ">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SDS prisberegner</title>

    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/components.css">
    <link rel="stylesheet" href="/css/responsive.css">

    <script src="/js/htmx.min.js"></script>
</head>

<body>

<%- include('partials/topbar', { user }) %>

<main id="content">
    <%- include('partials/indexContent', { user }) %>

    <% if (loadMe) { %>
        <button id="__loadMeBtn" style="display:none"
                hx-get="/me" hx-target="#content" hx-swap="innerHTML"></button>
        <script>
            document.getElementById('__loadMeBtn').click();
        </script>
    <% } %>
</main>

<!-- Toast containers -->
<div id="toast-center"></div>

<!-- Toast logic -->
<script>
    function showCenterToast(message) {
        const container = document.getElementById("toast-center");

        const toast = document.createElement("div");
        toast.className = "toast-center";
        toast.textContent = message;

        container.appendChild(toast);

        setTimeout(() => {
            toast.classList.add("hide");
            setTimeout(() => toast.remove(), 500);
        }, 3000);
    }

    // HTMX success toast (HX-Trigger)
    document.body.addEventListener("toast", (event) => {
        let message = event.detail;

        // Hvis HTMX pakker teksten ind i et objekt (f.eks. { value: "..." })
        if (typeof message === "object" && message !== null) {
            message = message.value || message.message || JSON.stringify(message);
        }

        showCenterToast(message);
    });

    // HTMX error toast
    document.body.addEventListener("htmx:responseError", (event) => {
        const xhr = event.detail.xhr;

        // 1) Hvis serveren sendte en tekstbesked → vis den
        if (xhr.responseText && typeof xhr.responseText === "string") {
            const clean = xhr.responseText.replace(/<[^>]+>/g, "").trim();
            if (clean.length > 0) {
                showCenterToast(clean);
                return;
            }
        }

        // 2) Hvis serveren sendte JSON → vis message-feltet
        try {
            const json = JSON.parse(xhr.responseText);
            if (json && json.message) {
                showCenterToast(json.message);
                return;
            }
        } catch (_) {}

        // 3) Fallback
        showCenterToast("Der opstod en fejl");
    });
</script>

<!-- HTMX History -->
<script>
    const contentEl = document.querySelector('#content');

    let htmxHistory = [{
        html: contentEl.innerHTML,
        scroll: 0,
        url: window.location.pathname
    }];

    document.body.addEventListener('htmx:afterSwap', (evt) => {
        if (evt.detail.target.id !== "content") return;

        const newEntry = {
            html: evt.detail.target.innerHTML,
            scroll: window.scrollY,
            url: evt.detail.xhr.responseURL
        };

        const last = htmxHistory[htmxHistory.length - 1];

        if (last && last.url === newEntry.url) return;

        htmxHistory.push(newEntry);
    });

    function htmxBack() {
        if (htmxHistory.length <= 1) return;

        htmxHistory.pop();

        const prev = htmxHistory[htmxHistory.length - 1];

        contentEl.innerHTML = prev.html;
        window.scrollTo(0, prev.scroll);

        htmx.process(contentEl);
    }
</script>

</body>
</html>
