<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
<!--    <meta name="description" content="Kort beskrivelse til søgemaskiner.">-->
    <meta name="author" content="Thomas BKJ">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SDS prisberegner</title>
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/components.css">
    <link rel="stylesheet" href="/css/responsive.css">
    <script src="/js/htmx.min.js"></script>
</head>

<body>

<%- include('partials/topbar', { user }) %>

<main id="content">
    <%- include('partials/indexContent', { user }) %>

    <% if (loadMe) { %>
        <!-- Use a hidden HTMX-trigger element so the request is recorded in browser history (hx-push-url) -->
        <button id="__loadMeBtn" style="display:none"
                hx-get="/me" hx-target="#content" hx-swap="innerHTML"></button>
        <script>
            // Trigger the hidden button so HTMX performs the request and pushes the URL to history
            document.getElementById('__loadMeBtn').click();
        </script>
    <% } %>


</main>

<div id="toast-container"></div>

<div id="toast-center"></div>

<script>
    document.body.addEventListener("htmx:responseError", (event) => {
        showCenterToast(event.detail.xhr.responseText);
    });

    function showCenterToast(message) {
        const container = document.getElementById("toast-center");

        const toast = document.createElement("div");
        toast.className = "toast-center";
        toast.textContent = message;

        container.appendChild(toast);

        setTimeout(() => {
            toast.classList.add("hide");
            setTimeout(() => toast.remove(), 500);
        }, 3000);
    }
</script>

<script>
    const contentEl = document.querySelector('#content');

    let htmxHistory = [{
        html: contentEl.innerHTML,
        scroll: 0,
        url: window.location.pathname
    }];

    document.body.addEventListener('htmx:afterSwap', (evt) => {
        if (evt.detail.target.id !== "content") return;

        const newEntry = {
            html: evt.detail.target.innerHTML,
            scroll: window.scrollY,
            url: evt.detail.xhr.responseURL   // ⭐ Den rigtige URL
        };

        const last = htmxHistory[htmxHistory.length - 1];

        // ⭐ Undgå duplikate sider
        if (last && last.url === newEntry.url) return;

        htmxHistory.push(newEntry);
    });

    function htmxBack() {
        if (htmxHistory.length <= 1) return;

        // Fjern nuværende
        htmxHistory.pop();

        // Kig på forrige uden at fjerne den
        const prev = htmxHistory[htmxHistory.length - 1];

        contentEl.innerHTML = prev.html;
        window.scrollTo(0, prev.scroll);

        htmx.process(contentEl);
    }

</script>






</body>
</html>
