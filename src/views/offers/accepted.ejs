<!DOCTYPE html>
<html lang="da">
<head>
    <%- include('partials/publicHead') %>
    <title>Tak for din accept – SDS</title>
</head>

<body>
<%- include('partials/publicHeader') %>

<main id="content" class="public-wrap">
    <article class="public-card offer-accept-page">
        <div class="result-icon"><%- icon('check') %></div>
        <h1>Tak, <%= offer.acceptedByName %></h1>
        <p class="page-sub">Vi har modtaget din accept af tilbuddet.</p>

        <div class="list" style="margin-top: 16px">
            <div class="list-row"><%- icon('file-check') %><span class="list-row-main">Rengøringsplanen er nu aktiveret.</span></div>
            <div class="list-row"><%- icon('phone') %><span class="list-row-main">SDS kontakter dig snarest for at aftale opstart.</span></div>
            <div class="list-row"><%- icon('file-text') %><span class="list-row-main">Kontrakten er lavet og sendt til SDS.</span></div>
        </div>
    </article>
</main>
</body>
</html>
