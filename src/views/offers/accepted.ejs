</head>

<body>

<main id="content">
    <article class="standard">

        <h1>Tak for din accept</h1>

        <p>
            Tak, <strong><%= offer.acceptedByName %></strong>.<br>
            Vi har modtaget din accept af tilbuddet.
        </p>

