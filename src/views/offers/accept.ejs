<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <title>Acceptér tilbud – SDS</title>

    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/components.css">
    <link rel="stylesheet" href="/css/responsive.css">
</head>

<body>

<main id="content">
    <article class="standard">

        <h1>Acceptér tilbud</h1>

        <p>
            Du er ved at acceptere tilbuddet for:
            <strong><%= customer.customerName %></strong><br>
            <%= street %><br>
            <%= zip %> <%= city %>
        </p>

        <p>
            Den samlede pris for rengøringen er:
            <strong><%= offer.snapshot.plan.totalMonthlyPrice.toFixed(2) %> kr. pr. måned</strong>
            ekskl. moms.
        </p>

        <form method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <label for="name">Dit navn</label>
            <input type="text" id="name" name="name" required>

            <label for="email">Din email</label>
            <input type="email" id="email" name="email" required>

            <button type="submit">Accepter tilbud</button>
        </form>

    </article>
</main>

</body>
</html>
