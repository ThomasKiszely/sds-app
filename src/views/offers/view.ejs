<article class="standard offer-document">

    <!-- LOGO -->
    <div class="offer-document-logo-row">
        <img class="offer-document-logo" src="/images/sds-logo-red.png" alt="SDS logo">
    </div>

    <!-- STATUS -->
    <% if (offer.status === "accepted") { %>
        <p class="offer-status offer-status-accepted">
            <strong>Tilbud accepteret</strong><br>
            Accepteret af: <%= offer.acceptedByName %> (<%= offer.acceptedByEmail %>)<br>
            Dato: <%= offer.acceptedAt.toLocaleDateString("da-DK") %>
        </p>

    <% } else if (offer.status === "sent") { %>
        <p class="offer-status offer-status-sent">
            <strong>Tilbud genereret. Download for at sende</strong><br>
            Sendt: <%= offer.updatedAt.toLocaleDateString("da-DK") %>
        </p>

    <% } else { %>
        <p class="offer-status offer-status-draft">
            <strong>Tilbud oprettet</strong><br>
            Dette tilbud er endnu ikke sendt til kunden.
        </p>
    <% } %>

    <!-- TOP: MODTAGER + DATO -->
    <div class="offer-top-line">
        <div class="offer-recipient">
            <div><strong><%= snapshot.customer.name %></strong></div>
            <div><%= snapshot.customer.street %></div>
            <div><%= snapshot.customer.zip %> <%= snapshot.customer.city %></div>
            <% if (snapshot.customer.contactPerson?.name) { %>
                <div>Att. <%= snapshot.customer.contactPerson.name %></div>
            <% } %>
        </div>

        <div class="offer-date">
            <%= snapshot.customer.city ? snapshot.customer.city + "," : "" %>
            <%= offer.createdAt.toLocaleDateString("da-DK", { day: "numeric", month: "long", year: "numeric" }) %>
        </div>
    </div>

    <p>
        Hej <%= (snapshot.customer.contactPerson?.name || snapshot.customer.name).split(" ")[0] %>
    </p>

    <p>Som aftalt sender jeg et tilbud på baggrund af den fremsendte rengøringsplan.</p>

    <hr>

    <!-- FAST PRIS -->
    <section>
        <h3>Fast pris for rengøring</h3>

        <p>
            Prisen for rengøring jf. rengøringsplanen andrager
            <span class="offer-price"><%= snapshot.plan.totalMonthlyPrice.toFixed(2) %> kr.</span>
            ekskl. moms pr. måned.
        </p>

        <% if (snapshot.plan.environmentalFeePercent > 0) { %>
            <p>
                Heri er indregnet et drifts- og miljøtillæg på <%= snapshot.plan.environmentalFeePercent %>%,
                svarende til <%= snapshot.plan.environmentalFeeAmount.toFixed(2) %> kr.
            </p>
        <% } %>

        <p>
            Betalingsbetingelser: <%= snapshot.plan.paymentTermsLabel || snapshot.plan.paymentTerms %><br>
            Opsigelsesvarsel: <%= snapshot.plan.terminationNoticeLabel %>
        </p>
    </section>

    <hr>

    <!-- EKSTRA OPGAVER -->
    <section>
        <h3>Ekstra opgaver</h3>

        <p>De ekstra opgaver som fremgår på planen, bliver faktureret på timepris + materialer.</p>

        <p>Timeprisen andrager kroner ekskl. moms <%= Number(snapshot.plan.hourlyRate || 0).toFixed(2) %>,-</p>
    </section>

    <hr>

    <!-- FORBRUGSVARER -->
    <% if (snapshot.consumables && snapshot.consumables.length > 0) { %>
        <section>
            <h3>Forbrugsvarer</h3>

            <ul>
                <% snapshot.consumables.forEach(c => { %>
                    <li>
                        <%= c.name %> &ndash; <%= c.amount %> <%= c.unitLabel %>
                        &ndash; pris <%= Number(c.pricePerUnit || 0).toFixed(2) %> kr ekskl. moms
                    </li>
                <% }) %>
            </ul>
        </section>

        <hr>
    <% } %>

    <!-- AFSLUTNING -->
    <section>
        <p class="offer-closing-note">
            Ovenstående rengøringsvederlag indeholder løn til medarbejdere, feriepenge, ATP og rengøringsmidler,
            samt andre omkostninger der er forbundet med at servicere jer, herunder egenkontrol.
        </p>

        <p class="offer-closing-note">
            Hvis der er spørgsmål eller ønsker om yderligere information, er du selvfølgelig velkommen til at kontakte mig.
        </p>
    </section>

    <!-- ACCEPT-LINK -->
    <div class="offer-accept-box">
        <p>Tilbuddet accepteres digitalt via nedenstående link:</p>
<!--        <a href="<%= snapshot.signatureLink %>"><%= snapshot.signatureLink %></a>-->
    </div>

    <!-- UNDERSKRIFT -->
    <div class="offer-signoff">
        <p>Med venlig hilsen</p>

        <p>
            <strong><%= snapshot.sender?.fullName || "SDS Rengøring" %></strong>
            <% if (snapshot.sender?.position) { %><%= snapshot.sender.position %><br><% } %>
            SDS Rengøring<br>
            <%= senderAddress.street %><br>
            <%= senderAddress.zip %> <%= senderAddress.city %><br>
            Tlf. <%= snapshot.sender?.phoneNumber || "72 41 10 01" %>
            <% if (snapshot.sender?.email) { %><br><%= snapshot.sender.email %><% } %>
        </p>
    </div>

    <hr>

    <!-- DOWNLOAD -->
    <div class="offer-downloads">
        <a href="/offers/<%= offer._id %>/pdf" class="button-link" target="_blank">
            Download tilbud (PDF)
        </a>

        <a href="/cleaningPlans/<%= offer.planId %>/planPdf" class="button-link" target="_blank">
            Download rengøringsplan (PDF)
        </a>
    </div>

</article>
