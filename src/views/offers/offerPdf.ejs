<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <title>Tilbud</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            padding: 40px;
            color: #333;
        }

        .header {
            border-bottom: 2px solid #000;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }

        .company-info {
            float: right;
            text-align: right;
        }

        .customer-info {
            margin-top: 20px;
            margin-bottom: 30px;
        }

        h1 {
            margin-bottom: 0;
        }

        h2, h3 {
            margin-bottom: 0.3rem;
        }

        .section {
            margin-bottom: 1.5rem;
        }

        .tasks ul {
            margin-top: 0.3rem;
        }

        .total-box {
            border-top: 2px solid #000;
            padding-top: 1rem;
            margin-top: 1rem;
            font-size: 1.2rem;
        }

        .discount {
            color: #008000;
        }

        .footer {
            margin-top: 40px;
            font-size: 0.9rem;
            color: #666;
            border-top: 1px solid #ccc;
            padding-top: 10px;
        }
    </style>
</head>
<body>

<div class="header">
    <div class="company-info">
        <strong>SDS</strong><br>
        Maglemølle 25<br>
        4700 Næstved<br>
        CVR: 12345678<br>
        Telefon: 72 41 10 01<br>
        Email: info@s-ds.dk
    </div>

    <h1>Tilbud</h1>
    <p>Tilbudsnummer: <%= offer._id %><br>
        Dato: <%= new Date().toLocaleDateString("da-DK") %></p>
</div>

<div class="customer-info">
    <h2>Kunde</h2>
    <p>
        <strong><%= customer.name %></strong><br>
        <%= customer.address %><br>
        <%= customer.zip %> <%= customer.city %><br>
        Email: <%= customer.email %>
    </p>
</div>

<div class="section tasks">
    <h2>Opgaver</h2>

    <% const groups = { daily: [], extra: [], consumables: [], windows: [] }; %>
    <% tasks.forEach(t => groups[t.category].push(t)); %>

    <% if (groups.daily.length) { %>
        <h3>Daglig</h3>
        <ul>
            <% groups.daily.forEach(t => { %>
                <li><strong><%= t.name %></strong> — <%= t.price * t.quantity %> kr.</li>
            <% }) %>
        </ul>
    <% } %>

    <% if (groups.extra.length) { %>
        <h3>Ekstra</h3>
        <ul>
            <% groups.extra.forEach(t => { %>
                <li><strong><%= t.name %></strong> — <%= t.price * t.quantity %> kr.</li>
            <% }) %>
        </ul>
    <% } %>

    <% if (groups.consumables.length) { %>
        <h3>Forbrugsvare</h3>
        <ul>
            <% groups.consumables.forEach(t => { %>
                <li><strong><%= t.name %></strong> — <%= t.price * t.quantity %> kr.</li>
            <% }) %>
        </ul>
    <% } %>

    <% if (groups.windows.length) { %>
        <h3>Vinduespudsning</h3>
        <ul>
            <% groups.windows.forEach(t => { %>
                <li><strong><%= t.name %></strong> — <%= t.price * t.quantity %> kr.</li>
            <% }) %>
        </ul>
    <% } %>
</div>

<div class="section total-box">
    <p>Subtotal: <%= subtotal %> kr.</p>

    <% if (discountPercent > 0) { %>
        <p class="discount">Rabat (<%= discountPercent %>%): -<%= discountAmount %> kr.</p>
    <% } %>

    <p>Drift og miljøtillæg (<%= environmentalFee %>%): <%= environmentalFeeAmount %> kr.</p>

    <h2>Total: <%= total %> kr.</h2>
</div>

<div class="section">
    <h2>Accept af tilbud</h2>
    <p>Klik her for at acceptere tilbuddet:</p>
    <p><a href="<%= signatureLink %>"><%= signatureLink %></a></p>
</div>

<div class="footer">
    Service Division Sjælland – Professionel rengøring og service<br>
    Dette tilbud er gyldigt i 30 dage fra modtagelse.
</div>

</body>
</html>
