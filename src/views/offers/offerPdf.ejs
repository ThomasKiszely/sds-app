<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <title>Tilbud</title>
    <style>
        body { font-family: Arial, sans-serif; padding: 40px; color: #333; }
        .header { border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; }
        .company-info { float: right; text-align: right; }
        .customer-info { margin-top: 20px; margin-bottom: 30px; }
        h1 { margin-bottom: 0; }
        h2, h3 { margin-bottom: 0.3rem; }
        .section { margin-bottom: 1.5rem; }
        .tasks ul { margin-top: 0.3rem; }
        .discount { color: #008000; }
        .footer { margin-top: 40px; font-size: 0.9rem; color: #666; border-top: 1px solid #ccc; padding-top: 10px; }
    </style>
</head>
<body>

<div class="header">
    <div class="company-info">
        <strong>SDS Rengøring</strong><br>
        Maglemølle 25<br>
        4700 Næstved<br>
        CVR: 12345678<br>
        Telefon: 72 41 10 01<br>
        Email: info@s-ds.dk
    </div>

    <h1>Tilbud</h1>
    <p>
        Tilbudsnummer: <%= offer._id %><br>
        Dato: <%= offer.createdAt.toLocaleDateString("da-DK") %>
    </p>
</div>

<div class="customer-info">
    <h2>Kunde</h2>
    <p>
        <strong><%= snapshot.customer.name %></strong><br>
        <%= snapshot.customer.street %><br>
        <%= snapshot.customer.zip %> <%= snapshot.customer.city %><br>
        Email: <%= snapshot.customer.email %><br>
        Kontaktperson: <%= snapshot.customer.contactPerson?.name %><br>
        Telefon: <%= snapshot.customer.contactPerson?.phone %>
    </p>
</div>

<div class="section">
    <h2>Fast pris for rengøring</h2>

    <p>Den samlede pris for rengøring jf. rengøringsplanen andrager:</p>

    <p style="font-size: 1.3rem; font-weight: bold;">
        <%= snapshot.plan.totalMonthlyPrice.toFixed(2) %> kr. ekskl. moms pr. måned
    </p>

    <% if (snapshot.plan.discountPercent > 0) { %>
        <p class="discount">
            Rabat: <%= snapshot.plan.discountAmount.toFixed(2) %> kr
        </p>
    <% } %>

    <% if (snapshot.plan.environmentalFeePercent > 0) { %>
        <p>
            Drift- og miljøtillæg:
            <%= snapshot.plan.environmentalFeeAmount.toFixed(2) %> kr
        </p>
    <% } %>

    <p>
        Betalingsbetingelser: <%= snapshot.plan.paymentTerms %><br>
        Opsigelsesvarsel: <%= snapshot.plan.terminationNoticeLabel %>
    </p>
</div>

<div class="section tasks">
    <h2>Opgaver</h2>

    <% snapshot.tasks.forEach(t => { %>
        <p>
            <strong><%= t.name %></strong><br>
            Frekvens: <%= t.frequencyLabel %><br>
            Pris pr. måned: <%= t.monthlyPrice.toFixed(2) %> kr.
        </p>
    <% }) %>

    <% if (snapshot.consumables.length) { %>
        <h3>Forbrugsvarer</h3>
        <% snapshot.consumables.forEach(c => { %>
            <p>
                <strong><%= c.name %></strong><br>
                Mængde: <%= c.amount %> stk<br>
                Pris pr. stk: <%= c.pricePerUnit %> kr ekskl. moms<br>
                <% if (c.description) { %>
                    <em><%= c.description %></em>
                <% } %>
            </p>
        <% }) %>
    <% } %>
</div>

<div class="section">
    <h2>Accept af tilbud</h2>
    <p>Klik her for at acceptere tilbuddet:</p>
    <p><a href="<%= snapshot.signatureLink %>"><%= snapshot.signatureLink %></a></p>
</div>

<div class="footer">
    Service Division Sjælland – Professionel rengøring og service<br>
    Dette tilbud er gyldigt i 30 dage fra modtagelse.
</div>

</body>
</html>
