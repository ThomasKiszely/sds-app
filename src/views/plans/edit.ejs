<article class="standard wizard-step">

    <h1>Rediger rengøringsplan</h1>

    <section class="plan-info">
        <p>
            Kunde: <strong><%= customer.customerName %></strong><br>
            Adresse: <%= street %>, <%= zip %> <%= city %><br>
            Plan: <strong><%= plan.name %></strong>
        </p>


    </section>

    <hr>

    <!-- TASKLISTE -->
    <section>
        <h2>Opgaver i planen</h2>

        <div class="embedded-step">
            <%- include("../newPlan/partials/tasks/taskList", {
            tasks,
            grouped,
            roomNotes,
            frequencyLabels,
            daysLabels,
            planId: plan._id,
            monthlyTotal
            }) %>
        </div>
    </section>

    <hr>

    <!-- TASK EDITOR -->
    <section>
        <h2>Tilføj / rediger opgaver</h2>

        <div class="embedded-step">
            <%- include("../newPlan/partials/tasks", {
            planId: plan._id
            }) %>
        </div>
        <div class="form-actions">

            <button class="button"
                    hx-get="/cleaningPlans/<%= plan._id %>/planPdf"
                    hx-target="#content">
                Download PDF
            </button>
        </div>
    </section>

</article>
