<article class="standard wizard-step">

    <h1>Rediger rengøringsplan</h1>

    <section class="plan-info">
        <p>
            Kunde: <strong><%= customer.customerName %></strong><br>
            Adresse: <%= street %>, <%= zip %> <%= city %><br>
            Plan: <strong><%= plan.name %></strong>
        </p>
    </section>

    <hr>

    <section>
        <h2>Opgaver i planen</h2>

        <%- include("../newPlan/partials/tasks/taskList", {
        tasks,
        grouped,
        roomNotes,
        frequencyLabels,
        daysLabels,
        planId: plan._id,
        monthlyTotal
        }) %>
    </section>

    <hr>

    <section class="form-actions">

        <!-- Gå til den rigtige Tilføj opgaver-side -->
        <button class="button"
                hx-get="/newPlan/tasks?planId=<%= plan._id %>"
                hx-target="#content">
            Tilføj / rediger opgaver
        </button>

        <button class="button-secondary"
                hx-get="/cleaningPlans/<%= plan._id %>/planPdf"
                hx-target="#content">
            Download PDF
        </button>

    </section>

</article>
