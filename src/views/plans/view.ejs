<article class="standard cleaning-plan">

    <!-- ⭐ PROGRAMKODE-FORKLARING -->
    <section class="programcode-info">
        <h2>Forklaring på programkoder</h2>
        <p>Alle lokaler der skal rengøres, er forsynet med en programkode. Programkoder aflæses som vist herunder.</p>

        <table class="programcode-table">
            <thead>
            <tr>
                <th>5</th>
                <th>2</th>
                <th>1</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td>Det første ciffer angiver antal gange per uge rengøringspersonalet er i lokalet (soignering)</td>
                <td>Det andet ciffer angiver det antal gange per uge, der udføres grundig rengøring af gulv i lokalet.</td>
                <td>Det tredje ciffer angiver det antal gange per uge der udføres grundig rengøring af inventar i lokalet</td>
            </tr>
            </tbody>
        </table>
    </section>

    <hr>

    <!-- ⭐ LOKALEFORTEGNELSE -->
    <section class="room-list">
        <h2>Lokalefortegnelse og Programkoder</h2>

        <table class="room-table">
            <thead>
            <tr>
                <th>Lokalebetegnelse</th>
                <th>Programkode</th>
                <th>Bemærkninger</th>
            </tr>
            </thead>
            <tbody>

            <% for (const roomName in grouped) { %>

                <%
                    const programCode = grouped[roomName].programCode;
                    const notesEntry = roomNotes.find(r => r.roomName === roomName);
                    const notes = notesEntry ? notesEntry.notes : [];
                %>

                <tr>
                    <td><%= roomName %></td>
                    <td><%= programCode %></td>
                    <td>
                        <% if (notes.length > 0) { %>
                            <% notes.forEach(n => { %>
                                <div><%= n %></div>
                            <% }) %>
                        <% } %>
                    </td>
                </tr>

            <% } %>

            </tbody>
        </table>
    </section>

    <hr>

    <!-- ⭐ RENGØRINGSINSTRUKTION -->
    <section class="instructions">
        <h2>Rengøringsinstruktion</h2>

        <h3>Hver gang udføres (1. ciffer i programkoden)</h3>
        <p><strong>Inventarrengøring:</strong><br>
            Udluftning – Vinduer lukkes efter endt rengøring<br>
            Papirkurve tømmes<br>
            Nye pletter fjernes<br>
            Skifte klude og hviskestykker i køkken
        </p>

        <p><strong>Inventarrengøring sanitære områder:</strong><br>
            Håndvaske, armatur, spejle, hylder, dørgreb mv. rengøres<br>
            Toilet og anden sanitet rengøres<br>
            Opfyldning af forbrugsvare<br>
            Udskift madam/skraldepose
        </p>

        <p><strong>Gulvrengøring:</strong><br>
            Tæpper støvsuges der hvor det er nødvendigt<br>
            Hårde gulve støvsuges hvor det er nødvendigt<br>
            Gulve i sanitære områder støvsuges og vaskes hver gang
        </p>

        <h3>Ved grundig gulvrengøring (2. ciffer)</h3>
        <p>
            Tæpper støvsuges grundigt fra væg til væg<br>
            Hårde gulve støvsuges/tørmoppes og vaskes fra væg til væg
        </p>

        <h3>Ved grundig inventarrengøring (3. ciffer)</h3>
        <p>
            Skriveborde og øvrige borde rengøres grundigt<br>
            Lavthængende lamper, vindueskarme, dørgreb rengøres<br>
            Hylder, skærme, reoler mv. indtil 180 cm rengøres<br>
            Aftørring kaffeautomat<br>
            Aftørring af borde<br>
            Stole i kantine efterses
        </p>
    </section>

    <hr>

    <!-- ⭐ ØVRIGE OPGAVER (uden programkode) -->
    <section class="other-tasks">
        <h2>Øvrige opgaver</h2>

        <!-- ⭐ Opgaver uden rum -->
        <% if (noRoomTasks.length > 0) { %>
            <h3>Opgaver uden rum</h3>
            <ul>
                <% noRoomTasks.forEach(t => { %>
                    <li>
                        <strong><%= t.name %></strong>
                        – <%= frequencyLabels[t.frequency] %>
                        – <%= t.monthlyPrice.toLocaleString("da-DK", { minimumFractionDigits: 2 }) %> kr./måned
                        <% if (t.description) { %><div><em><%= t.description %></em></div><% } %>
                    </li>
                <% }) %>
            </ul>
            <hr>
        <% } %>

        <!-- ⭐ Ad hoc -->
        <% if (adHocTasks.length > 0) { %>
            <h3>Pris pr gang – Ad hoc / Vinduer / Efter aftale</h3>
            <ul>
                <% adHocTasks.forEach(t => { %>
                    <li>
                        <strong><%= t.name %></strong>
                        – <%= (t.customPrice ?? 0).toLocaleString("da-DK", { minimumFractionDigits: 2 }) %> kr pr gang
                        <% if (t.description) { %><div><em><%= t.description %></em></div><% } %>
                    </li>
                <% }) %>
            </ul>
            <hr>
        <% } %>

        <!-- ⭐ Forbrugsvarer -->
        <% if (consumables.length > 0) { %>
            <h3>Tilkøb – Forbrugsvarer</h3>
            <ul>
                <% consumables.forEach(c => { %>
                    <li>
                        <strong><%= c.name %></strong>
                        – <%= (c.customPrice ?? 0).toLocaleString("da-DK", { minimumFractionDigits: 2 }) %> kr pr stk
                        – <%= c.quantity %> stk
                        <% if (c.description) { %><div><em><%= c.description %></em></div><% } %>
                    </li>
                <% }) %>
            </ul>
            <p><em>Faktureres efter forbrug</em></p>
        <% } %>
    </section>

</article>
