<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <title>Rengøringsplan</title>

    <style>
        body { font-family: Arial, sans-serif; padding: 40px; color: #333; }
        h1, h2, h3 { margin-bottom: 0.4rem; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 1.5rem; }
        th, td { border: 1px solid #ccc; padding: 6px; vertical-align: top; }
        .section { margin-bottom: 2rem; }
        .notes div { margin-bottom: 4px; }
        .header { border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px; }
        .company-info { float: right; text-align: right; }
        .clear { clear: both; }
    </style>
</head>

<body>

<div class="header">
    <div class="company-info">
        <strong>SDS Rengøring</strong><br>
        Maglemølle 25<br>
        4700 Næstved<br>
        CVR: 12345678<br>
        Telefon: 72 41 10 01<br>
        Email: info@s-ds.dk
    </div>

    <h1>Rengøringsplan</h1>
    <p>
        Kunde: <strong><%= plan.customerName %></strong><br>
        Adresse: <%= plan.location %><br>
        Dato: <%= new Date().toLocaleDateString("da-DK") %>
    </p>
</div>

<div class="clear"></div>

<!-- PROGRAMKODE-FORKLARING -->
<section class="section">
    <h2>Forklaring på programkoder</h2>
    <p>Alle lokaler der skal rengøres, er forsynet med en programkode. Programkoder aflæses som vist herunder.</p>

    <table>
        <thead>
        <tr>
            <th>5</th>
            <th>2</th>
            <th>1</th>
        </tr>
        </thead>
        <tbody>
        <tr>
            <td>Det første ciffer angiver antal gange per uge rengøringspersonalet er i lokalet (soignering)</td>
            <td>Det andet ciffer angiver det antal gange per uge, der udføres grundig rengøring af gulv i lokalet.</td>
            <td>Det tredje ciffer angiver det antal gange per uge der udføres grundig rengøring af inventar i lokalet</td>
        </tr>
        </tbody>
    </table>
</section>

<hr>

<!-- LOKALEFORTEGNELSE -->
<section class="section">
    <h2>Lokalefortegnelse og Programkoder</h2>

    <table>
        <thead>
        <tr>
            <th>Lokalebetegnelse</th>
            <th>Programkode</th>
            <th>Bemærkninger</th>
        </tr>
        </thead>
        <tbody>

        <% for (const roomName in grouped) { %>

            <%
                const programCode = grouped[roomName].programCode;
                const notesEntry = roomNotes.find(r => r.roomName === roomName);
                const notes = notesEntry ? notesEntry.notes : [];
            %>

            <tr>
                <td><%= roomName %></td>
                <td><%= programCode %></td>
                <td class="notes">
                    <% if (notes.length > 0) { %>
                        <% notes.forEach(n => { %>
                            <div><%= n %></div>
                        <% }) %>
                    <% } %>
                </td>
            </tr>

        <% } %>

        </tbody>
    </table>
</section>

<hr>

<!-- RENGØRINGSINSTRUKTION -->
<section class="section">
    <h2>Rengøringsinstruktion</h2>

    <!-- 1. ciffer – soignering -->
    <h3>Hver gang udføres (1. ciffer i programkoden)</h3>
    <p>
        <% dailyDescriptions.forEach(d => { %>
    <div><%= d %></div>
    <% }) %>
    </p>

    <!-- 2. ciffer – gulv -->
    <h3>Ved grundig gulvrengøring udføres følgende (2. ciffer)</h3>
    <p>
        <% floorDescriptions.forEach(d => { %>
    <div><%= d %></div>
    <% }) %>
    </p>

    <!-- 3. ciffer – inventar -->
    <h3>Ved grundig inventarrengøring udføres følgende (3. ciffer)</h3>
    <p>
        <% inventoryDescriptions.forEach(d => { %>
    <div><%= d %></div>
    <% }) %>
    </p>
</section>

<!-- ØVRIGE OPGAVER -->
<section class="section">
    <h2>Øvrige opgaver</h2>

    <% if (noRoomTasks.length > 0) { %>
        <h3>Opgaver uden rum</h3>
        <ul>
            <% noRoomTasks.forEach(t => { %>
                <li>
                    <strong><%= t.name %></strong>
                    – <%= frequencyLabels[t.frequency] %>
                    – <%= t.monthlyPrice.toLocaleString("da-DK", { minimumFractionDigits: 2 }) %> kr./måned
                    <% if (t.description) { %><div><em><%= t.description %></em></div><% } %>
                </li>
            <% }) %>
        </ul>
        <hr>
    <% } %>

    <% if (adHocTasks.length > 0) { %>
        <h3>Pris pr gang – Ad hoc / Vinduer / Efter aftale</h3>
        <ul>
            <% adHocTasks.forEach(t => { %>
                <li>
                    <strong><%= t.name %></strong>
                    – <%= (t.customPrice ?? 0).toLocaleString("da-DK", { minimumFractionDigits: 2 }) %> kr pr gang
                    <% if (t.description) { %><div><em><%= t.description %></em></div><% } %>
                </li>
            <% }) %>
        </ul>
        <hr>
    <% } %>

    <% if (consumables.length > 0) { %>
        <h3>Tilkøb – Forbrugsvarer</h3>
        <ul>
            <% consumables.forEach(c => { %>
                <li>
                    <strong><%= c.name %></strong>
                    – <%= (c.customPrice ?? 0).toLocaleString("da-DK", { minimumFractionDigits: 2 }) %> kr pr stk
                    – <%= c.amount %> stk
                    <% if (c.description) { %><div><em><%= c.description %></em></div><% } %>
                </li>
            <% }) %>
        </ul>
        <p><em>Faktureres efter forbrug</em></p>
    <% } %>
</section>

</body>
</html>
