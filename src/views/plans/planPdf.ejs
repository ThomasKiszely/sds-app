<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="UTF-8">
    <title>Rengøringsplan</title>

    <style>
        * { box-sizing: border-box; }

        body {
            font-family: Calibri, Arial, sans-serif;
            font-size: 11pt;
            line-height: 1.5;
            color: #1a1a1a;
            margin: 0;
        }

        h1, h2, h3 {
            color: #000;
            margin: 0 0 8pt;
        }

        h1 { font-size: 16pt; text-align: center; }
        h2 { font-size: 13pt; }
        h3 { font-size: 11.5pt; }

        p { margin: 0 0 8pt; }

        .intro {
            text-align: center;
            margin-bottom: 16pt;
        }

        .section {
            margin-bottom: 20pt;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 10pt;
        }

        th, td {
            border: 1px solid #000;
            padding: 6pt 8pt;
            vertical-align: top;
            text-align: left;
        }

        th {
            background: #fff;
            color: #000;
            text-align: center;
        }

        .code-table td {
            text-align: center;
        }

        .notes div {
            margin-bottom: 3pt;
        }

        .notes div:last-child {
            margin-bottom: 0;
        }

        .customer-block {
            margin-bottom: 16pt;
        }

        .customer-block div {
            margin-bottom: 1pt;
        }

        ul {
            margin: 4pt 0 10pt;
            padding-left: 18pt;
        }

        li {
            margin-bottom: 4pt;
        }

        .task-desc {
            color: #555;
            font-style: italic;
        }

        .instruction-box {
            border: 1px solid #000;
            border-left: 4px solid #000;
            border-radius: 4px;
            padding: 10pt 14pt;
            margin-bottom: 12pt;
            break-inside: avoid;
        }

        .instruction-box h3 {
            margin-top: 0;
        }

        .instruction-box ul {
            margin-bottom: 0;
        }

        .instruction-box li:last-child {
            margin-bottom: 0;
        }

        .page-break {
            page-break-before: always;
        }
    </style>
</head>

<body>

<!-- FORKLARING PÅ PROGRAMKODER -->
<section class="section">
    <h1>Forklaring på programkoder</h1>

    <p class="intro">
        Alle lokaler der skal rengøres, er forsynet med en programkode.<br>
        Programkoder aflæses som vist herunder.
    </p>
</section>

<!-- KUNDEOPLYSNINGER -->
<section class="section customer-block">
    <h2>Kundeoplysninger</h2>

    <div><strong><%= customer?.customerName %></strong></div>
    <% if (location?.name) { %><div><%= location.name %></div><% } %>
    <div><%= street %></div>
    <div><%= zip %> <%= city %></div>
    <% if (location?.contactPerson?.name) { %>
        <div>Att. <%= location.contactPerson.name %></div>
    <% } %>
</section>

<% if (operatingDays) { %>
    <h2>Rengøring udføres <%= operatingDays %></h2>
<% } %>

<!-- PROGRAMKODE-EKSEMPEL -->
<section class="section">
    <table class="code-table">
        <thead>
        <tr>
            <th>5</th>
            <th>2</th>
            <th>1</th>
        </tr>
        </thead>
        <tbody>
        <tr>
            <td>Det første ciffer angiver antal gange per uge rengøringspersonalet er i lokalet (soignering)</td>
            <td>Det andet ciffer angiver det antal gange per uge, der udføres grundig rengøring af gulv i lokalet.</td>
            <td>Det tredje ciffer angiver det antal gange per uge der udføres grundig rengøring af inventar i lokalet</td>
        </tr>
        </tbody>
    </table>
</section>

<!-- LOKALEFORTEGNELSE -->
<section class="section">
    <h2>Lokalefortegnelse og Programkoder</h2>

    <table>
        <thead>
        <tr>
            <th>Lokalebetegnelse</th>
            <th>Programkode</th>
            <th>Bemærkninger</th>
        </tr>
        </thead>
        <tbody>

        <% for (const roomName in grouped) { %>

            <%
                const room = grouped[roomName];
                const manualNotes = (roomNotes.find(r => r.roomName === roomName)?.notes) || [];
                const allNotes = [...manualNotes, ...(room.extraNotes || [])];
            %>

            <tr>
                <td><%= roomName %></td>
                <td><%= room.programCode %></td>
                <td class="notes">
                    <% allNotes.forEach(n => { %>
                        <div><%= n %></div>
                    <% }) %>
                </td>
            </tr>

        <% } %>

        </tbody>
    </table>
</section>

<!-- RENGØRINGSINSTRUKTION -->
<section class="section page-break">
    <h1>Rengøringsinstruktion</h1>

    <div class="instruction-box">
        <h3>Hver gang udføres (1. ciffer i programkoden)</h3>
        <% if (dailyDescriptions.length > 0) { %>
            <ul>
                <% dailyDescriptions.forEach(d => { %><li><%= d %></li><% }) %>
            </ul>
        <% } %>
    </div>

    <div class="instruction-box">
        <h3>Ved grundig gulvrengøring udføres følgende (2. ciffer i programkoden)</h3>
        <% if (floorDescriptions.length > 0) { %>
            <ul>
                <% floorDescriptions.forEach(d => { %><li><%= d %></li><% }) %>
            </ul>
        <% } %>
    </div>

    <div class="instruction-box">
        <h3>Ved grundig inventarrengøring udføres følgende (3. ciffer i programkoden)</h3>
        <% if (inventoryDescriptions.length > 0) { %>
            <ul>
                <% inventoryDescriptions.forEach(d => { %><li><%= d %></li><% }) %>
            </ul>
        <% } %>
    </div>
</section>

<!-- ØVRIGE OPGAVER -->
<% if (monthlyOtherTasks.length > 0 || perTimeTasks.length > 0 || consumables.length > 0) { %>
    <section class="section">
        <h2>Øvrige opgaver</h2>

        <% if (monthlyOtherTasks.length > 0) { %>
            <h3>Faste opgaver</h3>
            <ul>
                <% monthlyOtherTasks.forEach(t => { %>
                    <li>
                        <strong><%= t.name %></strong><% if (t.roomName) { %> (<%= t.roomName %>)<% } %>
                        – <%= frequencyLabels[t.frequency] %>
                        – <%= t.monthlyPrice.toLocaleString("da-DK", { minimumFractionDigits: 2 }) %> kr./måned
                        <% if (t.description) { %><div class="task-desc"><%= t.description %></div><% } %>
                    </li>
                <% }) %>
            </ul>
        <% } %>

        <% if (perTimeTasks.length > 0) { %>
            <h3>Ad hoc/Efter aftale</h3>
            <ul>
                <% perTimeTasks.forEach(t => { %>
                    <li>
                        <strong><%= t.name %></strong><% if (t.roomName) { %> (<%= t.roomName %>)<% } %>
                        – <%= Number(t.pricePerOccurrence || 0) > 0 ? Number(t.pricePerOccurrence).toLocaleString("da-DK", { minimumFractionDigits: 2 }) + " kr pr gang" : "pris efter aftale" %>
                        <% if (t.description) { %><div class="task-desc"><%= t.description %></div><% } %>
                    </li>
                <% }) %>
            </ul>
        <% } %>

        <% if (consumables.length > 0) { %>
            <h3>Tilkøb – Forbrugsvarer</h3>
            <ul>
                <% consumables.forEach(c => { %>
                    <li>
                        <strong><%= c.name %></strong>
                        – <%= (c.customPrice ?? 0).toLocaleString("da-DK", { minimumFractionDigits: 2 }) %> kr pr stk
<!--                        – <%= c.amount %> stk-->
                        <% if (c.description) { %><div class="task-desc"><%= c.description %></div><% } %>
                    </li>
                <% }) %>
            </ul>
            <p><em>Faktureres efter forbrug</em></p>
        <% } %>
    </section>
<% } %>

</body>
</html>
